{"type":"tool_use","timestamp":1778614420450,"sessionID":"ses_1e2573d8effehHK6MzSMzsUiGg","part":{"type":"tool","tool":"read","callID":"functions.read:46","state":{"status":"completed","input":{"filePath":"/home/runner/work/eval-ont-agent-mondo/eval-ont-agent-mondo/terms/MONDO_0012061.obo"},"output":"<path>/home/runner/work/eval-ont-agent-mondo/eval-ont-agent-mondo/terms/MONDO_0012061.obo</path>\n<type>file</type>\n<content>\n1: [Term]\n2: id: MONDO:0012061\n3: name: familial sick sinus syndrome\n4: def: \"Sick sinus syndrome is a rare cardiac rhythm disease, usually of the elderly, characterized by electrocardiographic findings of sinus bradycardia, atrial fibrillation, atrial tachycardia sinus arrest, or sino-atrial block, and that manifest with symptoms like syncope, dizziness, palpitations, fatigue, or even heart failure. It results from malfunction of the cardiac conduction system, probably secondary to degenerative fibrosis of nodal tissue in the elderly or secondary to cardiac disorders in younger patients.\" [Orphanet:166282]\n5: subset: gard_rare {source=\"GARD:13663\", source=\"MONDO:GARD\"}\n6: subset: nord_rare {source=\"MONDO:NORD\"}\n7: subset: ordo_disorder {source=\"Orphanet:166282\"}\n8: subset: orphanet_rare {source=\"Orphanet:166282\"}\n9: subset: otar {source=\"MONDO:OTAR\"}\n10: subset: rare\n11: synonym: \"familial sinus node dysfunction\" EXACT []\n12: synonym: \"hereditary sick sinus syndrome\" EXACT [MONDO:patterns/hereditary]\n13: synonym: \"sick sinus syndrome 1, autosomal recessive\" RELATED [MONDO:Lexical]\n14: synonym: \"SSS1\" RELATED ABBREVIATION [MONDO:Lexical]\n15: xref: GARD:13663 {source=\"MONDO:GARD\"}\n16: xref: ICD10CM:I49.5 {source=\"Orphanet:166282/attributed\", source=\"Orphanet:166282/ntbt\", source=\"Orphanet:166282\"}\n17: xref: icd11.foundation:1495462959 {source=\"MONDO:equivalentTo\"}\n18: xref: MedDRA:10040639 {source=\"Orphanet:166282/e\", source=\"Orphanet:166282\"}\n19: xref: MEDGEN:573766 {source=\"MONDO:equivalen