: \n981: common_map.tsv:\n982: \tblip-findall -debug index -goal ix -i imports/equivalencies.obo -i d2p.pro  -r mondoe -c ../utils/all_genetic.pro common_to_mondo/2 -label -no_pred -use_tabs | cut -f1,3,4 > $@\n983: \n984: # ----------------------------------------\n985: # Sparql constructs\n986: # ----------------------------------------\n987: \n988: # generate includes from sparql CONSTRUCT queries;\n989: # these can then be merged in to the main ontology\n990: #include-%.owl: ../sparql/construct/construct-%.sparql $(SRC)\n991: #\t$(ROBOT) merge -i $(SRC) query -c $< $@.tmp.ttl -f ttl && $(ROBOT) annotate -i $@.tmp.ttl -O $(OBO)/mondo/$@ -o $@\n992: \n993: imports/external_definitions.owl: ../sparql/construct/construct-embedded-definition.sparql $(SRC)\n994: \t$(ROBOT) merge -i $(SRC) query -c $< $@.tmp.ttl -f ttl && $(ROBOT) annotate -i $@.tmp.ttl -O $(OBO)/mondo/$@ -o $@\n995: \n996: FIX_URIS_IN_PLACE = perl -pi -ne $(FIX_URI_EXPR)\n997: \n998: all_equivalencies: imports/equivalencies.owl  imports/equivalencies.obo imports/equivalencies.json\n999: imports/equivalencies.owl: ../sparql/construct/construct-ecs-from-xrefs.sparql $(SRC)\n1000: \t$(ROBOT) merge -i $(SRC) query -c $< $@.tmp.ttl -f ttl && $(FIX_URIS_IN_PLACE)  $@.tmp.ttl && $(ROBOT) annotate -i $@.tmp.ttl -a $(PV_CC0) -O $(OBO)/mondo/$@ -o $@\n1001: imports/equivalencies.obo: imports/equivalencies.owl\n1002: \t$(ROBOT) convert -i $< -o $@\n1003: \n1004: clean_imports: $(patsubst %, clean-mirror-%, $(ONTOLOGY_IMPORTS))\n1005: clean-mirror-%:\n1006: \ttest -f mirror/$*.owl && rm mirror/$*.owl || echo 'no mirror file'\n1007: \n1008: #imports/equivalencies.owl: $(SRC)\n1009: #\t../utils/xrefs2axioms.pl $< > $@.tmp && owltools $@.tmp -o $@\n1010: \n1011: # ----------------------------------------\n1012: # Merge constructs\n1013: # ----------------------------------------\n1014: mondo-premerge-%.owl: mondo.owl mirror/%.owl\n1015: \towltools --use-catalog $^ --merge-support-ontologies -o $@.tmp && mv $@.tmp $@