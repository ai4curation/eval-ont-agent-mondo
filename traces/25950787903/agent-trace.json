d: | $(TMPDIR)\n743: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/mfomd.owl --create-dirs -o $(MIRRORDIR)/mfomd.owl --retry 4 --max-time 400 &&\\\n744: \t\t$(ROBOT) convert -i $(MIRRORDIR)/mfomd.owl -o $@.tmp.owl && \\\n745: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/MFOMD --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n746: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n747: \n748: ALL_MIRRORS = $(patsubst %, $(MIRRORDIR)/%.owl, $(IMPORTS))\n749: MERGE_MIRRORS = true\n750: \n751: $(MIRRORDIR)/merged.owl: $(ALL_MIRRORS)\n752: \tif [ $(IMP) = true ] && [ $(MERGE_MIRRORS) = true ]; then $(ROBOT) merge $(patsubst %, -i %, $^) remove --axioms equivalent --preserve-structure false -o $@; fi\n753: .PRECIOUS: $(MIRRORDIR)/merged.owl\n754: \n755: \n756: $(MIRRORDIR)/%.owl: mirror-% | $(MIRRORDIR)\n757: \tif [ $(IMP) = true ] && [ $(MIR) = true ] && [ -f $(TMPDIR)/mirror-$*.owl ]; then if cmp -s $(TMPDIR)/mirror-$*.owl $@ ; then echo \"Mirror identical, ignoring.\"; else echo \"Mirrors different, updating.\" &&\\\n758: \t\tcp $(TMPDIR)/mirror-$*.owl $@; fi; fi\n759: \n760: ###### END PARTIAL ODK MIGRATION ##############\n761: ###### BEGIN CUSTOM IMPORTS ###################\n762: mirror/hgnc_gene.nt: | $(MIRRORDIR)\n763: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L https://data.monarchinitiative.org/monarch-kg/latest/rdf/hgnc_gene.nt.gz | gzip -d > $@.tmp &&\\\n764: \t\tperl -npe 's@https://www.genenames.org/data/gene-symbol-report/#!/hgnc_id/HGNC:@http://identifiers.org/hgnc/@g' $@.tmp > $@; fi\n765: .PRECIOUS: mirror/hgnc_gene.nt\n766: \n767: mirror/ncbi_gene.nt: | $(MIRRORDIR)\n768: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L https://github.com/monarch-initiative/ncbi-gene/releases/latest/download/ncbi_gene.nt.gz | gzip -d > $@.tmp &&\\\n769: \t\tperl -npe 's@https://www.genenames.org/data/gene-symbol-report/#!/hgnc_id/HGNC:@http://identifiers.org/hgnc/@g' $@.tmp > $@; fi\n770: .PRECIOUS: mirror/ncbi_gene.nt\n771: \n772: mirror-hgnc: mirror/hgnc_gene.nt | $(TMPDIR)\n773: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then $(ROBOT) merge -i $< \\\n774: \t\tquery --format ttl --query ../sparql/construct/construct-hgnc.sparql $(TMPDIR)/$@.owl; fi\n775: \n776: ../sparql/construct/construct-ncbigene.sparql: ../sparql/construct/construct-ncbigene.sparql.template $(IMPORTDIR)/merged_terms_combined.txt\n777: \t@awk '{print \"    <\" $$0 \">\"}' $(IMPORTDIR)/merged_terms_combined.txt | grep ncbigene | paste -sd '\\n' > $(TMPDIR)/formatted_values.tmp\n778: \t@sed \"/{{VALUES}}/r $(TMPDIR)/formatted_values.tmp\" $< | sed '/{{VALUES}}/d' > $@\n779: \t@rm \"$(TMPDIR)/formatted_values.tmp\"\n780: \n781: mirror-ncbigene: mirror/ncbi_gene.nt ../sparql/construct/construct-ncbigene.sparql | $(TMPDIR)\n782: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then arq --data=mirror/ncbi_gene.nt --query=../sparql/construct/construct-ncbigene.sparql > $(TMPDIR)/$@.owl; fi\n783: \n784: \n785: $(TMPDIR)/hgnc_import.owl: $(IMPORTDIR)/merged_import.owl\n786: \t$(ROBOT) filter -i $< --term SO:0000704 --select \"annotations self descendants\" --signature true \\\n787: \t\tquery --update ../sparql/inject-subset-declaration.ru --update ../sparql/inject-synonymtype-declaration.ru --update ../sparql/postprocess-module.ru \\\n788: \t\tannotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) convert -f owl --output $@.tmp.owl && mv $@.tmp.owl $@\n789: \n790: IMPORTSEED=$(IMPORTDIR)/seed.txt # SHOULD BE TMP\n791: ###### END CUSTOM IMPORTS ###################\n792: \n793: edit-merged.owl: $(SRC)\n794: \t$(ROBOT) merge -c true -i $< -o $@\n795: imports/seed.txt: edit-merged.owl imports/manual_seed.txt\n796: \t$(ROBOT) query -f tsv -i $< -s ../sparql/signature/classes.sparql $@.tmp\n797: \tcat $@.tmp imports/manual_seed.txt | perl -npe 's@^\\<@@;s@>$$@@' - | sort -u > $@\n798: \n799: imports/%_terms.txt: imports/seed.txt\n800: \ttouch $@ && grep -hi $* $< $@ | sort -u  > $@.tmp && mv $@.tmp $@\n801: \n802: # ----------------------------------------\n803: # Release\n804: # ----------------------------------------\n805: # copy from staging area (this directory) to top-level\n806: #release: $(ONT).owl $(ONT).obo\n807: #\tcp $^ $(RELEASEDIR) && cp imports/* $(RELEASEDIR)/imports && cp subsets/* $(RELEASEDIR)/subsets\n808: \n809: mondo-lastbuild.owl:\n810: \tcurl -L -s $(OBO)/mondo.owl > $@.tmp && mv $@.tmp $@\n811: mondo-lastbuild.obo:\n812: \tcurl -L -s $(OBO)/mondo.obo > $@.tmp && mv $@.tmp $@\n813: #mondo-diff.md: mondo-lastbuild.owl\n814: #\towljs-diff -o $@ $< mondo.owl\n815: mondo-diff.txt: mondo-lastbuild.obo\n816: \tobo-simple-diff.pl $< mondo.obo >  $@.tmp && mv $@.tmp $@\n817: \n818: # ----------------------------------------\n819: # Editing\n820: # ----------------------------------------\n821: \n822: td:\n823: \techo $(ISODATE)\n824: # NOTE: no longer removes redundant\n825: INF: mondo-edit.obo\n826: \towltools --use-catalog  mondo-edit.obo --assert-inferred-subclass-axioms --always-assert-super-classes --keepRedundant --markIsInferred --merge-axiom-annotations -o -f obo $@.tmp && grep -v ^owl-axioms $@.tmp | perl -npe 's@is_inferred=\"true\"@source=\"OWLReasoner:Elk-$(ISODATE)\"@' | egrep -v '^relationship:.*is_inferred' | obo-grep.pl --neg -r 'id: (UBERON|CL|ENVO|NCBITaxon|HP|PATO|CHEBI):' -  > $@\n827: \n828: # normalize obo file\n829: # note we use owltools-compat to ensure standard ordering\n830: NORM: mondo-edit.obo\n831: \towltools --use-catalog  mondo-edit.obo --merge-axiom-annotations -o -f obo $@.norm && $(ROBOT) convert -i $@.norm -o $@.tmp.obo && mv $@.tmp.obo $@\n832: \n833: # tests roundtripping\n834: roundtrip.obo: mondo-edit.obo\n835: \towltools --use-catalog  mondo-edit.obo -o -f obo $@.tmp && mv $@.tmp $@\n836: \n837: test: test_obsolete\n838: \n839: test_obsolete: mondo-edit.obo\n840: \tgrep -v excluded_subClassOf $< > tmp/mondo-wo-obsoleted.obo \n841: \t! grep \"! obsolete\" tmp/mondo-wo-obsoleted.obo\n842: \n843: NEWAXTEST: mondo-edit.owl new.owl\n844: #\towltools --use-catalog  $^ --merge-support-ontologies --run-reasoner -r elk -u -m z.owl -o $@\n845: \towltools --use-catalog  $^ --merge-support-ontologies --assert-inferred-subclass-axioms --always-assert-super-classes --markIsInferred --removeRedundant  --merge-axiom-annotations -o -f obo $@.tmp && grep -v ^owl-axioms $@.tmp | egrep -v '^relationship:.*is_inferred' | obo-grep.pl --neg -r 'id: (UBERON|CL|ENVO|NCBITaxon|HP|PATO|CHEBI):' -  > $@\n846: \n847: # ----------------------------------------\n848: # Sparql queries: Q/C\n849: # ----------------------------------------\n850: \n851: SPARQL_MONDO_QC=$(patsubst %.sparql, %, $(notdir $(wildcard $(SPARQLDIR)/qc/mondo/qc-*.sparql)))\n852: SPARQL_GENERAL_QC=$(patsubst %.sparql, %, $(notdir $(wildcard $(SPARQLDIR)/qc/general/qc-*.sparql)))\n853: SPARQL_EDIT_EXCLUDE=\n854: # qc-duplicate-exact-synonym-no-abbrev is excluded from the OBO check because we are running the OBO check on the base file\n855: # There is something super weird about the way the OBO file is generated that causes this to fail\n856: # Because the id of ontology is `ontology: mondo/mondo-base`, all the IRIs to properties related to \n857: # the ontology begin looking like this: http://purl.obolibrary.org/obo/mondo/mondo-base#... This\n858: # will cause the query to fail because it expects the IRI  http://purl.obolibrary.org/obo/mondo#ABREVIATION\n859: # for the duplicate-exact-synonym-no-abbrev check.\n860: SPARQL_OBO_EXCLUDE=qc-single-child qc-omimps-should-be-inherited qc-omim-subsumption qc-permitted-properties qc-duplicate-exact-synonym-no-abbrev qc-multiple-gene-associations qc-subclass-relation-no-source qc-definition-containing-underscore\n861: SPARQL_OWL_EXCLUDE=qc-permitted-properties\n862: SPARQL_GENERAL_QC_EDIT=$(filter-out $(SPARQL_EDIT_EXCLUDE),$(SPARQL_GENERAL_QC))\n863: SPARQL_GENERAL_QC_OWL=$(filter-out $(SPARQL_OWL_EXCLUDE),$(SPARQL_GENERAL_QC))\n864: SPARQL_GENERAL_QC_OBO=$(filter-out $(SPARQL_OBO_EXCLUDE),$(SPARQL_GENERAL_QC))\n865: SPARQL_MONDO_QC_EDIT=$(filter-out $(SPARQL_EDIT_EXCLUDE),$(SPARQL_MONDO_QC))\n866: SPARQL_MONDO_QC_OWL=$(filter-out $(SPARQL_OWL_EXCLUDE),$(SPARQL_MONDO_QC))\n867: SPARQL_MONDO_QC_OBO=$(filter-out $(SPARQL_OBO_EXCLUDE),$(SPARQL_MONDO_QC))\n868: \n869: SPARQL_MONDO_QC_FILES=$(foreach V,$(SPARQL_MONDO_QC),$(SPARQLDIR)/qc/mondo/$V.sparql)\n870: SPARQL_GENERAL_QC_FILES_EDIT=$(foreach V,$(SPARQL_GENERAL_QC_EDIT),$(SPARQLDIR)/qc/general/$V.sparql)\n871: SPARQL_GENERAL_QC_FILES_OBO=$(foreach V,$(SPARQL_GENERAL_QC_OBO),$(SPARQLDIR)/qc/general/$V.sparql)\n872: SPARQL_GENERAL_QC_FILES_OWL=$(foreach V,$(SPARQL_GENERAL_QC_OWL),$(SPARQLDIR)/qc/general/$V.sparql)\n873: SPARQL_MONDO_QC_FILES_EDIT=$(foreach V,$(SPARQL_MONDO_QC_EDIT),$(SPARQLDIR)/qc/mondo/$V.sparql)\n874: SPARQL_MONDO_QC_FILES_OBO=$(foreach V,$(SPARQL_MONDO_QC_OBO),$(SPARQLDIR)/qc/mondo/$V.sparql)\n875: SPARQL_MONDO_QC_FILES_OWL=$(foreach V,$(SPARQL_MONDO_QC_OWL),$(SPARQLDIR)/qc/mondo/$V.sparql)\n876: \n877: \n878: QSRC = $(SRC)-noimports.owl\n879: \n880: $(QSRC): $(SRC)\n881: \towltools --use-catalog $< --remove-imports-declarations -o $@\n882: \n883: SRC_TAGS_REASONED=mondo-tags-reasoned.owl\n884: \n885: tmp/cross-species-mappings.owl: $(SRC)\n886: \tmkdir -p tmp\n887: \t$(ROBOT) query -i $< --use-graphs false --query ../sparql/construct/construct-cross-species-analog.sparql $@\n888: \n889: $(SRC_TAGS_REASONED): $(SRC) tmp/cross-species-mappings.owl\n890: \t$(ROBOT) merge -i $< -i components/mondo-tags.owl -i tmp/cross-species-mappings.owl --collapse-import-closure false reason -o $@\n891: \n892: # run all violation checks on edit file\n893: sparql_test_edit: $(SRC_TAGS_REASONED)\n894: \tmkdir -p reports/edit/ &&\\\n895: \t$(ROBOT) verify -i $< --queries $(SPARQL_MONDO_QC_FILES_EDIT) $(SPARQL_GENERAL_QC_FILES_EDIT) -O reports/edit/ && touch $@\n896: \n897: sparql_test_main_owl: $(ONT).owl\n898: \tmkdir -p reports/main_owl/ &&\\\n899: \t$(ROBOT) verify -i $< --queries $(SPARQL_MONDO_QC_FILES_OWL) $(SPARQL_GENERAL_QC_FILES_OWL) -O reports/main_owl/ && touch $@\n900: \n901: # See comment about http://purl.obolibrary.org/obo/mondo/mondo-base# above\n902: # if you ever encounter \"strange\" errors related to Mondo internal property ids.\n903: sparql_test_main_obo: $(ONT)-base.obo\n904: \tmkdir -p reports/main_obo/ &&\\\n905: \t$(ROBOT) verify -i $< --queries $(SPARQL_MONDO_QC_FILES_OBO) $(SPARQL_GENERAL_QC_FILES_OBO) -O reports/main_obo/ && touch $@\n906: \n907: PL2SPARQL = ../plq/pq-mondo\n908: #../sparql/%.sparql:\n909: #\t $(PL2SPARQL) -v  \"$*\" > $@.tmp && mv $@.tmp $@\n910: \n911: reports/pql-%.tsv: mondo-edit.owl\n912: \t $(PL2SPARQL) -f tsv -v -i $< -e -l \"$*\" > $@.tmp && mv $@.tmp $@\n913: \n914: reports/bg-%.tsv:\n915: \t $(PL2SPARQL) -f tsv -l \"$*\" > $@.tmp && mv $@.tmp $@\n916: \n917: reports/$(Q)-pqlx-$(Ont).tsv: mondo-edit.owl\n918: \t $(PL2SPARQL) -f tsv -v -i $< -i mirror/$(Ont).owl -e -l \"$(Q)\" > $@.tmp && mv $@.tmp $@\n919: \n920: reports/pq-%.tsv: mondo-edit.owl\n921: \t $(PL2SPARQL) -f tsv -v -i $< -e  \"$*\" > $@.tmp && mv $@.tmp $@\n922: \n923: reports/equiv-obs-%.tsv:\n924: \tpl2sparql -e -A void.ttl -i mondo_edit -i equivs -i mirror/$*.owl -c ../plq/mondo_queries.pro -l equivalent_to_deprecated > $@\n925: reports/equiv-replaced-by-%.tsv:\n926: \tpl2sparql -e -A void.ttl -i mondo_edit -i equivs -i mirror/$*.owl -c ../plq/mondo_queries.pro -l equivalent_to_replaced_by > $@\n927: \n928: reports/proxy-merge.tsv: mondo.owl\n929: \t./mq -i all proxy_merge -f tsv -l > $@.tmp && sort -u $@.tmp > $@\n930: #\tpl2sparql -f tsv -A void.ttl -e -i all -c ../plq/proxy_merge.pro proxy_merge > $@.tmp && mv $@.tmp $@\n931: \n932: # the main OWL file will have 'pseudo-roots' caused by the fact that external classes\n933: # are referenced; restrict the report to those with labels\n934: %.owl-roots.tsv: %.owl\n935: \t$(ROBOT) query -f tsv -i $< -s $(SPARQLDIR)/reports/root-labeled-classes.sparql $@\n936: %.obo-roots.tsv: %.obo\n9