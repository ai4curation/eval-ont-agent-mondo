atus\": \"pending\",\n    \"priority\": \"high\"\n  }\n]","metadata":{"todos":[{"content":"Merge MONDO:0009027 into MONDO:0007402","status":"pending","priority":"high"},{"content":"Merge MONDO:0011961 into MONDO:0044720","status":"pending","priority":"high"},{"content":"Merge MONDO:0010553 into MONDO:0010549","status":"pending","priority":"high"},{"content":"Merge MONDO:0013935 into MONDO:0012273","status":"pending","priority":"high"},{"content":"Normalize the ontology using `sh run.sh make NORM && mv NORM mondo-edit.obo`","status":"pending","priority":"high"},{"content":"Validate syntax using `robot convert`","status":"pending","priority":"high"},{"content":"Commit changes locally","status":"pending","priority":"high"},{"content":"Create ISSUE_COMMENTS.md and PR_COMMENTS.md","status":"pending","priority":"high"}],"truncated":false},"title":"8 todos","time":{"start":1778612075500,"end":1778612075503}},"id":"prt_e1d89784b0010aNq8zSU61X3Zj","sessionID":"ses_1e278a622ffeVn1jAcjHvcMwAj","messageID":"msg_e1d882bb60012JtuKOajcK4Po2"}}
