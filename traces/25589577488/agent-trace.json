{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"obo-grep.pl --noheader -r 'MONDO:0100500' src/ontology/mondo-edit.obo\"","aggregated_output":"[Term]\nid: MONDO:0033667\nname: Delpire-McNeill syndrome\ndef: \"Any neurodevelopmental disorder in which the cause of the disease is a mutation in the SLC12A2 gene. It is characterized by global developmental delay, mild to moderate intellectual disability, delayed, poor or absent speech, hypotonia with delayed or absent walking, bilateral sensorineural deafness, and autistic features. Variable features may include ventricular septal defect, tracheoesophageal fistula, hip dislocation, swallowing difficulties (that may require tube feeding), brain anomalies (including cortical dysplasia and agenesis of the corpus callosum) and spasticity.\" [OMIM:619083, Orphanet:633024]\nsubset: gard_rare {source=\"GARD:0018533\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:619083\"}\nsubset: ordo_subtype_of_a_disorder {source=\"Orphanet:633024\"}\nsubset: orphanet {source=\"Orphanet:633024\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"DELMNES\" EXACT ABBREVIATION [OMIM:619083]\nsynonym: \"SLC12A2-related autosomal dominant infantile-developmental delay-intellectual disability-sensorineural deafness syndrome\" EXACT [https://orcid.org/0000-0001-5493-2602, Orphanet:633024]\nxref: GARD:0018533 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1725056 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:619083 {source=\"MONDO:equivalentTo\"}\nxref: Orphanet:633024 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5436771 {source=\"MEDGEN:1725056\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! hereditary disease\nis_a: MONDO:0100500 {source=\"OMIM:619083\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_characteristic HP:0000006 {source=\"OMIM:619083\"} ! Autosomal dominant inheritance\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10911 {source=\"OMIM:619083\"} ! SLC12A2\nproperty_value: curated_content_resource \"https://www.malacards.org/card/delpire_mcneill_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8461\" xsd:anyURI\n\n[Term]\nid: MONDO:0054591\nname: Stankiewicz-Isidor syndrome\ndef: \"A neurodevelopmental disorder characterized by delayed psychomotor development, intellectual disability, behavioral disorders, mild craniofacial anomalies, and variable congenital defects of the cardiac and/or urogenital systems.\" [OMIM:617516]\nsubset: gard_rare {source=\"GARD:0027062\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:617516\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"Stankiewicz-Isidor syndrome\" EXACT [OMIM:617516]\nsynonym: \"STISS\" RELATED ABBREVIATION []\nxref: GARD:0027062 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1375936 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:617516 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4479599 {source=\"MEDGEN:1375936\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0002254 {source=\"OMIM:617516\"} ! syndromic disease\nis_a: MONDO:0005071 {source=\"OMIM:617516\", source=\"UMLS:C4479599\"} ! nervous system disorder\nis_a: MONDO:0100500 {source=\"OMIM:617516\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"OMIM:617516\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9557 {source=\"OMIM:617516\"} ! PSMD12\nproperty_value: curated_content_resource \"https://www.malacards.org/card/stankiewicz_isidor_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/3680\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/5669\" xsd:anyURI\n\n[Term]\nid: MONDO:0060562\nname: encephalopathy, neonatal severe, with lactic acidosis and brain abnormalities\nsubset: gard_rare {source=\"GARD:0027988\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:617668\"}\nsubset: ordo_disorder {source=\"Orphanet:447795\"}\nsubset: orphanet {source=\"Orphanet:447795\"}\nsubset: orphanet_rare {source=\"Orphanet:447795\"}\nsubset: rare\nsynonym: \"encephalopathy, neonatal severe, with lactic acidosis and brain abnormalities\" EXACT [OMIM:617668]\nsynonym: \"NELABA\" RELATED ABBREVIATION []\nxref: GARD:0027988 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1624694 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:617668 {source=\"MONDO:equivalentTo\"}\nxref: Orphanet:447795 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4540052 {source=\"MEDGEN:1624694\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0100198 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! Mendelian encephalopathy\nis_a: MONDO:0100500 {source=\"https://orcid.org/0000-0002-0736-9199\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/37216 {source=\"OMIM:617668\"} ! LIPT2\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/5671\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7693\" xsd:anyURI\n\n[Term]\nid: MONDO:0100500\nname: Mendelian neurodevelopmental disorder\ndef: \"A neurodevelopmental disorder that is caused by genetic modifications where those modifications are inherited from a parent's genome.\" [MONDO:patterns/hereditary]\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0002-0736-9199\", source=\"https://orcid.org/0000-0002-1780-5230\"} ! hereditary disease\nintersection_of: MONDO:0700092 ! neurodevelopmental disorder\nintersection_of: has_characteristic MONDO:0021152 ! inherited\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0001-5208-3432\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/4789\" xsd:anyURI\n\n[Term]\nid: MONDO:0800456\nname: SYNCRIP-related neurodevelopmental disorder\ndef: \"Any neurodevelopmental disorder in which the cause of the disease is a variation in the SYNCRIP gene. It is characterized by a neurologic and developmental disorder with autism spectrum disorder (ASD), intellectual disability (ID), and epilepsy. Other signs and symptoms may include cerebral structural anomalies such as periventricular nodular heterotopia and widening of subarachnoid spaces.\" [https://orcid.org/0000-0001-9310-0163, MONDO:patterns/disease_series_by_gene, PMID:34157790]\nis_a: MONDO:0100500 {source=\"PMID:34157790\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! Mendelian neurodevelopmental disorder\nintersection_of: MONDO:0700092 ! neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/16918 ! SYNCRIP\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6965\" xsd:anyURI\n\n[Term]\nid: MONDO:0800457\nname: HNRNPC-related neurodevelopmental disorder\ndef: \"Any neurodevelopmental disorder in which the cause of the disease is a variation in the HNRNPC gene. It is characterized by global developmental delay, intellectual disability, behavioral abnormalities, and subtle facial dysmorphism. It is caused by heterozygous HNRNPC germline variants.\" [https://orcid.org/0000-0001-9310-0163, MONDO:patterns/disease_series_by_gene, PMID:37541189]\nis_a: MONDO:0100500 {source=\"PMID:37541189\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! Mendelian neurodevelopmental disorder\nintersection_of: MONDO:0700092 ! neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/5035 ! HNRNPC\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6964\" xsd:anyURI\n\n[Term]\nid: MONDO:0958323\nname: neurodevelopmental disorder with early-onset parkinsonism and behavioral abnormalities\nsubset: omim {source=\"OMIM:620747\"}\nxref: MEDGEN:1857802 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620747 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935590 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1857802\"}\nis_a: MONDO:0100500 {source=\"OMIM:620747\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/33782 {source=\"OMIM:620747\"} ! PTRHD1\nproperty_value: curated_content_resource \"https://www.malacards.org/card/neurodevelopmental_disorder_with_early_onset_parkinsonism_and_behavioral_abnormalities\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0958329\nname: Jeffries-Lakhani neurodevelopmental syndrome\nsubset: omim {source=\"OMIM:620771\"}\nxref: MEDGEN:1854360 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620771 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935596 {source=\"MEDGEN:1854360\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0100500 {source=\"OMIM:620771\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/14630 {source=\"OMIM:620771\"} ! CRELD1\nproperty_value: curated_content_resource \"https://www.malacards.org/card/jeffries_lakhani_neurodevelopmental_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0968945\nname: neurodevelopmental disorder with language impairment, autism, and attention deficit-hyperactivity disorder\nsubset: gard_rare {source=\"GARD:0028082\", source=\"MONDO:GARD\"}\nsubset: nord_rare {source=\"MONDO:NORD\"}\nsubset: omim {source=\"OMIM:620782\"}\nsubset: rare\nxref: GARD:0028082 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1854977 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620782 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935603 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1854977\"}\nis_a: MONDO:0100500 {source=\"OMIM:620782\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/6743 {source=\"OMIM:620782\"} ! CAPRIN1\nproperty_value: curated_content_resource \"https://www.malacards.org/card/neurodevelopmental_disorder_with_language_impairment_autism_and_attention_deficit_hyperactivity_disorder\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0968947\nname: neurodevelopmental disorder plus optic atrophy\nsubset: omim {source=\"OMIM:620784\"}\nxref: MEDGEN:1859522 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620784 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935605 {source=\"MEDGEN:1859522\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0100500 {source=\"OMIM:620784\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/17028 {source=\"OMIM:620784\"} ! SNF8\nproperty_value: curated_content_resource \"https://www.malacards.org/card/neurodevelopmental_disorder_plus_optic_atrophy\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0971043\nname: neurodevelopmental disorder with hypotonia, feeding difficulties, facial dysmorphism, and brain abnormalities\nsubset: omim {source=\"OMIM:620852\"}\nxref: MEDGEN:1857550 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620852 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935629 {source=\"MEDGEN:1857550\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0100500 {source=\"https://orcid.org/0000-0002-4142-7153\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/12739 {source=\"OMIM:620852\"} ! WBP4\nproperty_value: curated_content_resource \"https://www.malacards.org/card/neurodevelopmental_disorder_with_hypotonia_feeding_difficulties_facial_dysmorphism_and_brain_abnormalities\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0971172\nname: neurodevelopmental disorder with hypotonia, brain anomalies, distinctive facies, and absent language\ndef: \"A syndromic neurodevelopmental disorder in which the cause of the disease is a variation in RNU4-2 gene and is inherited in an autosomal dominant pattern. It is characterized by moderate to severe global developmental delay/intellectual disability, speech anomalies (mostly non-verbal), hypotonia, abnormal brain MRI (reduced white matter volume, hypoplasia of the corpus callosum, ventriculomegaly, and delayed myelination), dysmorphic facial features, short stature, microcephaly, behavioral issues, seizures and feeding difficulties, as well as variable vision, gastrointestinal, endocrine, skeletal, genitourinary, cardiac, and cutaneous anomalies. It has autosomal dominant inheritance.\" [https://clinicalgenome.org/affiliation/40060/, PMID:38821540, PMID:38991538, PMID:40379786]\nsubset: doid {source=\"DOID:0061190\"}\nsubset: gard_rare {source=\"GARD:0027315\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:620851\"}\nsubset: ordo_disorder {source=\"Orphanet:686488\"}\nsubset: orphanet {source=\"Orphanet:686488\"}\nsubset: orphanet_rare {source=\"Orphanet:686488\"}\nsubset: rare\nsynonym: \"NEDHAFA\" EXACT ABBREVIATION [OMIM:620851]\nsynonym: \"RENU\" EXACT ABBREVIATION [OMIM:620851]\nsynonym: \"ReNU syndrome\" EXACT [DOID:0061190, OMIM:620851, Orphanet:686488]\nsynonym: \"RNU4-2-related neurodevelopmental disorder-facial dysmorphism-white matter abnormalities-short stature syndrome\" EXACT [Orphanet:686488, PMID:38645094, PMID:38821540]\nsynonym: \"RNU4-2-related neurodevelopmental syndrome\" EXACT [Orphanet:686488, PMID:38645094, PMID:38821540]\nsynonym: \"RNU4-2-related ReNU syndrome\" EXACT [https://clinicalgenome.org/affiliation/40060/] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nxref: DOID:0061190 {source=\"MONDO:equivalentTo\"}\nxref: GARD:0027315 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1854654 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620851 {source=\"MONDO:equivalentTo\"}\nxref: Orphanet:686488 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935628 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1854654\"}\nis_a: MONDO:0003847 {source=\"OMIM:620851\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! hereditary disease\nis_a: MONDO:0100500 {source=\"https://clinicalgenome.org/affiliation/40060/\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"OMIM:620851\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10193 {source=\"OMIM:620851\"} ! RNU4-2\nproperty_value: curated_content_resource \"https://www.malacards.org/card/renu_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8496\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9547\" xsd:anyURI\n\n[Term]\nid: MONDO:1040003\nname: KCND2-related neurodevelopmental disorder with or without seizures\ndef: \"A neurodevelopmental disorder caused by variation in the KCND2 gene. This disorder is characterized by early-onset global developmental delay with impaired motor, speech and cognitive development. Patients often present muscle hypotonia, and less frequently, developmental epileptic encephalopathy, visual impairment and physical dysmorphisms.\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-0987-9862, PMID:34245260]\nis_a: MONDO:0100500 {source=\"PMID:34245260\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"https://orcid.org/0000-0002-0987-9862\"} ! neurodevelopmental disorder\nintersection_of: MONDO:0700092 ! neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/6238 ! KCND2\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8155\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8489\" xsd:anyURI\n\n[Term]\nid: MONDO:1040005\nname: PRPF19-related neurodevelopmental disorder\ndef: \"Any neurodevelopmental disorder in which the cause of the disease is a mutation in the PRPF19 gene. This disorder is characterised by developmental, motor and speech delay, and facial dysmorphisms. Most patients present mild to moderate intellectual disability, autism spectrum disorder or autistic features, and hypotonia. Other phenotypes observed less frequently include seizures, and visual and cardiac abnormalities.\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-0987-9862, PMID:37962958]\nis_a: MONDO:0100500 {source=\"PMID:37962958\", source=\"https://orcid.org/0000-0002-0587-4693\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"https://orcid.org/0000-0002-0987-9862\"} ! neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/17896 ! PRPF19\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8156\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8489\" xsd:anyURI\n\n[Term]\nid: MONDO:1040006\nname: CTR9-related neurodevelopmental disorder\ndef: \"Any neurodevelopmental disorder in which the cause of the disease is a variation in the CTR9 gene. This disorder is characterised by varying degrees of intellectual disability, neurodevelopmental delay, hypotonia, fatigability, behavioral abnormalities including autism spectrum disorder, anxiety and aggressive behavior, cardiac anomalies, and mild facial dysmorphism.\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-0987-9862, PMID:35468861, PMID:35499524, PMID:35717577]\nis_a: MONDO:0100500 {source=\"PMID:35468861\", source=\"PMID:35499524\", source=\"PMID:35717577\", source=\"https://orcid.org/0000-0002-0587-4693\", source=\"https://orcid.org/0000-0002-0987-9862\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"https://orcid.org/0000-0002-0987-9862\"} ! neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/16850 ! CTR9\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8157\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8489\" xsd:anyURI\n\n[Term]\nid: MONDO:1040008\nname: CAMK2D-related neurodevelopmental disorder and dilated cardiomyopathy\ndef: \"A neurodevelopmental disorder caused by variation in the CAMK2D gene. This disorder is characterised by intellectual disability, speech and motor delay, behavioural problems and dilated cardiomyopathy. Patients often present brain structural anomalies and hypotonia, and less frequently, seizures.\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-0987-9862, PMID:37372357, PMID:38272033]\nis_a: MONDO:0100500 {source=\"PMID:37372357\", source=\"PMID:38272033\", source=\"https://orcid.org/0000-0002-0587-4693\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"https://orcid.org/0000-0002-0987-9862\"} ! neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/1462 ! CAMK2D\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8158\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8489\" xsd:anyURI\n\n[Term]\nid: MONDO:1040014\nname: PPFIA3-related neurodevelopmental disorder\ndef: \"A neurodevelopmental disorder caused by variation in the PPFIA3 gene. This disorder is characterised by developmental delay and intellectual disability. Most patients present variable additional features, including dysmorphisms, microcephaly or macrocephaly, hypotonia, autism spectrum disorder or autistic features, abnormal electroencephalogram, and epilepsy.\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-0987-9862, PMID:38181735]\nsubset: omim {source=\"OMIM:621122\"}\nxref: OMIM:621122 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0100500 {source=\"PMID:38181735\", source=\"https://orcid.org/0000-0002-0587-4693\", source=\"https://orcid.org/0000-0002-0987-9862\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"https://orcid.org/0000-0002-0987-9862\"} ! neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9247 ! PPFIA3\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9247 {source=\"OMIM:621122\"} ! PPFIA3\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8160\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8489\" xsd:anyURI\n\n[Term]\nid: MONDO:1060179\nname: RNU5B-1 related neurodevelopmental disorder with seizures and joint laxity\ndef: \"A neurodevelopmental disorder in which the cause of the disease is a variation in RNU5B-1 gene and is characterized by global developmental delay, hypotonia, macrocephaly, failure to thrive, abnormality of the eye, seizures, and joint laxity\" [https://clinicalgenome.org/affiliation/40060/, MONDO:patterns/disease_series_by_gene, PMID:40379786, PMID:40442284]\nsubset: omim {source=\"OMIM:621302\"}\nsynonym: \"NEDSJL\" EXACT ABBREVIATION [OMIM:621302]\nsynonym: \"neurodevelopmental disorder with seizures and joint laxity\" EXACT [OMIM:621302]\nsynonym: \"RNU5B-1 related neurodevelopmental disorder with seizures and joint laxity\" EXACT [https://clinicalgenome.org/affiliation/40060/] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"RNU5B-1-related disorder\" BROAD [https://clinicalgenome.org/affiliation/40060/]\nxref: OMIM:621302 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0100500 {source=\"PMID:40379786\", source=\"PMID:40442284\", source=\"https://clinicalgenome.org/affiliation/40060/\"} ! Mendelian neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10212 ! RNU5B-1\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10212 {source=\"OMIM:621302\", source=\"PMID:40379786\", source=\"PMID:40442284\", source=\"https://clinicalgenome.org/affiliation/40060/\"} ! RNU5B-1\nproperty_value: http://purl.org/dc/terms/creator \"https://orcid.org/0000-0002-7638-4659\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9596\" xsd:any