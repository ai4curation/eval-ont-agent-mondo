{"type":"tool_use","timestamp":1778378487545,"sessionID":"ses_1f063bfd2ffeoYwNFcmjiqufh3","part":{"type":"tool","tool":"read","callID":"call_LKAstj4d6nqzZnkLecR48MhF","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-mondo/eval-ont-agent-mondo/terms/MONDO_0000453.obo","offset":1,"limit":120},"output":"<path>/__w/eval-ont-agent-mondo/eval-ont-agent-mondo/terms/MONDO_0000453.obo</path>\n<type>file</type>\n<content>\n1: [Term]\n2: id: MONDO:0000453\n3: name: short QT syndrome\n4: def: \"A genetic disease of the electrical system of the heart that consists of a constellation of signs and symptoms, consisting of a short QT interval on an EKG (< 300 ms) that does not significantly change with heart rate, tall and peaked T waves, and a structurally normal heart. Short QT syndrome appears to be inherited in an autosomal dominant pattern, and a few affected families have been identified\" [Wikipedia:Short_QT_syndrome]\n5: subset: clingen {source=\"MONDO:CLINGEN\"}\n6: subset: gard_rare {source=\"GARD:16650\", source=\"MONDO:GARD\"}\n7: subset: nord_rare {source=\"MONDO:NORD\", source=\"NORD:2019\"}\n8: subset: ordo_disorder {source=\"Orphanet:51083\"}\n9: subset: orphanet_rare {source=\"Orphanet:51083\"}\n10: subset: otar {source=\"MONDO:OTAR\"}\n11: subset: prototype_pattern\n12: subset: rare\n13: synonym: \"familial short QT syndrome\" RELATED []\n14: synonym: \"short QT syndrome\" EXACT [DOID:0050793, icd11.foundation:553392015, NCIT:C71060, OMIMPS:609620] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\n15: synonym: \"ventricular arrhythmia associated with short QT syndrome\" EXACT [NCIT:C71060]\n16: xref: DOID:0050793 {source=\"MONDO:equivalentTo\"}\n17: xref: GARD:16650 {source=\"MONDO:GARD\"}\n18: xref: ICD10CM:I49.8 {source=\"Orphanet:51083\", source=\"Orphanet:51083/attributed\", source=\"Orphanet:51083/ntbt\"}\n19: xref: icd11.foundation:553392015 {source=\"MONDO:equivalentTo\", source=\"Orphanet:51083\"}\n20: xref: ICD