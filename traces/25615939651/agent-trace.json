r container.\n#\n# The assumption is that you are working in the src/ontology folder;\n# we therefore map the whole repo (../..) to a docker volume.\n#\n# See README-editors.md for more details.\n\nMEMORY_GB=${MEMORY_GB:-8}\nIMAGE=${IMAGE:-odkfull:v1.6}\nMEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\nODK_DEBUG=${ODK_DEBUG:-no}\n\ndocker pull obolibrary/$IMAGE\n\necho \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"","truncated":false,"loaded":[]},"title":"src/ontology/run.sh","time":{"start":1778378554252,"end":1778378554258}},"metadata":{"openai":{"itemId":"fc_0d5f3b67676060be0169ffe739ed148195900e6352180ee9d6"}},"id":"prt_e0f9f3a65001JmVOv49lj8VwUf","sessionID":"ses_1f063bfd2ffeoYwNFcmjiqufh3","messageID":"msg_e0f9f2d4b0015u9wDEvIh4tXlB"}}
