{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"curl -fsSL 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=gene&id=80746&retmode=json'\"","aggregated_output":"{\"header\":{\"type\":\"esummary\",\"version\":\"0.3\"},\"result\":{\"uids\":[\"80746\"],\"80746\":{\"uid\":\"80746\",\"name\":\"TSEN2\",\"description\":\"tRNA splicing endonuclease subunit 2\",\"status\":\"\",\"currentid\":\"\",\"chromosome\":\"3\",\"geneticsource\":\"genomic\",\"maplocation\":\"3p25.2\",\"otheraliases\":\"PCH2B, SEN2, SEN2L\",\"otherdesignations\":\"tRNA-splicing endonuclease subunit Sen2|TSEN2 tRNA splicing endonuclease subunit|hsSen2|tRNA-intron endonuclease Sen2\",\"nomenclaturesymbol\":\"TSEN2\",\"nomenclaturename\":\"tRNA splicing endonuclease subunit 2\",\"nomenclaturestatus\":\"Official\",\"mim\":[\"608753\"],\"genomicinfo\":[{\"chrloc\":\"3\",\"chraccver\":\"NC_000003.12\",\"chrstart\":12480230,\"chrstop\":12539623,\"exoncount\":19}],\"geneweight\":727,\"summary\":\"This gene encodes one of the subunits of the tRNA splicing endonuclease. This endonuclease catalyzes the first step in RNA splicing which is the removal of introns. Mutations in this gene have been associated with pontocerebellar hypoplasia type 2. A pseudogene has been identified on chromosome 4. Multiple transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Feb 2009]\",\"chrsort\":\"03\",\"chrstart\":12480230,\"organism\":{\"scientificname\":\"Homo sapiens\",\"commonname\":\"human\",\"taxid\":9606},\"locationhist\":[{\"annotationrelease\":\"RS_2025_08\",\"assemblyaccver\":\"GCF_000001405.40\",\"chraccver\":\"NC_000003.12\",\"chrstart\":12480230,\"chrstop\":12539623},{\"annotationrelease\":\"RS_2025_08\",\"assemblyaccver\":\"GCF_009914755.1\",\"chraccver\":\"NC_060927.1\",\"chrstart\":12478036,\"chrstop\":12537425},{\"annotationrelease\":\"RS_2024_08\",\"assemblyaccver\":\"GCF_000001405.40\",\"chraccver\":\"