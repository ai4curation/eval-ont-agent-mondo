6687992]\nxref: icd11.foundation:956687992 {source=\"MONDO:equivalentTo\", source=\"https://orcid.org/0000-0002-7356-1779\"}\nxref: MEDGEN:677063 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:C197914 {source=\"MONDO:equivalentTo\"}\nxref: SCTID:443482000 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0745138 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:677063\"}\nis_a: MONDO:0005044 {source=\"https://orcid.org/0009-0009-6791-365X\", source=\"icd11.foundation:896211058\"} ! hypertensive disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8005\" xsd:anyURI\n\n[Term]\nid: MONDO:1030009\nname: persistent atrial fibrillation\ndef: \"An atrial fibrillation disorder characterized by continuous atrial fibrillation that lasts for more than seven days.\" [https://orcid.org/0009-0009-6791-365X, PMID:38033089]\nsynonym: \"persistent AF\" EXACT [PMID:29401239]\nxref: ICD10CM:I48.1 {source=\"MONDO:equivalentTo\"}\nxref: icd11.foundation:519924384 {source=\"https://orcid.org/0000-0002-7941-5545\", source=\"MONDO:equivalentTo\", source=\"https://orcid.org/0000-0001-9439-5346\"}\nxref: MEDGEN:749907 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: SCTID:440059007 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C2585653 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:749907\"}\nis_a: MONDO:0004981 {source=\"PMID:38033089\"} ! atrial fibrillation\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7887\" xsd:anyURI\n\n[Term]\nid: MONDO:1030010\nname: precerebral artery stenosis\ndef: \"A cerebrovascular disorder characterized by an abnormal narrowing of a precerebral artery.\" [https://orcid.org/0009-0009-6791-365X, SCTID:1055001]\nsynonym: \"narrowing of precerebral artery\" EXACT [SCTID:1055001]\nxref: ICD10CM:I65 {source=\"MONDO:relatedTo\"}\nxref: MEDGEN:539068 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: SCTID:1055001 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0265089 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:539068\"}\nis_a: MONDO:0011057 {source=\"SCTID:1055001\"} ! cerebrovascular disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7885\" xsd:anyURI\n\n[Term]\nid: MONDO:1030011\nname: paroxysmal atrial fibrillation\ndef: \"An atrial fibrillation disorder characterized by intermittent atrial fibrillation that lasts less than seven days from onset.\" [https://orcid.org/0009-0009-6791-365X, PMID:38033089]\nsubset: ncit {source=\"NCIT:C80391\"}\nsynonym: \"paroxymsal AFib\" EXACT [NCIT:C80391]\nsynonym: \"paroxysmal AF\" EXACT [NCIT:C80391]\nxref: ICD10CM:I48.0 {source=\"MONDO:equivalentTo\"}\nxref: icd11.foundation:542703670 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:115990 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:C80391 {source=\"MONDO:equivalentTo\"}\nxref: SCTID:282825002 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0235480 {source=\"MEDGEN:115990\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0004981 {source=\"PMID:38033089\", source=\"icd11.foundation:542703670\"} ! atrial fibrillation\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7886\" xsd:anyURI\n\n[Term]\nid: MONDO:1050000\nname: sycosis barbae\ndef: \"Folliculitis of the beard and/or mustache areas caused by a bacterial infection, usually caused by Staphylococcus aureus.\" [http://purl.obolibrary.org/obo/DERMO_0002078, https://orcid.org/0000-0002-0819-0473]\nsynonym: \"bacterial folliculitis\" RELATED [PMID:33085351]\nxref: icd11.foundation:1245506993 {source=\"https://orcid.org/0000-0002-7941-5545\", source=\"MONDO:equivalentTo\", source=\"https://orcid.org/0000-0001-9439-5346\"}\nxref: MedDRA:10042731 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:546837 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: SCTID:156410002 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0275798 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:546837\"}\nis_a: MONDO:0005113 {source=\"https://orcid.org/0000-0002-0819-0473\"} ! bacterial infectious disease\nis_a: MONDO:0006552 {source=\"https://orcid.org/0000-0002-0819-0473\"} ! folliculitis\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0819-0473\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/pull/8094\" xsd:anyURI\n\n[Term]\nid: MONDO:1060213\nname: reticular pseudodrusen\ndef: \"A retinal drusen characterized by subretinal deposits located internal to the retinal pigment epithelium, composed of material aggregations in the subretinal space between photoreceptors and the retinal pigment epithelium. These deposits have a bluish-white appearance by biomicroscopy and appear as hyperreflective lesions above the retinal pigment epithelium on optical coherence tomography.\" [https://orcid.org/0000-0001-6677-8489, PMID:29859199, PMID:38386332, PMID:41361163]\ncomment: Reticular pseudodrusen are a strong independent risk factor for late age-related macular degeneration and are particularly associated with geographic atrophy and type 3 neovascularization.\nsynonym: \"RPD\" EXACT ABBREVIATION [https://orcid.org/0000-0001-6677-8489, PMID:29859199]\nsynonym: \"SDD\" EXACT ABBREVIATION [https://orcid.org/0000-0001-6677-8489, PMID:29859199]\nsynonym: \"subretinal drusenoid deposit\" EXACT [https://orcid.org/0000-0001-6677-8489, PMID:29859199, PMID:38386332]\nxref: SCTID:762533006 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0006949 {source=\"PMID:29859199\", source=\"https://orcid.org/0000-0001-6677-8489\"} ! retinal drusen\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9849\" xsd:anyURI\n\n[Term]\nid: MONDO:8000006\nname: WHIM syndrome 1\ndef: \"A congenital autosomal dominant immune deficiency characterized by abnormal retention of mature neutrophils in the bone marrow (myelokathexis) and occasional hypogammaglobulinemia, associated with an increased risk for bacterial infections and a susceptibility to human papillomavirus (HPV) induced lesions (cutaneous warts, genital dysplasia and invasive mucosal carcinoma).\" [Orphanet:51636]\nsubset: doid {source=\"DOID:0060591\"}\nsubset: doid_rare {source=\"DOID:0060591\"}\nsubset: gard_rare {source=\"GARD:0009297\", source=\"MONDO:GARD\"}\nsubset: nord_rare {source=\"NORD:1849\", source=\"MONDO:NORD\"}\nsubset: omim {source=\"OMIM:193670\"}\nsubset: ordo_disorder {source=\"Orphanet:51636\"}\nsubset: orphanet {source=\"Orphanet:51636\"}\nsubset: orphanet_rare {source=\"Orphanet:51636\"}\nsubset: rare\nsynonym: \"myelokathexis, isolated\" EXACT []\nsynonym: \"Warts, hypogammaglobulinemia, infections, and myelokathexis syndrome\" EXACT []\nsynonym: \"Warts-hypogammaglobulinemia-infections-myelokathexis syndrome\" EXACT [DOID:0060591, Orphanet:51636]\nsynonym: \"Warts-infections-leukopenia-myelokatexis syndrome\" EXACT [Orphanet:51636]\nsynonym: \"WHIM Syndrome\" EXACT [NORD:1849, Orphanet:51636] {OMO:0002001=\"https://w3id.org/information-resource-registry/nord\"}\nsynonym: \"WHIM syndrome\" BROAD []\nsynonym: \"WHIMS\" EXACT ABBREVIATION [DOID:0060591, OMIM:193670]\nsynonym: \"WILM\" EXACT ABBREVIATION [Orphanet:51636]\nxref: DOID:0060591 {source=\"MONDO:equivalentTo\"}\nxref: GARD:0009297 {source=\"MONDO:GARD\"}\nxref: ICD10CM:D81.8 {source=\"Orphanet:51636\", source=\"DOID:0060591\"}\nxref: MEDGEN:1778124 {source=\"MONDO:equivalentTo\", source=\"MONDO:M