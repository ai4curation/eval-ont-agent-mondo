{"type":"tool_use","timestamp":1778527259318,"sessionID":"ses_1e791f05fffeicUw2HCROUWpxH","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-97035125e5c4f594","state":{"status":"completed","input":{"filePath":"src/ontology/Makefile"},"output":"<path>/home/runner/work/eval-ont-agent-mondo/eval-ont-agent-mondo/src/ontology/Makefile</path>\n<type>file</type>\n<content>\n1: OBOBASE=                    http://purl.obolibrary.org/obo\n2: URIBASE=                    http://purl.obolibrary.org/obo\n3: VERSION=                    $(TODAY)\n4: ANNOTATION_PROPERTIES=\t\trdfs:label IAO:0000115 IAO:0000116 IAO:0100001 owl:deprecated RO:0002175\n5: ANNOTATE_ONTOLOGY_VERSION = annotate -V $(ONTBASE)/releases/$(VERSION)/$@ --annotation owl:versionInfo $(VERSION)\n6: ANNOTATE_CONVERT_FILE =     annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) convert -f ofn --output $@.tmp.owl && mv $@.tmp.owl $@\n7: \n8: OBO=http://purl.obolibrary.org/obo\n9: OIO=http://www.geneontology.org/formats/oboInOwl\\#\n10: RDFS=http://www.w3.org/2000/01/rdf-schema#\n11: SKOS=http://www.w3.org/2004/02/skos/core\\#\n12: EFO=http://www.ebi.ac.uk/efo\n13: ONT=mondo\n14: ONTURI=$(OBO)/$(ONT)\n15: ONTBASE=$(OBO)/$(ONT)\n16: MIRRORDIR=mirror\n17: IMPORTDIR=imports\n18: SUBSETDIR=subsets\n19: \n20: \n21: SRC=$(ONT)-edit.obo\n22: #RELEASEDIR=../../target/\n23: CATALOG=catalog-v001.xml\n24: ROBOT= robot --catalog $(CATALOG)\n25: OWLTOOLS= owltools\n26: USECAT= --use-catalog\n27: SPARQLDIR = ../sparql\n28: PATTERNDIR = ../patterns\n29: TRANSLATIONSDIR=../translations\n30: TMPDIR = tmp\n31: \n32: CONSTRUCTS= embedded-definition\n33: INCLUDES_OWL = $(patsubst %,include-%.owl,$(CONSTRUCTS))\n34: ISODATE:=`date +%Y-%m-%d`\n35: TODAY ?= $(shell date +%Y-%m-%d)\n36: OBODATE ?= $(shell date +'%d:%m:%Y %H:%M')\n37: \n38: FMTS = obo owl json\n39: \n40: obo-filter-axiom-header = grep -v ^owl-axioms:\n41: \n42: OWL2OBO = $(ROBOT) convert -i $< -o $@.tmp.obo && grep -v ^owl-axioms: $@.tmp.obo > $@\n43: \n44: PV_CC0 = http://purl.org/dc/terms/license https://creativecommons.org/publicdomain/zero/1.0/\n45: \n46: # In converting to obo format, everything is assumed to have an OBO prefix.\n47: # This perl corrects this.\n48: # Longer term we need to eliminate passing through obo and/or fix the owlapi implementation to respect prefixes\n49: FIX_URI_EXPR = 's@$(OBO)/EFO_@http://www.ebi.ac.uk/efo/EFO_@g; s@$(OBO)/UMLS_@http://linkedlifedata.com/resource/umls/id/@g'\n50: \n51: # EFO uses different properties. The following command can be used on owltools\n52: EFO2OBO_OPTS = --rename-entity $(EFO)/definition $(OBO)/IAO_0000115 \\\n53:            --rename-entity $(EFO)/reason_for_obsolescence $(RDFS)comment \\\n54:            --rename-entity $(EFO)/alternative_term $(OIO)hasExactSynonym\\\n55:            --rename-entity $(OBO)/ECO_0000218 $(OIO)source\n56: \n57: # EFO uses different prefixes in xrefs. We replace these with the following perl\n58: # intended to be used within a perl -npe loop.\n59: # In future we should use a more robust translation\n60: EFO2OBO_PERL = 's@NCIt:@NCIT:@; s@MSH:@MESH:@; s@SNOMEDCT:@SCTID:@;'\n61: OBOGREPL=../scripts/obo-grepl.pl\n62: OBOGREP=../scripts/obo-grep.pl\n63: ADDTOTBD=../scripts/add-to-tbd.pl\n64: \n65: # ----------------------------------------\n66: # Top-level targets\n67: # ----------------------------------------\n68: .PHONY: .FORCE\n69: all: test all_artefacts mappings\n70: \techo \"release finished\"\n71: \n72: # ----------------------------------------\n73: # Artefacts\n74: # ----------------------------------------\n75: \n76: IMPORTS =  uberon cl go pato envo ro hp mf ncbitaxon chebi ncit hgnc foodon so ecto omo chr hsapdv nbo maxo mfomd ncbigene bfo\n77: \n78: IMPORT_ROOTS =  $(IMPORTDIR)/merged_import\n79: IMPORT_OWL_FILES = $(foreach n,$(IMPORT_ROOTS), $(n).owl)\n80: IMPORT_FILES = $(IMPORT_OWL_FILES)\n81: \n82: \n83: .PHONY: all_imports\n84: all_imports: $(IMPORT_FILES)\n85: \n86: \n87: COMPONENTS = mondo-tags\n88: COMPONENT_FILES = $(foreach n, $(COMPONENTS), components/$(n).owl)\n89: \n90: SUBSETS = mondo-rare mondo-clingen\n91: SUBSET_ROOTS = $(patsubst %, subsets/%, $(SUBSETS))\n92: SUBSET_FILES = $(foreach n,$(SUBSET_ROOTS), $(n).owl $(n).obo $(n).json $(n)_nodes.tsv $(n)_edges.tsv)\n93: \n94: REPORTS = basic-report class-count-by-prefix edges xrefs obsoletes obsoletion-candidates synonyms class-stats root-classes superclass-count\n95: REPORT_ARGS = $(foreach V,$(REPORTS),-s $(SPARQLDIR)/reports/$V.sparql reports/$V.tmp.tsv)\n96: MAIN_REPORT_FILES = $(foreach V, $(REPORTS), reports/$V.tsv)\n97: ADDITIONAL_REPORT_FILES = reports/semantic-xref-pairs.tsv\n98: #ADDITIONAL_REPORT_FILES = reports/release/mondo-obo-report.yaml reports/release/mondo-owl-report.yaml reports/release/semantic-xref-pairs.tsv\n99: REPORT_FILES = $(MAIN_REPORT_FILES) $(ADDITIONAL_REPORT_FILES)\n100: \n101: # Not copying translation files now as they we cany use rsync -R\n102: TRANSLATION_FILES=#$(TRANSLATIONSDIR)/$(ONT)-all.babelon.tsv $(TRANSLATIONSDIR)/$(ONT)-all.babelon.json\n103: MAIN_PRODUCTS = $(ONT) $(ONT)-base $(ONT)-simple $(ONT)-international\n104: MAIN_FILES = $(foreach n,$(MAIN_PRODUCTS), $(n).owl $(n).obo $(n).json) $(ONT)_nodes.tsv $(ONT)_edges.tsv\n105: ARTEFACTS = \\\n106:   $(IMPORT_FILES) \\\n107:   $(MAIN_FILES) \\\n108:   $(REPORT_FILES) \\\n109:   $(COMPONENT_FILES) \\\n110:   $(SUBSET_FILES) \\\n111:   $(TRANSLATION_FILES)\n112: \n113: REPORT_FILES_RELEASE = reports/mondo_release_diff_changed_terms.tsv \\\n114:   reports/mondo_release_diff_new_terms.tsv \\\n115:   reports/mondo_obsoletioncandidates.tsv \\\n116:   reports/source-versions.tsv\n117: \n118: ASSETS = $(MAIN_FILES) $(SUBSET_FILES) \\\n119:   ../../README.md \\\n120:   $(REPORT_FILES_RELEASE)\n121: \n122: list_main_files:\n123: \techo $(MAIN_FILES)\n124: \n125: list_artefacts:\n126: \techo $(ARTEFACTS)\n127: \tdu -sh $(ARTEFACTS)\n128: %-DU:\n129: \t@test -f $* && du -sh $* || echo \"MISSING\" $*\n130: \n131: \n132: all_artefacts: all_reports $(ARTEFACTS)\n133: \n134: all_release_reports: $(REPORT_FILES_RELEASE)\n135: \n136: # ----------------------------------------\n137: # Tests\n138: # ----------------------------------------\n139: \n140: #all: test all_imports all_reports all_equivalencies all_subsets imports/equivalencies.obo $(ONT).owl $(ONT).obo $(ONT).json pre/$(ONT).owl pre/$(ONT).obo pre/$(ONT).json extid/$(ONT).owl extid/$(ONT).obo extid/$(ONT).json $(ONT)-merged.owl\n141: \n142: #TODO: roundtrip.obo seems unnecessary check.\n143: \n144: test: sparql_test_edit roundtrip.obo debug.owl debug_inference_check.owl mondo-edit.owl sparql_test_main_obo test_nomerge\n145: test: reports/robot-report-mondo-tags-reasoned.owl.tsv\n146: \n147: # ----------------------------------------\n148: # Staging releases\n149: # ----------------------------------------\n150: \n151: #prepare_release: $(ARTEFACTS)\n152: #\t$(MAKE) mappings -B\n153: #\trsync -R $^ ../..\n154: \n155: # note: only reports, imports\n156: prepare_release_direct:\n157: \trsync -R $(ARTEFACTS) ../..\n158: \n159: all_includes: $(INCLUDES_OWL)\n160: \n161: #OSF_UPLOAD = $(HOME)/repos/osf-cli/venv/bin/osf -p 2qk53 upload\n162: #osf_upload: prepare_release osf_upload_direct\n163: #osf_upload_direct:\n164: #\tcd ../.. && $(OSF_UPLOAD) -f -r target/ current/ && $(OSF_UPLOAD) -f -r target/ releases/$(ISODATE)\n165: \n166: list_assets:\n167: \tls -alt $(ASSETS)\n168: \techo $(GHVERSION)\n169: \n170: check_version_set:\n171: \t@test $(GHVERSION)\n172: \n173: # REMEMBER TO COMMIT/PUSH\n174: # e.g. make deploy_release GHVERSION=v2018-10-26\n175: # this will create the GH repo. Use --no-create if repo already created.\n176: deploy_release: deploy_assets_direct\n177: #deploy_assets_current see https://github.com/OBOFoundry/purl.obolibrary.org/pull/723\n178: \n179: # deploys to a versioned released\n180: deploy_assets_direct:\n181: \t@test $(GHVERSION)\n182: \tls -alt $(ASSETS)\n183: \tgh release create $(GHVERSION) --notes \"TBD.\" --title \"$(GHVERSION)\" --draft $(ASSETS)\n184: \n185: #\t../utils/make-release-assets.py -c $(RELEASE_ASSETS_OPTS) --release $(GHVERSION) $(ASSETS)\n186: # deploys to https://github.com/monarch-initiative/mondo/releases/tag/current\n187: #deploy_assets_current:\n188: #\tls -alt $(ASSETS)\n189: #\t../utils/make-release-assets.py -c -f --release current $(ASSETS)\n190: \n191: # ----------------------------------------\n192: # Main release targets\n193: # ----------------------------------------\n194: \n195: ANN = annotate -V $(ONTURI)/releases/`date +%Y-%m-%d`/$@.owl\n196: \n197: # the GITHUB_ACTION flag should be set to true to skip computationally intensive actions in the pipeline that are not necessary for QC, see filtered.obo\n198: # Use sparingly\n199: \n200: GITHUB_ACTION = false\n201: \n202: filtered.obo: $(SRC)\n203: \tperl -ne 'print unless (m@^xref: (Orphanet|OMIM|OMIMPS|DOID|EFO|NCIT|SCTID|MESH|UMLS|ICD10CM|icd11.foundation):@ && !(m@(obsoleteEquivalent|equivalentObsolete|equivalentTo|relatedTo|mondoIsNarrowerThanSource|directSiblingOf|mondoIsBroaderThanSource)@i))' $< | grep -v '^property_value: excluded_subClassOf' | egrep -v '^synonym: .*EXCLUDE' | egrep -v 'relationship: disease_has_basis_in_dysfunction_of (hgnc|HGNC|NCBIGene):' > $@.tmp && mv $@.tmp $@\n204: \tperl -ne 'print if !(/^xref: (Orphanet|OMIM|OMIMPS|DOID):/ && !(/(obsoleteEquivalent|equivalentObsolete|equivalentTo|obsoleteEquivalentObsolete)/i))' $@  > $@.tmp && mv $@.tmp $@\n205: \tif [ $(GITHUB_ACTION) = false ]; then $(ROBOT) query -i $@ --use-graphs false \\\n206: \t\t--update ../sparql/update/delete-axiom-annotations.ru \\\n207: \t\t--update ../sparql/update/delete-axiom-annotations-by-prefix.ru \\\n208: \t\t--update ../sparql/update/inject-cross-species-analog.ru \\\n209: \t\tremove --term-file config/remove-annotations-before-release.txt \\\n210: \t\tconvert -f obo --check false -o $@.obo && mv $@.obo $@; fi\n211: #egrep -v 'MONDO:(subClassOf|superClassOf|relatedTo)' $< > $@\n212: \n213: skos.ttl: filtered.obo\n214: \t../utils/mk-skos.pl $< > $@\n215: \n216: # this appears to be problematic. not all declarations are restored on a save.\n217: #REMOVE_DECLARATIONS = --remove-axioms -t Declaration\n218: REMOVE_DECLARATIONS=\n219: \n220: # necessary to remove stray declarations induced by obo2owl;\n221: # we remove declaration axioms for ALL classes;\n222: # all necessary ones are implicitly added back when converting back to OWL\n223: # see: https://github.com/owlcs/owlapi/pull/761\n224: filtered.owl: filtered.obo skos.ttl\n225: \t$(ROBOT) merge -i filtered.obo -i skos.ttl --collapse-import-closure false -o $@\n226: \n227: # perform reasoning on source\n228: # PREVIOUS: SKIP FOR NOW: assume pre-asserted, but run reasoner to check\n229: # note: $(ROBOT) will protect redundant annotated axioms\n230: reasoned.owl: filtered.owl\n231: \t$(ROBOT) reason -T true -x true -X true -i $< -r ELK relax reduce -p false -r ELK \\\n232: \t\tremove --term MONDO:0700097 --term OGMS:0000031 $(ANN) -o $@\n233: \n234: \n235: #test: reasoned-plus-equivalents.owl\n236: \n237: # merged = reasoned + equivalencies\n238: reasoned-plus-equivalents.owl: reasoned.owl imports/equivalencies.owl\n239: \towltools --use-catalog $^ --merge-support-ontologies -o $@\n240: \t#$(ROBOT) reason -i $@ --equivalent-classes-allowed asserted-only -o $(TMPDIR)/$@_test_equivalents.owl\n241: \n242: \n243: \n244: # PRE-RELEASES: MONDO IDs primary\n245: #\n246: # by default we use Elk to perform a reason-relax-reduce chain\n247: # after that we annotate the ontology with the release versionInfo\n248: $(ONT).owl tmp/mondo.owl.ofn: reasoned.owl\n249: \t$(ROBOT) merge -i $< \\\n250: \t\tannotate -V $(ONTURI)/releases/`date +%Y-%m-%d`/$(ONT).owl -o $@ \\\n251: \t\tconvert \\\n252: \t\t\t--add-prefixes config/prefixes.jsonld \\\n253: \t\t\t-f ofn -o tmp/mondo.owl.ofn\n254: \n255: $(ONT).obo: tmp/mondo.owl.ofn\n256: \t$(ROBOT) annotate -i $< \\\n257: \t\t\t-V $(ONTURI)/releases/`date +%Y-%m-%d`/$(ONT).owl \\\n258: \t\t\t--ontology-iri $(OBO)/$(ONT).owl \\\n259: \t\tconvert --check false -f obo -o $@.tmp.obo &&\\\n260: \t\tgrep -v ^owl-axioms $@.tmp.obo > $@ && rm $@.tmp.obo\n261: \n262: $(ONT).json: $(ONT).owl\n263: \t$(ROBOT) convert --input $< --check false -f json -o $@.tmp.json &&\\\n264: \t\tmv $@.tmp.json $@\n265: \n266: $(ONT)_nodes.tsv $(ONT)_edges.tsv: $(ONT).json\n267: \tkgx transform --input-format obojson --output-format tsv --output $(ONT) $< && test -f $(ONT)_nodes.tsv\n268: \n269: ONTOLOGYTERMS=$(TMPDIR)/mondo_classes.txt\n270: \n271: $(ONTOLOGYTERMS): reasoned.owl\n272: \t$(ROBOT) query -f csv -i $< --query ../sparql/signature/mondo-classes.sparql $@\n273: \n274: SIMPLESEED=$(TMPDIR)/simple_seed.txt\n275: \n276: $(SIMPLESEED): reasoned.owl $(ONTOLOGYTERMS)\n277: \t$(ROBOT) query -f csv -i $< --query ../sparql/signature/simple-seed.sparql $@.tmp &&\\\n278: \tcat $@.tmp $(ONTOLOGYTERMS) | sort | uniq >  $@ &&\\\n279: \techo \"http://www.geneontology.org/formats/oboInOwl#SubsetProperty\" >> $@ &&\\\n280: \techo \"http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty\" >> $@\n281: \n282: # foo-simple: (edit->reason,relax,reduce,drop imports, drop every axiom which contains an entity outside the \"namespaces of interest\")\n283: # drop every axiom: filter --term-file keep_terms.txt --trim true\n284: #\tremove --select imports --trim false\n285: # NOTE FOR FUTURE: this is slightly different from the usual simple as it completely removes all\n286: # Object properties from the ontology (remove --select object-properties).\n287: $(ONT)-simple.owl: reasoned.owl $(OTHER_SRC) $(SIMPLESEED) $(IMPORT_FILES)\n288: \t$(ROBOT) merge --input $< \\\n289: \t\treason --equivalent-classes-allowed none --exclude-tautologies true --annotate-inferred-axioms true \\\n290: \t\trelax \\\n291: \t\tremove --axioms equivalent \\\n292: \t\tremove --select object-properties \\\n293: \t\trelax \\\n294: \t\tfilter --term-file $(SIMPLESEED) --select \"annotations ontology anonymous self\" --trim true --signature true \\\n295: \t\treduce \\\n296: \t\tquery --update ../sparql/inject-subset-declaration.ru --update ../sparql/inject-synonymtype-declaration.ru \\\n297: \t\tannotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) --output $@.tmp.owl && mv $@.tmp.owl $@\n298: \n299: $(ONT)-simple.obo: $(ONT)-simple.owl\n300: \t$(OWL2OBO)\n301: \n302: $(ONT)-simple.json: $(ONT)-simple.owl\n303: \t$(ROBOT) convert -i $< -o $@.tmp.json && mv $@.tmp.json $@\n304: \n305: $(ONT)-international.obo: $(ONT)-international.owl\n306: \t$(ROBOT) convert -i $< --check false -o $@.tmp.obo && mv $@.tmp.obo $@\n307: \n308: $(ONT)-international.json: $(ONT)-international.owl\n309: \t$(ROBOT) convert -i $< -o $@.tmp.json && mv $@.tmp.json $@\n310: \n311: \n312: #$(ONT)-atomic.owl: $(ONT).owl\n313: #\towltools --use-catalog $< --remove-imports-declarations --set-ontology-id $(OBO)/$(ONT)/$@ -o $@.tmp && mv $@.tmp $@\n314: \n315: # Component module.\n316: # we remove imports and merge in additional assertions\n317: # note: typically component is not pre-reasoned, but this is compex for mondo.\n318: \n319: OTHER_SRC=imports/axioms.owl #components/mondo-tags.owl\n320: \n321: # The --select \"<http://purl.obolibrary.org/obo/BFO_*>\" is due to a bug with the reason -x option\n322: # Which is supposed to exclude external namespaces from reason, but does not. My guess:\n323: # BFO namespace was needed for Object Properties.\n324: $(ONT)-base.owl: reasoned.owl $(OTHER_SRC)\n325: \t$(ROBOT) remove --input $< --select imports --trim false \\\n326: \t\tmerge $(patsubst %, -i %, $(OTHER_SRC)) \\\n327: \t\tremove --select \"<http://purl.obolibrary.org/obo/BFO_*>\" --select classes \\\n328: \t\tannotate --annotation http://purl.org/dc/elements/1.1/type http://purl.obolibrary.org/obo/IAO_8000001 \\\n329: \t\t--ontology-iri $(ONTBASE)/$@ --version-iri $(ONTBASE)/releases/$(TODAY)/$@ \\\n330: \t\t--output $@.tmp.owl && mv $@.tmp.owl $@\n331: \n332: $(ONT)-base.obo: $(ONT)-base.owl\n333: \t$(OWL2OBO)\n334: $(ONT)-base.json: $(ONT)-base.owl\n335: \t$(ROBOT) convert -i $< -o $@.tmp.json && mv $@.tmp.json $@\n336: \n337: \n338: #pre/$(ONT).%: $(ONT).%\n339: #\t$(ROBOT) annotate -i $< -V $(ONTURI)/pre/$(ONT).owl -o $@\n340: #pre/$(ONT).json: $(ONT).owl\n341: #\t$(ROBOT) annotate -i $< -V $(ONTURI)/pre/$(ONT).owl -o $@\n342: \n343: # CURRENT RELEASES: map back to clique leaders\n344: #extid/mondo.owl: mondo.owl\n345: #\towltools --use-catalog $< --reasoner elk --merge-equivalence-sets -s NCIT 20 -s Orphanet 10 -s OMIM 8 -s EFO 6 -s DOID 5 -s MESH 4 -s MONDO 1 --remove-dangling -o $@\n346: \n347: #extid/mondo.obo: extid/mondo.owl\n348: #\towltools --use-catalog $< --remove-imports-declarations --remove-dangling -o -f obo --no-check $@.tmp && $(obo-filter-axiom-header) $@.tmp > $@\n349: \n350: #$(ONT)-basic.owl: $(ONT).owl\n351: #\towltools --use-catalog $< --remove-imports-declarations --remove-dangling -o $@\n352: #$(ONT)-basic.obo: $(ONT)-basic.owl\n353: #\towltools --use-catalog $<  -o -f obo $(ONT).obo.tmp && mv $(ONT).obo.tmp $@\n354: \n355: %.json: %.owl\n356: \t$(ROBOT) convert --input $< --check false -f json -o $@.tmp.json &&\\\n357: \t\tmv $@.tmp.json $@\n358: \n359: # ensure that inference including equivalencies does not result in merging any classes in MONDO.\n360: # if this fails, the resolution is to look for two MONDO classes with equivalence to the same external class\n361: test_nomerge: mondo.owl\n362: \towltools  --log-error --use-catalog $< --reasoner elk --merge-equivalence-sets -P MONDO -s MONDO 100 --remove-dangling -o $@\n363: \n364: \n365: # ----------------------------------------\n366: # Inference comparison\n367: # ----------------------------------------\n368: filtered-nr.obo: filtered.owl\n369: \t$(ROBOT) relax -i $< reduce -p false -r ELK annotate -O $(OBO)/mondo/$@ -o $@.owl && owltools --use-catalog $@.owl --remove-axiom-annotations -o -f obo --no-check $@.tmp && grep -v ^owl-axioms $@.tmp | obo-grep.pl -r MONDO: - > $@\n370: \n371: filtered-nr-reasoned.obo: filtered.owl\n372: \t$(ROBOT) relax -i $< reduce -p false -r ELK reason -r ELK annotate -O $(OBO)/mondo/$@ -o $@.owl && owltools --use-catalog $@.owl --remove-axiom-annotations -o -f obo --no-check $@.tmp && grep -v ^owl-axioms $@.tmp | obo-grep.pl -r MONDO: - > $@\n373: \n374: reports/reasoner-diff.obo: filtered-nr.obo filtered-nr-reasoned.obo\n375: \tobo-simple-diff.pl -l $^ > $@\n376: \n377: # ----------------------------------------\n378: # CC-0 MINIMAL\n379: # ----------------------------------------\n380: \n381: all_subsets: $(SUBSET_FILES)\n382: \n383: RARE_SUBSET_PRESERVED_RELATIONS=RO:0004003 RO:0000053\n384: \n385: tmp/rare-subset-pre.owl: #$(SRC)\n386: \t$(ROBOT) merge -i $(SRC) reason relax materialize $(patsubst %, --term %, $(RARE_SUBSET_PRESERVED_RELATIONS)) -o $@\n387: \n388: # This gets us all the rare disease classes:\n389: tmp/rare-seed-classes.txt: tmp/rare-subset-pre.owl\n390: \t$(ROBOT) merge -i $< query --query ../sparql/signature/rare-subset.sparql $@\n391: .PRECIOUS: tmp/rare-seed-classes.txt\n392: \n393: # This gets us all the rare disease classes:\n394: tmp/rare-seed-parents.txt: tmp/rare-subset-pre.owl\n395: \t$(ROBOT) merge -i $< query --query ../sparql/signature/rare-subset-parents.sparql $@\n396: .PRECIOUS: tmp/rare-seed-parents.txt\n397: \n398: # This gets us all the entities linked to the rare disease classes\n399: # Make sure you add the relationships you want to add to ../sparql/signature/rare-subset-related-entity.sparql\n400: # AND config/rare_subset_relations.txt\n401: tmp/rare-seed-entities.txt: tmp/rare-subset-pre.owl tmp/rare-seed-classes.txt\n402: \t$(ROBOT) merge -i $< filter -T tmp/rare-seed-classes.txt --trim false query --query ../sparql/signature/rare-subset-related-entity.sparql $@\n403: .PRECIOUS: tmp/rare-seed-entities.txt\n404: \n405: # This merges thes seed together into one file (including rare disease classes _and_ related entities.)\n406: tmp/rare-seed.txt: tmp/rare-seed-entities.txt tmp/rare-seed-classes.txt config/rare_subset_relations.txt tmp/rare-seed-parents.txt\n407: \tcat $^ | sort | uniq > $@\n408: .PRECIOUS: tmp/rare-seed.txt\n409: \n410: $(SUBSETDIR)/mondo-rare.owl: $(ONT)-base.owl $(TMPDIR)/hgnc_import.owl  tmp/rare-seed.txt | $(SUBSETDIR)\n411: \t$(ROBOT) merge -i $< -i $(TMPDIR)/hgnc_import.owl extract --method subset -T tmp/rare-seed.txt --output $@ &&\\\n412: \t$(ROBOT) annotate --input $@ --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) -o $@.tmp.owl && mv $@.tmp.owl $@\n413: .PRECIOUS: $(SUBSETDIR)/mondo-rare.owl\n414: \n415: ########## Clingen Subset ######\n416: \n417: # CURRENTLY NOT USED, ONLY REMOVING NON-HUMAN ANIMAL DISEASES\n418: $(TMPDIR)/clingen-seed.txt: $(SRC)\n419: \t$(ROBOT) merge -i $< query --query ../sparql/signature/clingen-subset.sparql $@\n420: .PRECIOUS: $(TMPDIR)/clingen-seed.txt\n421: \n422: $(SUBSETDIR)/mondo-clingen.owl: $(ONT)-base.owl | $(SUBSETDIR)\n423: \t$(ROBOT) merge -i $< \\\n424: \t\tquery --update ../sparql/update/clingen-labels.ru \\\n425: \t\tremove --term MONDO:0005583 --select \"self descendants\" \\\n426: \t\tannotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) -o $@.tmp.owl && mv $@.tmp.owl $@\n427: .PRECIOUS: $(SUBSETDIR)/mondo-clingen.owl\n428: \n429: $(SUBSETDIR)/%.json: $(SUBSETDIR)/%.owl\n430: \t$(ROBOT) convert -i $< -o $@\n431: \n432: $(SUBSETDIR)/%_nodes.tsv $(SUBSETDIR)/%_edges.tsv: $(SUBSETDIR)/%.json\n433: \tkgx transform --input-format obojson --output-format tsv --output $(SUBSETDIR)/$* $< && test -f $(SUBSETDIR)/$*_nodes.tsv\n434: \n435: $(SUBSETDIR)/%.obo: $(SUBSETDIR)/%.owl\n436: \t$(ROBOT) convert -i $< -o $@.tmp.obo && grep -v ^owl-axioms: $@.tmp.obo > $@ && rm $@.tmp.obo\n437: \n438: rare_subset:\n439: \t$(MAKE) IMP=false MIR=false COMP=false $(SUBSETDIR)/mondo-rare.owl $(SUBSETDIR)/mondo-rare.json $(SUBSETDIR)/mondo-rare.obo\n440: \n441: # ----------------------------------------\n442: # DOSDP Modules\n443: # ----------------------------------------\n444: all_mods: modules/disease_by_location.owl\n445: \n446: modules/%.tsv: modules/%.csv\n447: \tcsv2tsv.py $< $@\n448: \n449: modules/%.owl: modules/%.tsv\n450: \tdosdp-tools  --obo-prefixes --ontology=../ontology/mondo-edit.obo  --template=../patterns/$*.yaml --outfile=$@ generate --infile=$<\n451: \n452: ###### BEGIN PARTIAL ODK MIGRATION ##############\n453: $(TMPDIR) $(REPORTDIR) $(MIRRORDIR) $(IMPORTDIR) $(COMPONENTSDIR) $(SUBSETDIR):\n454: \tmkdir -p $@\n455: \n456: # ----------------------------------------\n457: # Import modules\n458: # ----------------------------------------\n459: # Most ontologies are modularly constructed using portions of other ontologies\n460: # These live in the imports/ folder\n461: # This pattern uses ROBOT to generate an import module\n462: \n463: # Should be able to drop this if robot can just take a big messy list of terms as input.\n464: $(IMPORTDIR)/%_terms_combined.txt: $(IMPORTSEED) $(IMPORTDIR)/%_terms.txt\n465: \tif [ $(IMP) = true ]; then cat $^ | grep -v ^# | sort | uniq >  $@; fi\n466: \n467: \n468: ALL_TERMS_COMBINED = $(patsubst %, $(IMPORTDIR)/%_terms_combined.txt, $(IMPORTS))\n469: $(IMPORTDIR)/merged_terms_combined.txt: $(ALL_TERMS_COMBINED)\n470: \tif [ $(IMP) = true ]; then cat $^ | grep -v ^# | sort | uniq >  $@; fi\n471: \n472: \n473: $(IMPORTDIR)/merged_import.owl: $(MIRRORDIR)/merged.owl $(IMPORTDIR)/merged_terms_combined.txt\n474: \tif [ $(IMP) = true ]; then $(ROBOT) merge -i $< \\\n475: \t\tremove  --select \"<http://purl.obolibrary.org/obo/GOCHE_*>\" \\\n476: \t\tremove  --select \"<http://purl.obolibrary.org/obo/NCBITaxon_Union_*>\" \\\n477: \t\tremove  --select \"<http://www.informatics.jax.org/marker/MGI:*>\" \\\n478: \t\tremove  --select \"<http://purl.obolibrary.org/obo/OBI_*>\" \\\n479: \t\tremove  --select \"<http://identifiers.org/ensembl/ENSG*>\" \\\n480: \t\tremove  --select \"<http://purl.obolibrary.org/obo/CARO_*>\" \\\n481: \t\tremove  --select \"<http://purl.obolibrary.org/obo/RnorDv_*>\" \\\n482: \t\tremove  --select \"<http://purl.obolibrary.org/obo/PR_*>\" \\\n483: \t\tremove  --select \"<http://purl.obolibrary.org/obo/PCO_*>\"\\\n484: \t\tremove  --select \"<http://purl.obolibrary.org/obo/ExO_*>\" \\\n485: \t\tremove  --select \"<http://purl.obolibrary.org/obo/FAO_*>\" \\\n486: \t\tremove  --select \"<http://purl.obolibrary.org/obo/UPHENO_*>\" \\\n487: \t\tremove  --select \"<http://purl.obolibrary.org/obo/COB_*>\" \\\n488: \t\tremove  --select \"<http://purl.obolibrary.org/obo/MPATH_*>\" \\\n489: \t\tremove  --select \"<http://purl.obolibrary.org/obo/PO_*>\" \\\n490: \t\tremove  --select \"<http://purl.obolibrary.org/obo/OGMS_*>\" \\\n491: \t\tremove  --select \"<http://purl.obolibrary.org/obo/ENVO_01001055*>\"  \\\n492: \t\textract -T $(IMPORTDIR)/merged_terms_combined.txt --force true --copy-ontology-annotations true --individuals exclude --method BOT \\\n493: \t\tremove $(patsubst %, --term %, $(ANNOTATION_PROPERTIES)) -T $(IMPORTDIR)/merged_terms_combined.txt --select complement --select \"annotation-properties\" \\\n494: \t\tquery --update ../sparql/inject-subset-declaration.ru --update ../sparql/inject-synonymtype-declaration.ru --update ../sparql/postprocess-module.ru \\\n495: \t\t$(ANNOTATE_CONVERT_FILE); fi\n496: \n497: \n498: \n499: \n500: $(IMPORTDIR)/%_import.owl: $(MIRRORDIR)/merged.owl $(IMPORTDIR)/%_terms_combined.txt\n501: \tif [ $(IMP) = true ]; then $(ROBOT) query -i $< --update ../sparql/preprocess-module.ru \\\n502: \t\textract -T $(IMPORTDIR)/$*_terms_combined.txt --force true --copy-ontology-annotations true --individuals exclude --method BOT \\\n503: \t\tquery --update ../sparql/inject-subset-declaration.ru --update ../sparql/inject-synonymtype-declaration.ru --update ../sparql/postprocess-module.ru \\\n504: \t\t$(ANNOTATE_CONVERT_FILE); fi\n505: \n506: .PRECIOUS: $(IMPORTDIR)/%_import.owl\n507: \n508: \n509: .PHONY: refresh-imports\n510: refresh-imports:\n511: \t$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=true all_imports -B\n512: \n513: .PHONY: no-mirror-refresh-imports\n514: no-mirror-refresh-imports:\n515: \t$(MAKE) IMP=true MIR=false PAT=false IMP_LARGE=true all_imports -B\n516: \n517: .PHONY: refresh-imports-excluding-large\n518: refresh-imports-excluding-large:\n519: \t$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=false all_imports -B\n520: \n521: .PHONY: refresh-%\n522: refresh-%:\n523: \t$(MAKE) IMP=true IMP_LARGE=true MIR=true PAT=false $(IMPORTDIR)/$*_import.owl -B\n524: \n525: .PHONY: no-mirror-refresh-%\n526: no-mirror-refresh-%:\n527: \t$(MAKE) IMP=true IMP_LARGE=true MIR=false PAT=false $(IMPORTDIR)/$*_import.owl -B\n528: \n529: # ----------------------------------------\n530: # Mirroring upstream ontologies\n531: # ----------------------------------------\n532: \n533: IMP=true # Global parameter to bypass import generation\n534: MIR=true # Global parameter to bypass mirror generation\n535: IMP_LARGE=true # Global parameter to bypass handling of large imports\n536: \n537: ## ONTOLOGY: bfo\n538: .PHONY: mirror-bfo\n539: .PRECIOUS: $(MIRRORDIR)/bfo.owl\n540: mirror-bfo: | $(TMPDIR)\n541: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/bfo.owl --create-dirs -o $(MIRRORDIR)/bfo.owl --retry 4 --max-time 400 &&\\\n542: \t\t$(ROBOT) convert -i $(MIRRORDIR)/bfo.owl -o $@.tmp.owl && \\\n543: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri http://purl.obolibrary.org/obo/BFO_ --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n544: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n545: \n546: \n547: ## ONTOLOGY: uberon\n548: .PHONY: mirror-uberon\n549: .PRECIOUS: $(MIRRORDIR)/uberon.owl\n550: mirror-uberon: | $(TMPDIR)\n551: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/uberon.owl --create-dirs -o $(MIRRORDIR)/uberon.owl --retry 4 --max-time 400 &&\\\n552: \t\t$(ROBOT) convert -i $(MIRRORDIR)/uberon.owl -o $@.tmp.owl && \\\n553: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri http://purl.obolibrary.org/obo/UBERON_ --base-iri http://purl.obolibrary.org/obo/UBPROP_ --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n554: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n555: \n556: \n557: ## ONTOLOGY: cl\n558: .PHONY: mirror-cl\n559: .PRECIOUS: $(MIRRORDIR)/cl.owl\n560: mirror-cl: | $(TMPDIR)\n561: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/cl.owl --create-dirs -o $(MIRRORDIR)/cl.owl --retry 4 --max-time 400 &&\\\n562: \t\t$(ROBOT) convert -i $(MIRRORDIR)/cl.owl -o $@.tmp.owl && \\\n563: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/CL --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n564: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n565: \n566: \n567: ## ONTOLOGY: go\n568: .PHONY: mirror-go\n569: .PRECIOUS: $(MIRRORDIR)/go.owl\n570: mirror-go: | $(TMPDIR)\n571: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/go.owl --create-dirs -o $(MIRRORDIR)/go.owl --retry 4 --max-time 400 &&\\\n572: \t\t$(ROBOT) convert -i $(MIRRORDIR)/go.owl -o $@.tmp.owl && \\\n573: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/GO --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n574: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n575: \n576: \n577: ## ONTOLOGY: pato\n578: .PHONY: mirror-pato\n579: .PRECIOUS: $(MIRRORDIR)/pato.owl\n580: mirror-pato: | $(TMPDIR)\n581: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/pato.owl --create-dirs -o $(MIRRORDIR)/pato.owl --retry 4 --max-time 400 &&\\\n582: \t\t$(ROBOT) convert -i $(MIRRORDIR)/pato.owl -o $@.tmp.owl && \\\n583: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/PATO --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n584: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n585: \n586: \n587: ## ONTOLOGY: envo\n588: .PHONY: mirror-envo\n589: .PRECIOUS: $(MIRRORDIR)/envo.owl\n590: mirror-envo: | $(TMPDIR)\n591: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/envo.owl --create-dirs -o $(MIRRORDIR)/envo.owl --retry 4 --max-time 400 &&\\\n592: \t\t$(ROBOT) convert -i $(MIRRORDIR)/envo.owl -o $@.tmp.owl && \\\n593: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/ENVO --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n594: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n595: \n596: \n597: ## ONTOLOGY: ro\n598: .PHONY: mirror-ro\n599: .PRECIOUS: $(MIRRORDIR)/ro.owl\n600: mirror-ro: | $(TMPDIR)\n601: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/ro/ro-base.owl --create-dirs -o $(MIRRORDIR)/ro.owl --retry 4 --max-time 400 &&\\\n602: \t\t$(ROBOT) convert -i $(MIRRORDIR)/ro.owl -o $@.tmp.owl && mv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n603: \n604: \n605: ## ONTOLOGY: hp\n606: .PHONY: mirror-hp\n607: .PRECIOUS: $(MIRRORDIR)/hp.owl\n608: mirror-hp: | $(TMPDIR)\n609: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/hp.owl --create-dirs -o $(MIRRORDIR)/hp.owl --retry 4 --max-time 400 &&\\\n610: \t\t$(ROBOT) convert -i $(MIRRORDIR)/hp.owl -o $@.tmp.owl && \\\n611: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/HP --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n612: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n613: \n614: \n615: ## ONTOLOGY: mf\n616: .PHONY: mirror-mf\n617: .PRECIOUS: $(MIRRORDIR)/mf.owl\n618: mirror-mf: | $(TMPDIR)\n619: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/mf.owl --create-dirs -o $(MIRRORDIR)/mf.owl --retry 4 --max-time 400 &&\\\n620: \t\t$(ROBOT) convert -i $(MIRRORDIR)/mf.owl -o $@.tmp.owl && \\\n621: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/MF --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n622: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n623: \n624: \n625: ## ONTOLOGY: ncbitaxon\n626: .PHONY: mirror-ncbitaxon\n627: .PRECIOUS: $(MIRRORDIR)/ncbitaxon.owl\n628: mirror-ncbitaxon: | $(TMPDIR)\n629: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then $(ROBOT) convert -I http://purl.obolibrary.org/obo/ncbitaxon/subsets/taxslim.owl -o $@.tmp.owl && \\\n630: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri http://purl.obolibrary.org/obo/NCBITaxon_ --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n631: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n632: \n633: \n634: ## ONTOLOGY: chebi\n635: .PHONY: mirror-chebi\n636: .PRECIOUS: $(MIRRORDIR)/chebi.owl\n637: mirror-chebi: | $(TMPDIR)\n638: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then $(ROBOT) convert -I http://purl.obolibrary.org/obo/upheno/chebi_slim.owl -o $@.tmp.owl && \\\n639: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/CHEBI --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n640: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n641: \n642: \n643: ## ONTOLOGY: ncit\n644: .PHONY: mirror-ncit\n645: .PRECIOUS: $(MIRRORDIR)/ncit.owl\n646: mirror-ncit: | $(TMPDIR)\n647: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/ncit.owl --create-dirs -o $(MIRRORDIR)/ncit.owl --retry 4 --max-time 400 &&\\\n648: \t\t$(ROBOT) convert -i $(MIRRORDIR)/ncit.owl -o $@.tmp.owl && \\\n649: \t\t$(ROBOT) remove -i $@.tmp.owl --base-iri $(URIBASE)/NCIT --axioms external --preserve-structure false --trim false -o $@.tmp.owl &&\\\n650: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n651: \n652: \n653: ## ONTOLOGY: hgnc\n654: .PHONY: mirror-hgnc\n655: .PRECIOUS: $(MIRRORDIR)/hgnc.owl\n656: mirror-hgnc: | $(TMPDIR)\n657: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/hgnc.owl --create-dirs -o $(MIRRORDIR)/hgnc.owl --retry 4 --max-time 400 &&\\\n658: \t\t$(ROBOT) convert -i $(MIRRORDIR)/hgnc.owl -o $@.tmp.owl &&\\\n659: \t\tmv $@.tmp.owl $(TMPDIR)/$@.owl; fi\n660: \n661: \n662: ## ONTOLOGY: foodon\n663: .PHONY: mirror-foodon\n664: .PRECIOUS: $(MIRRORDIR)/foodon.owl\n665: mirror-foodon: | $(TMPDIR)\n666: \tif [ $(MIR) = true ] && [ $(IMP) = true ]; then curl -L $(OBOBASE)/foodon.owl --create-dirs -o $(MI