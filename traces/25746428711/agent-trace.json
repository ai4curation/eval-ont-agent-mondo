ng in the src/ontology folder;\n# we therefore map the whole repo (../..) to a docker volume.\n#\n# See README-editors.md for more details.\n\nMEMORY_GB=${MEMORY_GB:-8}\nIMAGE=${IMAGE:-odkfull:v1.6}\nMEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\nODK_DEBUG=${ODK_DEBUG:-no}\n\ndocker pull obolibrary/$IMAGE\n\necho \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"","truncated":false,"loaded":[]},"title":"src/ontology/run.sh","time":{"start":1778602842365,"end":1778602842371}},"id":"prt_e1cfd90d40013pRvomDzqT1kbl","sessionID":"ses_1e30f7595ffeOYCiV8ht3a08Mj","messageID":"msg_e1cfcf6c80019OTSkTKQ9iBQwF"}}
