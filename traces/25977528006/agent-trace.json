{"type":"tool_use","timestamp":1778980148541,"sessionID":"ses_1cc885b9fffe3OQbM3nZ0uAKXI","part":{"type":"tool","tool":"read","callID":"call_4eZ0wxEUTZ9YMGBiHfdkwbc3","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-mondo/eval-ont-agent-mondo/src/ontology/run.sh","offset":1,"limit":120},"output":"<path>/__w/eval-ont-agent-mondo/eval-ont-agent-mondo/src/ontology/run.sh</path>\n<type>file</type>\n<content>\n1: #!/bin/sh\n2: # Wrapper script for docker.\n3: #\n4: # This is used primarily for wrapping the GNU Make workflow.\n5: # Instead of typing \"make TARGET\", type \"./run.sh make TARGET\".\n6: # This will run the make workflow within a docker container.\n7: #\n8: # The assumption is that you are working in the src/ontology folder;\n9: # we therefore map the whole repo (../..) to a docker volume.\n10: #\n11: # See README-editors.md for more details.\n12: \n13: MEMORY_GB=${MEMORY_GB:-8}\n14: IMAGE=${IMAGE:-odkfull:v1.6}\n15: MEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\n16: ODK_DEBUG=${ODK_DEBUG:-no}\n17: \n18: docker pull obolibrary/$IMAGE\n19: \n20: echo \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"\n21: \n22: TIMECMD=\n23: if [ x$ODK_DEBUG = xyes ]; then\n24:     # If you wish to change the format string, take care of using\n25:     # non-breaking spaces (U+00A0) instead of normal spaces, to\n26:     # prevent the shell from tokenizing the format string.\n27:     TIMECMD=\"/usr/bin/time -f ### DEBUG STATS ###\\nElapsed time: %E\\nPeak memory: %M kb\"\n28: fi\n29: \n30: docker run --memory=${MEMORY_GB}g  -v $PWD/../../:/work -w /work/src/ontology -e ROBOT_JAVA_ARGS=${MEMORY_JAVA} -e JAVA_OPTS=${MEMORY_JAVA} --rm -ti obolibrary/$IMAGE $TIMECMD \"$@\"\n\n(End of file - total 30 lines)\n</content>","metadata":{"preview":"#!/bin/sh\n# Wrapper script for docker.\n#\n# This is used primarily for wrapping the GNU Make workflow.\n# Instead of typing \"make TARGET\", type \"./run.sh make TARGET\".\n# This will run the make workflow within a docker container.\n#\n# The assumption is that you are working in the src/ontology folder;\n# we therefore map the whole repo (../..) to a docker volume.\n#\n# See README-editors.md for more details.\n\nMEMORY_GB=${MEMORY_GB:-8}\nIMAGE=${IMAGE:-odkfull:v1.6}\nMEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\nODK_DEBUG=${ODK_DEBUG:-no}\n\ndocker pull obolibrary/$IMAGE\n\necho \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"","truncated":false,"loaded":[]},"title":"src/ontology/run.sh","time":{"start":1778980148530,"end":1778980148539}},"id":"prt_e337ad52c001PPmobcBog13GOu","sessionID":"ses_1cc885b9fffe3OQbM3nZ0uAKXI","messageID":"msg_e337ac246001Y5ydZao6Rx3syY"}}
