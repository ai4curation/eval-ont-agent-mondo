anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/3680\" xsd:anyURI\n\n[Term]\nid: MONDO:0033664\nname: Kilquist syndrome\ndef: \"An autosomal recessive multisystem disorder characterized by neurologic, gastrointestinal, and secretory dysfunction. Affected individuals present at birth with hypotonia, feeding difficulties, mild dysmorphic features, and sensorineural hearing loss. They show poor overall growth associated with gastrointestinal anomalies such as gastroesophageal reflux or midgut malrotation, as well as profound global developmental delay with inability to sit or speak. Tear, sweat, and saliva production is also impaired, causing dry mouth and recurrent bronchial mucus plugging. Some of the clinical features are reminiscent of cystic fibrosis.\" [OMIM:619080, PMID:30740830, PMID:32754646]\nsubset: gard_rare {source=\"GARD:0027953\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:619080\"}\nsubset: ordo_subtype_of_a_disorder {source=\"Orphanet:633021\"}\nsubset: orphanet {source=\"Orphanet:633021\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"KILQS\" EXACT ABBREVIATION [OMIM:619080]\nsynonym: \"SLC12A2-related autosomal recessive neonatal-developmental delay-intellectual disability-feeding difficulty-sensorineural deafness syndrome\" EXACT [https://orcid.org/0000-0001-5493-2602, MONDO:0859761, Orphanet:633021]\nxref: GARD:0027953 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1742639 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:619080 {source=\"MONDO:equivalentTo\"}\nxref: Orphanet:633021 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5436756 {source=\"MEDGEN:1742639\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! hereditary disease\nis_a: MONDO:0859000 {source=\"Orphanet:633021\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! SLC12A2-related developmental delay-intellectual disability-sensorineural deafness syndrome\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql\nrelationship: has_characteristic HP:0000007 {source=\"OMIM:619080\"} ! Autosomal recessive inheritance\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10911 {source=\"OMIM:619080\"} ! SLC12A2\nproperty_value: curated_content_resource \"https://www.malacards.org/card/kilquist_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8462\" xsd:anyURI\n\n[Term]\nid: MONDO:0033665\nname: hearing loss, autosomal dominant 78\nsubset: doid {source=\"DOID:0112159\"}\nsubset: gard_rare {source=\"GARD:0018156\", source=\"MONDO:GARD\"}\nsubset: nord_rare {source=\"MONDO:NORD\"}\nsubset: omim {source=\"OMIM:619081\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"deafness, autosomal dominant 78\" NARROW []\nsynonym: \"DFNA78\" NARROW ABBREVIATION []\nxref: DOID:0112159 {source=\"MONDO:equivalentTo\"}\nxref: GARD:0018156 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1777362 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:619081 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5436768 {source=\"MEDGEN:1777362\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! hereditary disease\nis_a: MONDO:0019587 {source=\"DOID:0112159\", source=\"OMIM:619081\"} ! autosomal dominant nonsyndromic hearing loss\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10911 {source=\"OMIM:619081\"} ! SLC12A2\nproperty_value: curated_content_resource \"https://www.malacards.org/card/autosomal_dominant_nonsyndromic_deafness_78\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: curated_content_resource \"https://www.malacards.org/card/deafness_autosomal_dominant_78\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/4521\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/551\" xsd:anyURI\n\n[Term]\nid: MONDO:0033667\nname: Delpire-McNeill syndrome\ndef: \"Any neurodevelopmental disorder in which the cause of the disease is a mutation in the SLC12A2 gene. It is characterized by global developmental delay, mild to moderate intellectual disability, delayed, poor or absent speech, hypotonia with delayed or absent walking, bilateral sensorineural deafness, and autistic features. Variable features may include ventricular septal defect, tracheoesophageal fistula, hip dislocation, swallowing difficulties (that may require tube feeding), brain anomalies (including cortical dysplasia and agenesis of the corpus callosum) and spasticity.\" [OMIM:619083, Orphanet:633024]\nsubset: gard_rare {source=\"GARD:0018533\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:619083\"}\nsubset: ordo_subtype_of_a_disorder {source=\"Orphanet:633024\"}\nsubset: orphanet {source=\"Orphanet:633024\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"DELMNES\" EXACT ABBREVIATION [OMIM:619083]\nsynonym: \"SLC12A2-related autosomal dominant infantile-developmental delay-intellectual disability-sensorineural deafness syndrome\" EXACT [https://orcid.org/0000-0001-5493-2602, Orphanet:633024]\nxref: GARD:0018533 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1725056 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:619083 {source=\"MONDO:equivalentTo\"}\nxref: Orphanet:633024 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5436771 {source=\"MEDGEN:1725056\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! hereditary disease\nis_a: MONDO:0100500 {source=\"OMIM:619083\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_characteristic HP:0000006 {sou