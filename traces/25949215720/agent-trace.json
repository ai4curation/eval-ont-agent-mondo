nencephaly\ndef: \"A rare congenital brain disorder characterized by complete or almost near-complete unilateral absence of the cortical cortex, which is filled by a sac of cerebrospinal fluid. The presumed cause is a prenatal vascular disruption with occlusion of the carotid artery territories ipsilateral to the damaged brain.\" [https://orcid.org/0000-0001-9310-0163, https://orcid.org/0000-0002-0587-4693, PMID:23324549]\nsubset: gard_rare {source=\"GARD:0027337\", source=\"MONDO:GARD\"}\nsubset: rare\nsynonym: \"hemi-hydranencephaly\" EXACT [https://orcid.org/0000-0001-9310-0163]\nxref: GARD:0027337 {source=\"MONDO:GARD\"}\nxref: icd11.foundation:642941159 {source=\"https://orcid.org/0000-0002-7941-5545\", source=\"MONDO:equivalentTo\", source=\"https://orcid.org/0000-0001-9439-5346\"}\nxref: MEDGEN:199609 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0751210 {source=\"MEDGEN:199609\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0016344 {source=\"PMID:23324549\"} ! hydranencephaly\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8311\" xsd:string\n\n[Term]\nid: MONDO:1040011\nname: vertebral artery dissection\ndef: \"A human disorder which results from a tear in one of the major cervicocerebral arteries, allowing blood to enter the wall of the artery and split its layers. Pathogenesis typically leads to either stenosis or aneurysmal dilatation of the vessel.\" [PMID:19096659, PMID:28722857]\nsubset: gard_rare {source=\"GARD:0027438\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:689001\"}\nsubset: orphanet {source=\"Orphanet:689001\"}\nsubset: orphanet_rare {source=\"Orphanet:689001\"}\nsubset: rare\nsynonym: \"VAD\" EXACT ABBREVIATION [PMID:19096659, PMID:28722857]\nxref: GARD:0027438 {source=\"MONDO:GARD\"}\nxref: MEDGEN:137904 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:689001 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0338586 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:137904\"}\nis_a: MONDO:0006061 {source=\"PMID:19096659\", source=\"PMID:28722857\"} ! cervical artery dissection\nproperty_value: http://purl.org/dc/elements/1.1/date \"2024-07-18T17:01:20Z\" xsd:dateTime\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7593\" xsd:anyURI\n\n[Term]\nid: MONDO:1040014\nname: PPFIA3-related neurodevelopmental disorder\ndef: \"A neurodevelopmental disorder caused by variation in the PPFIA3 gene. This disorder is characterised by developmental delay and intellectual disability. Most patients present variable additional features, including dysmorphisms, microcephaly or macrocephaly, hypotonia, autism spectrum disorder or autistic features, abnormal electroencephalogram, and epilepsy.\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-0987-9862, PMID:38181735]\nsubset: omim {source=\"OMIM:621122\"}\nxref: OMIM:621122 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0100500 {source=\"PMID:38181735\", source=\"https://orcid.org/0000-0002-0587-4693\", source=\"https://orcid.org/0000-0002-0987-9862\"} ! Mendelian neurodevelopmental disorder\nis_a: MONDO:0700092 {source=\"https://orcid.org/0000-0002-0987-9862\"} ! neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9247 ! PPFIA3\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9247 {source=\"OMIM:621122\"} ! PPFIA3\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8160\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8489\" xsd:anyURI\n\n[Term]\nid: MONDO:1040016\nname: cerebral artery stenosis\ndef: \"A cerebrovascular disorder characterized by an abnormal narrowing of a cerebral artery.\" [https://orcid.org/0000-0002-0587-4693]\nxref: MEDGEN:760198 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C1504438 {source=\"MEDGEN:760198\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0011057 {source=\"https://orcid.org/0000-0002-0587-4693\"} ! cerebrovascular disorder\nproperty_value: http://purl.org/dc/elements/1.1/date \"2024-07-22T21:12:58Z\" xsd:dateTime\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7840\" xsd:anyURI\n\n[Term]\nid: MONDO:1040017\nname: intestinal fistula\ndef: \"An intestinal disorder characterized by an opening in the intestine to some epithelial surface.\" [https://orcid.org/0000-0002-0587-4693, PMID:30480947]\nxref: MEDGEN:5862 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0021833 {source=\"MEDGEN:5862\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0005020 {source=\"PMID:30480947\"} ! intestinal disorder\nproperty_value: http://purl.org/dc/elements/1.1/date \"2024-07-23T13:27:04Z\" xsd:dateTime\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/5963\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7837\" xsd:anyURI\n\n[Term]\nid: MONDO:1040024\nname: myelin oligodendrocyte glycoprotein antibody-associated disease\ndef: \"A demyelinating disease of the central nervous system characterized by the presence of a demyelinating event (optic neuritis, myelitis, acute/multiphasic encephalomyelitis, cerebral or polyfocal deficits, brainstem or cerebellar deficits, and/or cerebral cortical encephalitis), a positive myelin oligodendrocyte glycorotein-IgG test, and exclusion of an alternative diagnosis like MS.\" [https://orcid.org/0000-0001-9310-0163, https://orcid.org/0000-0002-0587-4693, PMID:37789888]\nxref: MEDGEN:1813985 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C5554054 {source=\"MONDO:equivalentTo\", source=\"MEDGEN:1813985\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0002562 {source=\"PMID:33374173\"} ! demyelinating disease\nis_a: MONDO:0020800 {source=\"PMID:37789888\"} ! demyelinating disease of central nervous system\nis_a: MONDO:0021166 {source=\"PMID:33374173\"} ! inflammatory disease\nproperty_value: http://purl.org/dc/elements/1.1/date \"2024-07-29T12:26:21Z\" xsd:dateTime\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7776\" xsd:anyURI\n\n[Term]\nid: MONDO:1040026\nname: metastatic malignant neoplasm in the brain\ndef: \"A malignant neoplasm that has spread to the brain from another anatomic site.\" [PMID:29262201]\nsubset: gard_rare {source=\"GARD:0028142\", source=\"MONDO:GARD\"}\nsubset: rare\nxref: GARD:0028142 {source=\"MONDO:GARD\"}\nxref: MEDGEN:113095 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0220650 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:113095\"}\nis_a: MONDO:0001657 {source=\"PMID:29262201\"} ! brain cancer\nis_a: MONDO:0024880 {source=\"PMID:29262201\"} ! metastatic malignant neoplasm\nintersection_of: MONDO:0024880 ! metastatic malignant neoplasm\nintersection_of: disease_has_location UBERON:0000955 ! brain\nproperty_value: http://purl.org/dc/elements/1.1/date \"2024-07-29T14:46:28Z\" xsd:dateTime\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0587-4693\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7839\" xsd:anyURI\n\n[Term]\nid: MONDO:1040032\nname: EN1-related dorsoventral syndrome\ndef: \"A human mesomelic and rhizo-mesomelic dysplasia characterized by marked mesomelic shortening of the lower limbs, cutaneous syndactyly and nail abnormalities (placed on the palmar side of the finger, dysplastic or absent) in hands and feet due mutations in EN1 gene. Other clinical features may include genitourinary abnormalities (including bilateral cryptorchidism, vesicoureteral reflux, hydronephrosis, hypoplastic labia majora), spasticity and seizures.\" [Orphanet:611223]\nsubset: gard_rare {source=\"GARD:0027116\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:611223\"}\nsubset: orphanet {source=\"Orphanet:611223\"}\nsubset: orphanet_rare {source=\"Orphanet:611223\"}\nsubset: rare\nsynonym: \"ENDOVE syndrome\" EXACT [Orphanet:611223]\nsynonym: \"ENDOVES\" EXACT ABBREVIATION [Orphanet:611223]\nxref: GARD:0027116 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1843345 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:611223 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5680225 {source=\"MEDGEN:1843345\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0002-0587-4693\"} ! hereditary disease\nproperty_value: curated_content_resource \"https://www.malacards.org/card/en1_related_dorsoventral_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7574\" xsd:anyURI\n\n[Term]\nid: MONDO:1040033\nname: congenital muscular dystrophy without intellectual disability\ndef: \"A congenital muscular dystrophy due to dystroglycanopathy characterized by a wide phenotypic spectrum which includes hypotonia and muscular weakness present at birth or early infancy, delayed or arrested motor development, and normal intellectual abilities with normal (or only mild abnormalities) neuroimaging studies. Feeding difficulties, joint and spinal deformities, and respiratory insufficiency may be associated. Decreased alpha-dystroglycan on immunohistochemical muscle staining and elevated serum creatine kinase are observed.\" [Orphanet:370980]\nsubset: gard_rare {source=\"GARD:0027117\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:370980\"}\nsubset: orphanet {source=\"Orphanet:370980\"}\nsubset: orphanet_rare {source=\"Orphanet:370980\"}\nsubset: rare\nsynonym: \"CMD without intellectual disability\" EXACT [Orphanet:370980]\nsynonym: \"CMD-no MR\" EXACT [Orphanet:370980]\nsynonym: \"congenital muscular dystrophy-dystroglycanopathy without intellectual disability\" EXACT [Orphanet:370980]\nxref: GARD:0027117 {source=\"MONDO:GARD\"}\nxref: ICD10CM:G71.2 {source=\"Orphanet:370980\"}\nxref: MEDGEN:1681503 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:370980 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5190847 {source=\"MEDGEN:1681503\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0019950 {source=\"https://orcid.org/0000-0002-0587-4693\"} ! congenital muscular dystrophy\nproperty_value: curated_content_resource \"https://www.malacards.org/card/congenital_muscular_dystrophy_without_intellectual_disability\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7566\" xsd:anyURI\n\n[Term]\nid: MONDO:1050000\nname: sycosis barbae\ndef: \"Folliculitis of the beard and/or mustache areas caused by a bacterial infection, usually caused by Staphylococcus aureus.\" [http://purl.obolibrary.org/obo/DERMO_0002078, https://orcid.org/0000-0002-0819-0473]\nsynonym: \"bacterial folliculitis\" RELATED [PMID:33085351]\nxref: icd11.foundation:1245506993 {source=\"https://orcid.org/0000-0002-7941-5545\", source=\"MONDO:equivalentTo\", source=\"https://orcid.org/0000-0001-9439-5346\"}\nxref: MedDRA:10042731 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:546837 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: SCTID:156410002 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0275798 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:546837\"}\nis_a: MONDO:0005113 {source=\"https://orcid.org/0000-0002-0819-0473\"} ! bacterial infectious disease\nis_a: MONDO:0006552 {source=\"https://orcid.org/0000-0002-0819-0473\"} ! folliculitis\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0819-0473\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/pull/8094\" xsd:anyURI\n\n[Term]\nid: MONDO:1060108\nname: PURA-related severe neonatal hypotonia-seizures-encephalopathy syndrome\ndef: \"A rare neurologic disease characterized by neonatal hypotonia, global developmental delay, feeding difficulties, and often seizures or seizure-like episodes. Other frequently observed signs and symptoms include variable dysmorphic features, myopathic facies, respiratory problems, and visual abnormalities, such as strabismus or esotropia. Brain imaging may show delayed myelination and other white matter abnormalities.\" [Orphanet:438213]\nsubset: gard_rare {source=\"GARD:0027440\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:438213\"}\nsubset: orphanet {source=\"Orphanet:438213\"}\nsubset: orphanet_rare {source=\"Orphanet:438213\"}\nsubset: rare\nsynonym: \"PURA syndrome\" NARROW [PMID:28448108]\nsynonym: \"PURA-related neurodevelopmental disorders\" EXACT [https://orcid.org/0000-0001-9310-0163, PMID:28448108]\nxref: GARD:0027440 {source=\"MONDO:GARD\"}\nxref: ICD10CM:G40.4 {source=\"Orphanet:438213\"}\nxref: MEDGEN:863794 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:438213 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4015357 {source=\"MEDGEN:863794\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"PMID:28448108\"} ! hereditary disease\nis_a: MONDO:0015159 {source=\"Orphanet:438213\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! multiple congenital anomalies/dysmorphic syndrome-intellectual disability\nrelationship: curated_content_resource https://www.malacards.org/card/pura_related_neurodevelopmental_disorders {source=\"MONDO:MalaCards\"}\nrelationship: has_characteristic HP:0000006 {source=\"Orphanet:438213\"} ! Autosomal dominant inheritance\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/5114\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6695\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6752\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6876\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6878\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8953\" xsd:anyURI\n\n[Term]\nid: MONDO:1060113\nname: Lipschütz ulcer\ndef: \"A genital ulcer characterized by the rapid onset of painful, necrotic ulcerations of the vulva or lower vagina. It typically occurs in sexually inactive adolescent females or young females and may be preceded by influenza-like or mononucleosis-like symptoms. Acute genital ulceration has been associated with acute Epstein-Barr virus (EBV) infection or other viral and bacterial infections. However, in many cases a cause cannot be determined.\" [PMID:32296983, PMID:37273409]\ncomment: This term is specific to non-sexually transmitted and sudden onset of genital ulcers.\nsynonym: \"acute genital ulcer\" EXACT [https://orcid.org/0000-0001-9310-0163, PMID:37084877]\nsynonym: \"Lipschütz ulcer\" EXACT [https://orcid.org/0000-0001-9310-0163, PMID:32296983]\nxref: MEDGEN:547076 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0276086 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:547076\"}\nis_a: MONDO:0001551 {source=\"PMID:32296983\"} ! ulceration of vulva\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8956\" xsd:anyURI\n\n[Term]\nid: MONDO:1060121\nname: adenoacanthoma\ndef: \"An invasive adenocarcinoma characterized by the presence of focal or extensive transformation of malignant glandular cells to squamous epithelial cells.\" [NCIT:C4200]\nsynonym: \"adenoacanthoma\" EXACT [MPATH:255]\nsynonym: \"adenocarcinoma with squamous metaplasia\" EXACT []\nxref: MEDGEN:90777 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0334393 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:90777\"}\nis_a: MONDO:0004970 {source=\"NCIT:C4200\"} ! adenocarcinoma\nis_a: MONDO:0021043 {source=\"PMID:24969975\", source=\"https://orcid.org/0000-0001-5858-4393\", source=\"https://orcid.org/0000-0001-7941-2961\"} ! mixed neoplasm\nproperty_value: http://purl.org/dc/terms/creator \"https://orcid.org/0000-0002-7638-4659\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9058\" xsd:anyURI\n\n[Term]\nid: MONDO:1060125\nname: congenital high airway obstruction syndrome\ndef: \"A rare, life-threatening fetal condition resulting complete or partial obstruction of the fetal upper airways. Laryngeal atresia is the most frequent cause, but other etiologies, such as laryngeal cyst, subglottic stenosis or atresia, tracheal atresia, and laryngeal or tracheal agenesis are also included.\" [PMID:30572501, PMID:34345328]\nsubset: gard_rare {source=\"GARD:0027441\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:700286\"}\nsubset: orphanet {source=\"Orphanet:700286\"}\nsubset: orphanet_rare {source=\"Orphanet:700286\"}\nsubset: rare\nsynonym: \"CHAOS\" EXACT ABBREVIATION [https://orcid.org/0000-0001-9310-0163, Orphanet:700286]\nxref: GARD:0027441 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1875656 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:700286 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C3665871 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1875656\"}\nis_a: MONDO:0021147 {source=\"Orphanet:700286\"} ! disorder of development or morphogenesis\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9084\" xsd:anyURI\n\n[Term]\nid: MONDO:1060126\nname: exogenous Cushing syndrome\ndef: \"A form of Cushing syndrome caused by prolonged exposure or excessive use of cortisteroids, usually from medications taken to treat other conditions.\" [PMID:25945066]\nsubset: gard_rare {source=\"GARD:0028155\", source=\"MONDO:GARD\"}\nsubset: rare\nsynonym: \"exogenous Cushing’s syndrome\" EXACT [PMID:25945066]\nsynonym: \"iatrogenic Cushing's syndrome\" EXACT [PMID:25945066]\nxref: GARD:0028155 {source=\"MONDO:GARD\"}\nxref: MEDGEN:543520 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0271725 {source=\"MEDGEN:543520\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0018912 {source=\"PMID:25945066\"} ! Cushing syndrome\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6475\" xsd:anyURI\n\n[Term]\nid: MONDO:1060134\nname: atherosclerotic cardiovascular disease\ndef: \"Any cardiovascular disease resulting from atherosclerosis.\" [NCIT:C35771]\nsubset: ncit {source=\"NCIT:C35771\"}\nxref: NCIT:C35771 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0005311 {source=\"NCIT:C35771\", source=\"https://orcid.org/0000-0001-8049-2559\", source=\"https://orcid.org/0000-0003-4593-1186\"} ! atherosclerosis\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9124\" xsd:anyURI\n\n[Term]\nid: MONDO:1060144\nname: retinitis pigmentosa 7, digenic\ndef: \"A digenic form of retinitis pigmentosa resulting from a mutation in the PRPH2 gene and a null mutation of the ROM1 gene, leading to progressive degeneration of the retina and vision loss.\" [OMIM:608133]\nsubset: gard_rare {source=\"GARD:0028161\", source=\"MONDO:GARD\"}\nsubset: rare\nxref: GARD:0028161 {source=\"MONDO:GARD\"}\nxref: MEDGEN:393414 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C2675552 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:393414\"}\nis_a: MONDO:0019200 {source=\"OMIM:608133\"} ! retinitis pigmentosa\nis_a: MONDO:1040055 {source=\"OMIM:608133\"} ! PRPH2-related retinopathy\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/mondo/qc-multiple-gene-associations.sparql\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10254 {source=\"OMIM:608133\"} ! ROM1\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9942 {source=\"OMIM:608133\"} ! PRPH2\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8424\" xsd:anyURI\n\n[Term]\nid: MONDO:1060145\nname: Leber congenital amaurosis 18\ndef: \"A Leber congenital amaurosis that is caused by a variation in the PRPH2 gene.\" [OMIM:608133]\nsubset: gard_rare {source=\"GARD:0028162\", source=\"MONDO:GARD\"}\nsubset: rare\nsynonym: \"LCA18\" EXACT ABBREVIATION []\nxref: GARD:0028162 {source=\"MONDO:GARD\"}\nxref: MEDGEN:861539 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C4013102 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:861539\"}\nis_a: MONDO:0018998 {source=\"OMIM:608133\"} ! Leber congenital amaurosis\nis_a: MONDO:1040055 {source=\"OMIM:608133\"} ! PRPH2-related retinopathy\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/mondo/qc-multiple-gene-associations.sparql\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10254 {source=\"OMIM:608133\"} ! ROM1\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/9942 {source=\"OMIM:608133\"} ! PRPH2\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/8424\" xsd:anyURI\n\n[Term]\nid: MONDO:1060148\nname: empty nose syndrome\ndef: \"A rare iatrogenic disease characterized by paradoxical nasal obstruction and symptoms including air hunger and suffocation-like breathing sensation, nasal dryness and crusting, burning pain or cold airflow sensation, impaired sleep and cognitive function and severe anxiety and depression, and typically occurs after surgical reduction or removal of nasal turbinates.\" [https://orcid.org/0000-0001-9310-0163, PMID:27557473, PMID:39126290]\ncomment: ENS is often misdiagnosed as psychiatric in origin due to the disproportionate suffering compared to physical exam findings. ENS results from disruption of normal nasal airflow dynamics, mucosal sensory feedback, and humidification, typically after aggressive surgical intervention on the nasal turbinates. Estimated prevalence: <1 in 10,000, though underreporting and misdiagnosis likely make this an underestimate. ENS is currently considered a rare, post-surgical complication, with cases reported globally but concentrated among ENT surgical patients. No universally accepted biomarker exists. Diagnosis is based on symptoms, medical history and imaging. There is no cure. Symptom management includes nasal moisturization (saline gels, humidification), nerve modulating agents (e.g., amitriptyline, gabapentin) nasal implants to restore airflow resistance and cognitive-behavioral therapy and psychiatric support. ENS most often develops after surgery and is considered an iatrogenic condition because its other causes also result from medical interventions, such as electrocautery or laser procedures that cause turbinate trauma.\nsubset: gard_rare {source=\"GARD:0028165\", source=\"MONDO:GARD\"}\nsubset: mondo_curated_rare {source=\"https://orcid.org/0000-0002-7638-4659\", source=\"PMID:35155777\"}\nsubset: rare\nsynonym: \"ENS\" EXACT [PMID:27557473, PMID:39126290]\nsynonym: \"nasal iatrogenic dysfunction\" BROAD [https://orcid.org/0000-0001-9310-0163]\nsynonym: \"post-turbinectomy syndrome\" EXACT [https://orcid.org/0000-0001-9310-0163, PMID:17875850]\nsynonym: \"secondary atrophic rhinitis\" EXACT [https://orcid.org/0000-0001-9310-0163, PMID:35155777]\nxref: GARD:0028165 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1876481 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C3888849 {source=\"MEDGEN:1876481\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0005659 {source=\"PMID:35155777\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! atrophic rhinitis\nis_a: MONDO:0043543 {source=\"PMID:17875850\", source=\"PMID:27557473\", source=\"PMID:38961700\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! iatrogenic disease\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9174\" xsd:anyURI\n\n[Term]\nid: MONDO:1060151\nname: schizoaffective bipolar disorder\ndef: \"A schizoaffective disorder marked by episodes of hypomania or mania and sometimes major depression.\" [https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504]\nsynonym: \"schizoaffective disorder bipolar type\" EXACT [https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504]\nxref: MEDGEN:542781 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0270496 {source=\"MEDGEN:542781\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0005487 {source=\"https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504\"} ! schizoaffective disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9280\" xsd:anyURI\n\n[Term]\nid: MONDO:1060152\nname: schizoaffective depressive disorder\ndef: \"A schizoaffective disorder marked by episodes of only major depression.\" [https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504]\nsynonym: \"schizoaffective disorder depressive type\" EXACT [https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504]\nxref: MEDGEN:542782 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0270497 {source=\"MEDGEN:542782\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0005487 {source=\"https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504\"} ! schizoaffective disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9280\" xsd:anyURI\n\n[Term]\nid: MONDO:1060161\nname: inherited distal renal tubular acidosis\ndef: \"A form of distal renal tubular acidosis that is inherited.\" [PMID:33770395]\nsubset: gard_rare {source=\"GARD:0028168\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIMPS:179800\"}\nsubset: rare\nxref: GARD:0028168 {source=\"MONDO:GARD\"}\nxref: OMIMPS:179800 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0015827 {source=\"PMID:33770395\"} ! distal renal tubular acidosis\nintersection_of: MONDO:0015827 ! distal renal tubular acidosis\nintersection_of: has_characteristic MONDO:0021152 ! inherited\nrelationship: has_characteristic MONDO:0021152 {source=\"PMID:33770395\"} ! inherited\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9345\" xsd:string\n\n[Term]\nid: MONDO:1060171\nname: diffuse midline glioma, H3 K27-altered\ndef: \"A diffuse midline glioma characterized by H3 K27 alteration and usually either a histone H3 K27M mutation, an EGFR mutation, or aberrant overexpression of EZHIP. The prognosis is poor.\" [NCIT:C185368]\ncomment: Currently, diffuse midline glioma, H3 K27M-mutant is the single child term. Other child terms will be added during Mondo alignment with NCIT.\nsubset: gard_rare {source=\"GARD:0028173\", source=\"MONDO:GARD\"}\nsubset: ncit {source=\"NCIT:C185368\"}\nsubset: rare\nsynonym: \"DMG, H3 K27-altered\" EXACT [PMID:37835563]\nxref: GARD:0028173 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1811313 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:C185368 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5669877 {source=\"MEDGEN:1811313\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0006033 {source=\"NCIT:C185368\"} ! diffuse intrinsic pontine glioma\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9513\" xsd:anyURI\n\n[Term]\nid: MONDO:1060177\nname: developmental and epileptic encephalopathy 119\ndef: \"A developmental and epileptic encephalopathy caused by the variants in the RNU2-2 gene, in which most reported variants are de novo. It is characterized by global developmental delay, hypotonia, impaired intellectual development, microcephaly, autistic behavior, and characteristically complex seizures.\" [https://clinicalgenome.org/affiliation/40060/, PMID:40210679, PMID:40442284]\nsubset: gard_rare {source=\"GARD:0028178\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:621304\"}\nsubset: rare\nsynonym: \"DEE119\" EXACT ABBREVIATION [OMIM:621304]\nsynonym: \"developmental and epileptic encephalopathy 119\" EXACT [OMIM:621304]\nsynonym: \"RNU2-2 developmental and epileptic encephalopathy\" EXACT [https://clinicalgenome.org/affiliation/40060/] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"RNU2-2 syndrome\" EXACT [PMID:40210679]\nxref: GARD:0028178 {source=\"MONDO:GARD\"}\nxref: OMIM:621304 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0100062 {source=\"https://clinicalgenome.org/affiliation/40060/\"} ! genetic developmental and epileptic encephalopathy\nintersection_of: MONDO:0100062 ! genetic developmental and epileptic encephalopathy\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10152 ! RNU2-2\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10152 {source=\"OMIM:621304\", source=\"PMID:40210679\", source=\"PMID:40442284\", source=\"https://clinicalgenome.org/affiliation/40060/\"} ! RNU2-2\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9595\" xsd:anyURI\n\n[Term]\nid: MONDO:1060178\nname: pediatric acute-onset neuropsychiatric syndrome\ndef: \"An autoimmune disorder that involves a constellation of psychiatric and neurologic symptoms that present simultaneously and in rapid onset, the cause or causes of which are unknown. Although the cause is still under investigation, the manifestations may follow a recent infection.\" [https://orcid.org/0000-0001-7697-3026, PMID:39676248]\nsubset: gard_rare {source=\"GARD:0028179\", source=\"MONDO:GARD\"}\nsubset: rare\nsynonym: \"PANS\" EXACT ABBREVIATION [PMID:37808558, PMID:39676248]\nxref: GARD:0028179 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1673298 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C5197301 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1673298\"}\nis_a: MONDO:0002977 {source=\"PMID:37808558\", source=\"https://orcid.org/0000-0001-7697-3026\"} ! autoimmune disorder of the nervous system\nis_a: MONDO:0700007 {source=\"PMID:39676248\"} ! idiopathic disease\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9607\" xsd:anyURI\n\n[Term]\nid: MONDO:1060179\nname: RNU5B-1 related neurodevelopmental disorder with seizures and joint laxity\ndef: \"A neurodevelopmental disorder in which the cause of the disease is a variation in RNU5B-1 gene and is characterized by global developmental delay, hypotonia, macrocephaly, failure to thrive, abnormality of the eye, seizures, and joint laxity\" [https://clinicalgenome.org/affiliation/40060/, MONDO:patterns/disease_series_by_gene, PMID:40379786, PMID:40442284]\nsubset: omim {source=\"OMIM:621302\"}\nsynonym: \"NEDSJL\" EXACT ABBREVIATION [OMIM:621302]\nsynonym: \"neurodevelopmental disorder with seizures and joint laxity\" EXACT [OMIM:621302]\nsynonym: \"RNU5B-1 related neurodevelopmental disorder with seizures and joint laxity\" EXACT [https://clinicalgenome.org/affiliation/40060/] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"RNU5B-1-related disorder\" BROAD [https://clinicalgenome.org/affiliation/40060/]\nxref: OMIM:621302 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0100500 {source=\"PMID:40379786\", source=\"PMID:40442284\", source=\"https://clinicalgenome.org/affiliation/40060/\"} ! Mendelian neurodevelopmental disorder\nintersection_of: MONDO:0100500 ! Mendelian neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10212 ! RNU5B-1\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10212 {source=\"OMIM:621302\", source=\"PMID:40379786\", source=\"PMID:40442284\", source=\"https://clinicalgenome.org/affiliation/40060/\"} ! RNU5B-1\nproperty_value: http://purl.org/dc/terms/creator \"https://orcid.org/0000-0002-7638-4659\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9596\" xsd:anyURI\n\n[Term]\nid: MONDO:1060180\nname: brain stem glioblastoma\ndef: \"A glioblastoma localized in the brain stem.\" [https://orcid.org/0000-0001-6677-8489, NCIT:C5097]\nsubset: gard_rare {source=\"GARD:0028180\", source=\"MONDO:GARD\"}\nsubset: ncit {source=\"NCIT:C5097\"}\nsubset: rare\nxref: GARD:0028180 {source=\"MONDO:GARD\"}\nxref: MEDGEN:231460 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:C5097 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C1332610 {source=\"MEDGEN:231460\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0002501 {source=\"NCIT:C5097\", source=\"https://orcid.org/0000-0001-6677-8489\"} ! brain glioblastoma\nintersection_of: MONDO:0018177 ! glioblastoma\nintersection_of: disease_has_location UBERON:0002298 ! brainstem\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9644\" xsd:anyURI\n\n[Term]\nid: MONDO:1060185\nname: systemic lupus erythematosus 18\ndef: \"Any systemic lupus erythematosus in which the cause of the disease is a variation in the PLD4 gene.\" [https://clinicalgenome.org/affiliation/40123/, https://orcid.org/0000-0003-1738-6117, MONDO:patterns/disease_series_by_gene, OMIM:621369]\nsubset: gard_rare {source=\"GARD:0028184\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:621369\"}\nsubset: rare\nsynonym: \"SLEB18\" EXACT ABBREVIATION [OMIM:621369]\nsynonym: \"systemic lupus erythematosus related to PLD4\" EXACT [https://clinicalgenome.org/affiliation/40123/] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nxref: GARD:0028184 {source=\"MONDO:GARD\"}\nxref: OMIM:621369 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0007915 {source=\"OMIM:621369\", source=\"https://clinicalgenome.org/affiliation/40123/\", source=\"https://orcid.org/0000-0003-1738-6117\"} ! systemic lupus erythematosus\nintersection_of: MONDO:0007915 ! systemic lupus erythematosus\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/23792 ! PLD4\nrelationship: excluded_from_qc_check http://purl.obolibrary.org/obo/mondo/sparql/qc/mondo/qc-omim-subsumption.sparql\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/23792 {source=\"OMIM:621369\", source=\"https://clinicalgenome.org/affiliation/40123/\", source=\"https://orcid.org/0000-0003-1738-6117\"} ! PLD4\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9683\" xsd:anyURI\n\n[Term]\nid: MONDO:1060188\nname: small plaque parapsoriasis\ndef: \"A variant of parapsoriasis characterized by round-to-oval plaques less than 5cm in diameter, and it rarely progresses.\" [NCIT:C3921, PMID:35426607]\nsubset: ncit {source=\"NCIT:3921\"}\nxref: MEDGEN:75515 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:3921 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0263370 {source=\"MEDGEN:75515\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0006592 {source=\"NCIT:C3921\"} ! parapsoriasis\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9686\" xsd:anyURI\n\n[Term]\nid: MONDO:1060189\nname: large plaque parapsoriasis\ndef: \"A variant of parapsoriasis characterized by erythematous-to-brown patches or thin plaques with fine scales larger than 5cm in diameter. It has a substantial risk to evolve to mycosis fungoides.\" [NCIT:C3670, PMID:35426607]\nsubset: ncit {source=\"NCIT:C3670\"}\nxref: MEDGEN:57907 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:C3670 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0162442 {source=\"MEDGEN:57907\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0006592 {source=\"NCIT:C3670\"} ! parapsoriasis\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9686\" xsd:anyURI\n\n[Term]\nid: MONDO:1060193\nname: X-linked intellectual disability with or without nystagmus\ndef: \"An X-linked intelelctual disability in which the cause of the disease is hypomorphic CASK pathogenic variants. Affected individuals present with intellectual disability with or without congenital nystagmus. Additional features often include epilepsy, speech impairment, motor delay, and variable brain malformations. Phenotypic severity ranges from mild cognitive impairment to severe developmental disability.\" [PMID:24278995]\nsynonym: \"XLID\" EXACT ABBREVIATION [PMID:24278995]\nxref: MEDGEN:476987 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C3275356 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:476987\"}\nis_a: MONDO:0020119 {source=\"PMID:24278995\"} ! X-linked syndromic intellectual disability\nis_a: MONDO:1060192 {source=\"PMID:24278995\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! CASK-related intellectual disability\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/1497 {source=\"PMID:24278995\"} ! CASK\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9747\" xsd:string\n\n[Term]\nid: MONDO:1060198\nname: ischemic stroke\ndef: \"A stroke disorder caused by obstruction of blood flow to the brain, due to thrombotic (local blood clot formation) or embolic (due to a blood clot or other material traveling from another site) event.\" [https://orcid.org/0000-0002-1149-7767, https://www.hopkinsmedicine.org/health/conditions-and-diseases/stroke/types-of-stroke, https://www.stroke.org.uk/stroke/types, PMID:29763173]\nsubset: doid {source=\"DOID:0051062\"}\nsynonym: \"ischaemic stroke\" EXACT OMO:0003005 []\nxref: DOID:0051062 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:215292 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0948008 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:215292\"}\nis_a: MONDO:0005098 {source=\"PMID:29763173\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! stroke disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9754\" xsd:anyURI\n\n[Term]\nid: MONDO:1060199\nname: hemorrhagic stroke\ndef: \"A stroke disorder caused by bleeding into the brain parenchyma or surrounding spaces. Hemorrhagic stroke includes intracerebral hemorrhage (bleeding within the brain tissue) and subarachnoid hemorrhage (bleeding in the space between the brain and the surrounding membrane).\" [https://orcid.org/0000-0002-1149-7767, https://www.hopkinsmedicine.org/health/conditions-and-diseases/stroke/types-of-stroke, https://www.stroke.org.uk/stroke/types, PMID:29763173]\nsubset: doid {source=\"DOID:0051063\"}\nsynonym: \"haemorrhagic stroke\" EXACT OMO:0003005 []\nxref: DOID:0051063 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:1714259 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C5234922 {source=\"MONDO:equivalentTo\", source=\"MEDGEN:1714259\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0005098 {source=\"PMID:29763173\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! stroke disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9754\" xsd:anyURI\n\n[Term]\nid: MONDO:1060200\nname: primary hyperthyroidism\ndef: \"A form of hyperthyroidism caused by overproduction of thyroid hormones (T3 and T4) due to pathology within the thyroid gland itself. Primary hyperthyroidism is characterized by low TSH levels and elevated T3/T4 levels.\" [https://orcid.org/0000-0002-1149-7767, PMID:30725738]\nxref: MEDGEN:811409 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C3714618 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:811409\"}\nis_a: MONDO:0004425 {source=\"PMID:30725738\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! hyperthyroidism\nintersection_of: MONDO:0004425 ! hyperthyroidism\nintersection_of: disease_has_basis_in_dysfunction_of UBERON:0002046 ! thyroid gland\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9759\" xsd:anyURI\n\n[Term]\nid: MONDO:1060201\nname: secondary hyperthyroidism\ndef: \"A form of hyperthyroidism caused by overproduction of thyroid hormones (T3 and T4) due to pathology outside of the thyroid gland, namely in the hypothalamus or pituitary gland. Secondary hyperthyroidism is characterized by elevated TSH levels and elevated T3/T4 levels.\" [https://orcid.org/0000-0002-1149-7767, PMID:30725738]\nxref: MEDGEN:923144 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C1095928 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:923144\"}\nis_a: MONDO:0004425 {source=\"PMID:30725738\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! hyperthyroidism\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9759\" xsd:anyURI\n\n[Term]\nid: MONDO:1060202\nname: toxic thyroid adenoma\ndef: \"A condition in which a single benign adenoma on the thyroid gland  autonomously secretes excessive thyroid hormone, leading to primary hyperthyroidism.\" [https://orcid.org/0000-0002-1149-7767, PMID:30725738]\nsubset: inferred_rare\nsubset: rare\nsynonym: \"toxic adenoma\" EXACT [PMID:30725738]\nxref: MEDGEN:549890 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0302840 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:549890\"}\nis_a: MONDO:0005032 {source=\"PMID:32965923\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! follicular thyroid adenoma\nis_a: MONDO:1060200 {source=\"PMID:30725738\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! primary hyperthyroidism\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9759\" xsd:anyURI\n\n[Term]\nid: MONDO:1060205\nname: dysmenorrhea\ndef: \"A menstrual disorder characterized by pain during the menstrual cycle.\" [https://orcid.org/0000-0002-1149-7767, https://www.acog.org/womens-health/faqs/dysmenorrhea-painful-periods, PMID:32809669]\nxref: MEDGEN:4429 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0013390 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:4429\"}\nis_a: MONDO:1060204 {source=\"PMID:32809669\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! menstrual disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9760\" xsd:anyURI\n\n[Term]\nid: MONDO:1060206\nname: primary dysmenorrhea\ndef: \"A form of dysmenorrhea characterized by recurrent menstrual pain without any identifiable underlying pelvic pathology, representing a diagnosis of exclusion. Symptoms typically emerge within two years of menarche.\" [https://orcid.org/0000-0002-1149-7767, PMID:32809669]\nxref: MEDGEN:508446 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0149875 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:508446\"}\nis_a: MONDO:1060205 {source=\"PMID:32809669\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! dysmenorrhea\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9760\" xsd:anyURI\n\n[Term]\nid: MONDO:1060207\nname: secondary dysmenorrhea\ndef: \"A form of dysmenorrhea associated with suspected or clinically identifiable pelvic pathology, such as endometriosis, uterine fibroids, or adenomyosis.\" [https://orcid.org/0000-0002-1149-7767, PMID:32809669]\nxref: MEDGEN:534931 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0232944 {source=\"MONDO:equivalentTo\", source=\"MEDGEN:534931\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:1060205 {source=\"PMID:32809669\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! dysmenorrhea\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9760\" xsd:anyURI\n\n[Term]\nid: MONDO:1060208\nname: primary amenorrhea\ndef: \"A form of amenorrhea defined by the absence of menstruation by the age of 15 years, or by 3 years after the onset of breast development (thelarche).\" [https://orcid.org/0000-0002-1149-7767, PMID:29489290]\nxref: MEDGEN:115918 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0232939 {source=\"MEDGEN:115918\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0001836 {source=\"PMID:29489290\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! amenorrhea\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9760\" xsd:anyURI\n\n[Term]\nid: MONDO:1060209\nname: secondary amenorrhea\ndef: \"A form of amenorrhea characterized by the absence of menses for 3 or more months in a woman with previously regular menstrual cycles, or 6 or more months in any woman who has had at least one previous spontaneous menstruation.\" [https://orcid.org/0000-0002-1149-7767, PMID:29489290]\nxref: MEDGEN:115919 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C0232940 {source=\"MEDGEN:115919\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0001836 {source=\"PMID:29489290\", source=\"https://orcid.org/0000-0002-1149-7767\"} ! amenorrhea\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9760\" xsd:anyURI\n\n[Term]\nid: MONDO:1060213\nname: reticular pseudodrusen\ndef: \"A retinal drusen characterized by subretinal deposits located internal to the retinal pigment epithelium, composed of material aggregations in the subretinal space between photoreceptors and the retinal pigment epithelium. These deposits have a bluish-white appearance by biomicroscopy and appear as hyperreflective lesions above the retinal pigment epithelium on optical coherence tomography.\" [https://orcid.org/0000-0001-6677-8489, PMID:29859199, PMID:38386332, PMID:41361163]\ncomment: Reticular pseudodrusen are a strong independent risk factor for late age-related macular degeneration and are particularly associated with geographic atrophy and type 3 neovascularization.\nsynonym: \"RPD\" EXACT ABBREVIATION [https://orcid.org/0000-0001-6677-8489, PMID:29859199]\nsynonym: \"SDD\" EXACT ABBREVIATION [https://orcid.org/0000-0001-6677-8489, PMID:29859199]\nsynonym: \"subretinal drusenoid deposit\" EXACT [https://orcid.org/0000-0001-6677-8489, PMID:29859199, PMID:38386332]\nxref: SCTID:762533006 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0006949 {source=\"PMID:29859199\", source=\"https://orcid.org/0000-0001-6677-8489\"} ! retinal drusen\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9849\" xsd:anyURI\n\n[Term]\nid: MONDO:7770001\nname: equine juvenile spinocerebellar ataxia, FDXR-related, horse\ndef: \"Any spinocerebellar ataxia that occurs in horses due to a variation in the FDXR gene. EJSCA is a degenerative axonopathy characterized by acute onset of ataxia within the first month of life, affecting the pelvic limbs more severely than the thoracic limb and rapidly progressing to inability to stand.\" [doi:10.1016/j.jevs.2025.105561, PMID:38669583]\nsynonym: \"EJSCA\" EXACT ABBREVIATION [PMID:38669583]\nxref: OMIA:002846-9796 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:1012960 {source=\"PMID:38669583\"} ! hereditary cerebellar ataxia, non-human animal\nintersection_of: MONDO:1012960 ! hereditary cerebellar ataxia, non-human animal\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/ncbigene/100060312 ! FDXR\nintersection_of: in_taxon NCBITaxon:9796 ! Equus caballus\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/ncbigene/100060312 {source=\"PMID:38669583\"} ! FDXR\nrelationship: in_taxon NCBITaxon:9796 {source=\"PMID:38669583\"} ! Equus caballus\nproperty_value: http://purl.org/dc/terms/creator \"https://orcid.org/0000-0002-5002-8648\" xsd:string\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9143\" xsd:anyURI\n\n[Term]\nid: MONDO:7770002\nname: avoidant/restrictive food intake disorder\ndef: \"An eating disorder characterized by avoidance or restriction of food intake due to one or more of the following: lack of interest in eating or food, sensitivity to sensory characteristics of food (such as taste, texture, smell, or appearance), or concern about aversive consequences of eating (such as choking or vomiting), resulting in persistent failure to meet appropriate nutritional and/or energy needs as manifested by significant weight loss, nutritional deficiency, dependence on enteral feeding or nutritional supplements, or marked interference with psychosocial functioning, and where the eating disturbance is not better explained by lack of available food, cultural or religious practices, another mental disorder, or a concurrent medical condition.\" [PMID:38849953]\nsubset: doid {source=\"DOID:0051057\"}\nsynonym: \"ARFID\" EXACT ABBREVIATION [DOID:0051057, PMID:38849953]\nsynonym: \"selective eating disorder\" EXACT [PMID:38849953]\nxref: DOID:0051057 {source=\"MONDO:equivalentTo\"}\nxref: ICD10CM:F50.82 {source=\"MONDO:equivalentTo\"}\nxref: ICD9:307.59 {source=\"MONDO:relatedTo\"}\nxref: MESH:D000080146 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0005451 {source=\"PMID:38849953\"} ! eating disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0003-3311-7320\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9408\" xsd:anyURI\n\n[Term]\nid: MONDO:7770003\nname: cystic fibrosis-related diabetes\ndef: \"A form of diabetes mellitus unique to individuals with cystic fibrosis (CF), arising primarily from progressive fibrotic destruction of the pancreas leading to insulin deficiency, with additional contributions from insulin resistance. CFRD affects approximately 20% of adolescents and 40-50% of adults with CF. It shares features with both type 1 and type 2 diabetes but is a distinct clinical entity with its own diagnostic criteria and management guidelines.\" [PMID:21115772, PMID:29515516]\nsynonym: \"CF-related diabetes\" EXACT [PMID:21115772]\nsynonym: \"CFRD\" EXACT ABBREVIATION [PMID:21115772]\nxref: ICD10CM:E13 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0005015 {source=\"PMID:21115772\"} ! diabetes mellitus\nintersection_of: MONDO:0005015 ! diabetes mellitus\nintersection_of: disease_arises_from_feature MONDO:0009061 ! cystic fibrosis\nrelationship: disease_arises_from_feature MONDO:0009061 {source=\"PMID:21115772\"} ! cystic fibrosis\n\n[Term]\nid: MONDO:7770004\nname: CFTR-related disorder\ndef: \"A disease associated with CFTR (cystic fibrosis transmembrane conductance regulator) dysfunction that does not fulfill the diagnostic criteria for cystic fibrosis (CF). CFTR-related disorders are characterized by clinical evidence of CFTR dysfunction limited to a single organ system, a sweat chloride concentration below the CF diagnostic threshold (typically less than 60 mmol/L), and CFTR genotypes that often include at least one variant not classified as CF-causing. Recognized CFTR-related disorders include congenital bilateral absence of the vas deferens (CBAVD), acute recurrent or chronic pancreatitis, and disseminated bronchiectasis.\" [PMID:20301428, PMID:21658649]\ncomment: A CFTR-related disorder is defined as a clinical entity with evidence of CFTR dysfunction in at least one organ system that **does not meet** the diagnostic criteria for CF. Typically this means:\\n- Sweat chloride below the CF diagnostic threshold (<60 mmol/L)\\n- Clinical involvement limited to a single organ system\\n- CFTR genotype that includes at least one variant not classified as CF-causing\\n\\nSee 'cystic fibrosis' (MONDO:0009061) for diagnosis criteria for CF.\nsynonym: \"CFTR-RD\" EXACT ABBREVIATION [PMID:21658649]\nsynonym: \"CFTR-related disease\" RELATED [PMID:21658649]\nxref: MEDGEN:1854862 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: UMLS:C5924204 {source=\"MEDGEN:1854862\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0003847 {source=\"PMID:21658649\"} ! hereditary disease\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/1884 {source=\"PMID:21658649\"} ! CFTR\n\n[Term]\nid: MONDO:7770028\nname: spongiform myelopathy, cattle\nxref: OMIA:001156-9913 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:1011336 {source=\"https://orcid.org/0000-0002-5002-8648\"} ! nervous system disorder, non-human animal\nrelationship: in_taxon NCBITaxon:9913 {source=\"OMIA:001156-9913\"} ! Bos taurus\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/10159\" xsd:anyURI\n\n[Term]\nid: MONDO:7770031\nname: ascites, cockatiel\nxref: OMIA:001169-13180 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:1011331 {source=\"https://orcid.org/0000-0002-5002-8648\"} ! metabolic disease, non-human animal\nrelationship: in_taxon NCBITaxon:13180 {source=\"OMIA:001169-13180\"} ! Nymphicus hollandicus\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/10159\" xsd:anyURI\n\n[Term]\nid: MONDO:7770051\nname: short tail sperm, pig\nxref: OMIA:001334-9823 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:1011354 {source=\"https://orcid.org/0000-0002-5002-8648\"} ! reproductive system disorder, non-human animal\nrelationship: in_taxon NCBITaxon:9823 {source=\"OMIA:001334-9823\"} ! Sus scrofa\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/10159\" xsd:anyURI\n\n[Term]\nid: MONDO:7770052\nname: gray coat color, STX17-related, horse\ndef: \"Any integumentary system disorder, occurring in horse, in which the cause of the disease is a variation in the STX17 gene.\" [MONDO:patterns/nonhuman_disease_series_by_gene]\nxref: OMIA:001356-9796 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:1011321 {source=\"https://orcid.org/0000-0002-5002-8648\"} ! hereditary disease, non-human animal\nis_a: MONDO:1011328 {source=\"https://orcid.org/0000-0002-5002-8648\"} ! integumentary system disorder, non-human animal\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/ncbigene/100054797 {source=\"OMIA:001356-9796\"} ! STX17\nrelationship: in_taxon