er container.\n#\n# The assumption is that you are working in the src/ontology folder;\n# we therefore map the whole repo (../..) to a docker volume.\n#\n# See README-editors.md for more details.\n\nMEMORY_GB=${MEMORY_GB:-8}\nIMAGE=${IMAGE:-odkfull:v1.6}\nMEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\nODK_DEBUG=${ODK_DEBUG:-no}\n\ndocker pull obolibrary/$IMAGE\n\necho \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"","truncated":false,"loaded":[]},"title":"src/ontology/run.sh","time":{"start":1778978960249,"end":1778978960281}},"id":"prt_e3368b373001WBBO4vSF5S6wWB","sessionID":"ses_1cc9898d1ffe9Ff1mTnwBbhqKV","messageID":"msg_e3368a2ea001z1bGYiZZHGv4BL"}}
