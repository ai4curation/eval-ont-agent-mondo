ata for new term","status":"completed","priority":"high"},{"content":"Create and check in the new ontology term in terms/ and normalize serialization","status":"in_progress","priority":"high"},{"content":"Validate identifiers/metadata, run syntax or normalization checks, and review diff","status":"pending","priority":"high"},{"content":"Commit only intended ontology changes and create ISSUE_COMMENTS.md and PR_COMMENTS.md","status":"pending","priority":"high"}],"truncated":false},"title":"3 todos","time":{"start":1778976971003,"end":1778976971008}},"id":"prt_e334a4fc0001aXpxFMUyLXCijm","sessionID":"ses_1ccb71acfffePYPEX97Uqgm6bA","messageID":"msg_e334a48af0013mBkaW0eU3RdHT"}}
