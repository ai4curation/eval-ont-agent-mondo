{"type":"tool_use","timestamp":1778980387696,"sessionID":"ses_1cc835d50ffen2Kt2wObzNNoV5","part":{"type":"tool","tool":"read","callID":"call_IM2GopPfUcxMHQiggzL99MiZ","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-mondo/eval-ont-agent-mondo/terms/MONDO_7770004.obo","offset":1,"limit":80},"output":"<path>/__w/eval-ont-agent-mondo/eval-ont-agent-mondo/terms/MONDO_7770004.obo</path>\n<type>file</type>\n<content>\n1: [Term]\n2: id: MONDO:7770004\n3: name: SCN5A-related cardiac rhythm disorder\n4: def: \"A heterogeneous collection of cardiac rhythm disorders caused by genetic variation in the SCN5A gene with autosomal dominant inheritance. Affected individuals are commonly reported to have unremarkable cardiac morphology and at least one cardiac rhythm phenotype that includes, but is not limited to, atrial fibrillation, sick sinus syndrome, progressive cardiac conduction disease, ventricular fibrillation, long QT syndrome, and Brugada syndrome. Individuals with pathogenic variants in SCN5A may also exhibit overlapping or mixed cardiac rhythm phenotypes and intrafamilial variability.\" [https://clinicalgenome.org/affiliation/40104/, https://github.com/monarch-initiative/mondo/issues/9707]\n5: is_a: MONDO:0007263 {source=\"https://clinicalgenome.org/affiliation/40104/\"} ! cardiac rhythm disease\n6: is_a: MONDO:0100547 {source=\"https://clinicalgenome.org/affiliation/40104/\"} ! cardiogenetic disease\n7: is_a: MONDO:7770003 {source=\"https://clinicalgenome.org/affiliation/40104/\"} ! cardiogenetic rhythm disorder\n8: relationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10593 {source=\"OMIM:601144\", source=\"OMIM:603829\", source=\"OMIM:603830\", source=\"OMIM:608567\", source=\"OMIM:614022\", source=\"https://clinicalgenome.org/affiliation/40104/\"} ! SCN5A\n9: property_value: http://purl.org/dc/terms/creator doi:10.1186/s13326-024-00320-3\n10: property_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9707\" xsd:anyURI\n11: \n\n(End of file - total 11 lines)\n</content>","metadata":{"preview":"[Term]\nid: MONDO:7770004\nname: SCN5A-related cardiac rhythm disorder\ndef: \"A heterogeneous collection of cardiac rhythm disorders caused by genetic variation in the SCN5A gene with autosomal dominant inheritance. Affected individuals are commonly reported to have unremarkable cardiac morphology and at least one cardiac rhythm phenotype that includes, but is not limited to, atrial fibrillation, sick sinus syndrome, progressive cardiac conduction disease, ventricular fibrillation, long QT syndrome, and Brugada syndrome. Individuals with pathogenic variants in SCN5A may also exhibit overlapping or mixed cardiac rhythm phenotypes and intrafamilial variability.\" [https://clinicalgenome.org/affiliation/40104/, https://github.com/monarch-initiative/mondo/issues/9707]\nis_a: MONDO:0007263 {source=\"https://clinicalgenome.org/affiliation/40104/\"} ! cardiac rhythm disease\nis_a: MONDO:0100547 {source=\"https://clinicalgenome.org/affiliation/40104/\"} ! cardiogenetic disease\nis_a: MONDO:7770003 {source=\"https://clinicalgenome.org/affiliation/40104/\"} ! cardiogenetic rhythm disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/10593 {source=\"OMIM:601144\", source=\"OMIM:603829\", source=\"OMIM:603830\", source=\"OMIM:608567\", source=\"OMIM:614022\", source=\"https://clinicalgenome.org/affiliation/40104/\"} ! SCN5A\nproperty_value: http://purl.org/dc/terms/creator doi:10.1186/s13326-024-00320-3\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9707\" xsd:anyURI\n","truncated":false,"loaded":[]},"title":"terms/MONDO_7770004.obo","time":{"start":1778980387657,"end":1778980387679}},"id":"prt_e337e7b35001oofOnasn0f5vF0","sessionID":"ses_1cc835d50ffen2Kt2wObzNNoV5","messageID":"msg_e337e65b7001FCoyqIn9sZa1Vg"}}
