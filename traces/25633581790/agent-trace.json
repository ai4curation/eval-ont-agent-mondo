e\nsrc/ontology/subsets/mondo-rare.obo:494831:subset: gard_rare {source=\"GARD:0026430\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494832:subset: otar {source=\"MONDO:OTAR\"}\nsrc/ontology/subsets/mondo-rare.obo:494833:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494844:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:494845:subset: gard_rare {source=\"GARD:0026431\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494846:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494863:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:494864:subset: gard_rare {source=\"GARD:0026432\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494865:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494882:subset: gard_rare {source=\"GARD:0026433\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494883:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494893:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:494894:subset: gard_rare {source=\"GARD:0026434\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494895:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494915:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:494916:subset: gard_rare {source=\"GARD:0026435\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494917:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494937:subset: gard_rare {source=\"GARD:0015153\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494938:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494939:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494952:property_value: skos:exactMatch https://omim.org/entry/216360\nsrc/ontology/subsets/mondo-rare.obo:494958:subset: gard_rare {source=\"GARD:0026436\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494959:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494960:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494975:property_value: skos:exactMatch https://omim.org/entry/619924\nsrc/ontology/subsets/mondo-rare.obo:494997:subset: gard_rare {source=\"GARD:0026437\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494998:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495008:subset: gard_rare {source=\"GARD:0026438\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495009:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495019:subset: gard_rare {source=\"GARD:0026439\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495020:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495030:subset: gard_rare {source=\"GARD:0005106\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495031:subset: otar {source=\"MONDO:OTAR\"}\nsrc/ontology/subsets/mondo-rare.obo:495032:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495048:subset: gard_rare {source=\"GARD:0026440\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495049:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495057:def: \"A rare lung condition characterized by often predominantly unilateral lung hyperlucency and air trapping. The condition is a post-infectious form of bronchiolitis obliterans and typically follows a viral respiratory infection in infancy and childhood. Adenovirus infection is considered the most usual epidemiology. In SJS, the involved lung or portion of the lung does not grow normally and is slightly smaller than the opposite lung: in particular, peripheral branches of the pulmonary vessels do not develop, and vasculature is arreseted at the stage at which the infection occurred. Patients respond well to management with bronchodilators, even though this is not primarily a bronchial abnormality.\" [PMID:32119329]\nsrc/ontology/subsets/mondo-rare.obo:495058:subset: gard_rare {source=\"GARD:0008324\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495059:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495070:subset: gard_rare {source=\"GARD:0026441\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495071:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495080:subset: gard_rare {source=\"GARD:0026442\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495081:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495091:def: \"A rare concurrent association of idiopathic pulmonary hemosiderosis and celiac disease, and is typically seen in children under the age of 15.\" [PMID:21947219]\nsrc/ontology/subsets/mondo-rare.obo:495092:subset: gard_rare {source=\"GARD:0026443\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495093:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495105:subset: gard_rare {source=\"GARD:0026444\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495106:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495116:def: \"A rare hereditary amyloidosis that incorporates deposition of amyloid microfibril material in the lung parenchyma.\" [PMID:29038189]\nsrc/ontology/subsets/mondo-rare.obo:495117:subset: gard_rare {source=\"GARD:0026445\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495118:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495131:subset: gard_rare {source=\"GARD:0026446\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495132:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495133:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495142:subset: gard_rare {source=\"GARD:0026447\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495143:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495144:subset: ordo_disorder {source=\"Orphanet:699605\"}\nsrc/ontology/subsets/mondo-rare.obo:495145:subset: orphanet_rare {source=\"Orphanet:699605\"}\nsrc/ontology/subsets/mondo-rare.obo:495146:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495160:property_value: skos:exactMatch https://omim.org/entry/301081\nsrc/ontology/subsets/mondo-rare.obo:495166:def: \"An autoinflammatory syndrome characterized by onset of various autoimmune features usually in the first decades of life, although later onset has been reported. Typical features include autoimmune cytopenia, hemolytic anemia, thrombocytopenia, and lymphadenopathy. More variable features may include autoimmune thyroiditis, psoriasis or eczema, nephritis, hepatitis, and symptoms of systemic lupus erythematosus (SL). Some patients may have recurrent infections or exacerbation of the disease with acute infection. Laboratory studies show variable findings, often decreased numbers of naive B cells, lymphopenia with skewed subsets, hypogammaglobulinemia, presence of autoantibodies, and a hyperinflammatory state. The disorder shows autosomal dominant inheritance with incomplete penetrance.\" [OMIM:619375]\nsrc/ontology/subsets/mondo-rare.obo:495167:subset: gard_rare {source=\"GARD:0026448\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495168:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495169:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495180:property_value: skos:exactMatch https://omim.org/entry/619375\nsrc/ontology/subsets/mondo-rare.obo:495185:def: \"An immunologic disorder characterized by recurrent mainly sinopulmonary infections associated with increased serum IgE. The phenotype is variable, even within families. Some patients have onset of symptoms in early childhood and develop complications, including bronchiectasis or hemoptysis, whereas others have later onset of less severe infections. Immunologic workup usually shows normal leukocyte levels, although some patients may demonstrate alterations in lymphocyte subsets, including T cells. Affected individuals also have variable skeletal abnormalities, including high-arched palate, hyperextensible joints, scoliosis, and bone fractures. The IL6ST mutations are loss-of-function, although the truncated mutant proteins are expressed and interfere with the wildtype protein in a dominant-negative manner by disrupting IL6 and IL11 signaling.\" [OMIM:619752]\nsrc/ontology/subsets/mondo-rare.obo:495186:subset: gard_rare {source=\"GARD:0026449\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495187:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495188:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495199:property_value: skos:exactMatch https://omim.org/entry/619752\nsrc/ontology/subsets/mondo-rare.obo:495205:subset: gard_rare {source=\"GARD:0026450\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495206:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495207:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495223:subset: gard_rare {source=\"GARD:0026451\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495224:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495233:subset: gard_rare {source=\"GARD:0026452\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495234:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495235:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495244:subset: gard_rare {source=\"GARD:0026453\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495245:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495246:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:495255:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:495256:subset: gard_rare {source=\"GARD:0026454\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:495257:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:495258:subset: ordo_disorder {source=\"Orphanet:697389\"}\nsrc/ontology/subsets/mondo-rare.obo:495259:subset: orphanet_rare {source=\"Orphanet:697389\"}\nsrc/ontology/subsets/mondo-rare.o