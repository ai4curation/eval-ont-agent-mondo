e {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:514356:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:99811\"}\nsrc/ontology/subsets/mondo-rare.obo:514357:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514383:property_value: skos:exactMatch https://omim.org/entry/243180\nsrc/ontology/subsets/mondo-rare.obo:514390:subset: gard_rare {source=\"GARD:0017791\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:514391:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:514392:subset: ordo_disorder {source=\"Orphanet:456312\"}\nsrc/ontology/subsets/mondo-rare.obo:514393:subset: orphanet_rare {source=\"Orphanet:456312\"}\nsrc/ontology/subsets/mondo-rare.obo:514394:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514413:property_value: skos:exactMatch https://omim.org/entry/616263\nsrc/ontology/subsets/mondo-rare.obo:514421:subset: gard_rare {source=\"GARD:0027038\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:514422:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514436:property_value: skos:exactMatch https://omim.org/entry/107320\nsrc/ontology/subsets/mondo-rare.obo:514443:subset: gard_rare {source=\"GARD:0016552\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:514444:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:514445:subset: ordo_disorder {source=\"Orphanet:983\"}\nsrc/ontology/subsets/mondo-rare.obo:514446:subset: ordo_morphological_anomaly {source=\"Orphanet:983\"}\nsrc/ontology/subsets/mondo-rare.obo:514447:subset: orphanet_rare {source=\"Orphanet:983\"}\nsrc/ontology/subsets/mondo-rare.obo:514448:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514479:property_value: skos:exactMatch https://omim.org/entry/273250\nsrc/ontology/subsets/mondo-rare.obo:514486:subset: doid_rare {source=\"DOID:13941\"}\nsrc/ontology/subsets/mondo-rare.obo:514487:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:514488:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514515:property_value: skos:exactMatch https://omim.org/entry/193007\nsrc/ontology/subsets/mondo-rare.obo:514520:subset: gard_rare {source=\"GARD:0027039\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:514521:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514541:def: \"A rare, primary immunodeficiency. It is caused by a currently undetermined defect in the Fas-induced apoptosis pathway. No mutations in Fas, FASLG or CASP10 are detectable. Disruption of Fas-induced apoptosis impairs lymphocyte homeostasis and immune tolerance. Characteristic laboratory findings include an increase in circulating, double-negative (CD4-/CD8-) T cells in the setting of immune-mediated anemia, thrombocytopenia and neutropenia. Clinical signs present in childhood include fatigue, pallor, bruising, hepatosplenomegaly and chronic, non-malignant, non-infectious lymphadenopathy. The clinical course is influenced by a strong association with other autoimmune disorders and an increased risk for developing Hodgkin and non-Hodgkin lymphoma.\" [NCIT:C39577]\nsrc/ontology/subsets/mondo-rare.obo:514542:subset: gard_rare {source=\"GARD:0027040\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:514543:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514558:subset: gard_rare {source=\"GARD:0015987\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:514559:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:514560:subset: ordo_disorder {source=\"Orphanet:664711\"}\nsrc/ontology/subsets/mondo-rare.obo:514561:subset: orphanet_rare {source=\"Orphanet:664711\"}\nsrc/ontology/subsets/mondo-rare.obo:514562:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:514575:property_value: skos:exactMatch https://omim.org/entry/615559\n","exit_code":0,"status":"completed"}}
