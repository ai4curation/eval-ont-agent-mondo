593\"}\nsrc/ontology/subsets/mondo-rare.obo:493751:subset: orphanet_rare {source=\"Orphanet:397593\"}\nsrc/ontology/subsets/mondo-rare.obo:493752:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493767:subset: gard_rare {source=\"GARD:0028028\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493768:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493778:subset: gard_rare {source=\"GARD:0028029\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493779:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493792:subset: gard_rare {source=\"GARD:0028030\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493793:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493803:subset: gard_rare {source=\"GARD:0028031\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493804:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493814:subset: gard_rare {source=\"GARD:0028032\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493815:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493825:subset: gard_rare {source=\"GARD:0028033\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493826:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493839:subset: gard_rare {source=\"GARD:0028034\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493840:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493853:subset: gard_rare {source=\"GARD:0028035\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493854:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493863:subset: gard_rare {source=\"GARD:0028036\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493864:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493878:subset: gard_rare {source=\"GARD:0028037\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493879:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493890:subset: gard_rare {source=\"GARD:0028038\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493891:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493902:subset: gard_rare {source=\"GARD:0028039\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493903:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493916:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493917:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493922:property_value: skos:exactMatch https://omim.org/entry/131300\nsrc/ontology/subsets/mondo-rare.obo:493928:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493929:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493934:property_value: skos:exactMatch https://omim.org/entry/621371\nsrc/ontology/subsets/mondo-rare.obo:493939:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493940:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493943:property_value: skos:exactMatch https://omim.org/entry/621440\nsrc/ontology/subsets/mondo-rare.obo:493949:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493950:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493953:property_value: skos:exactMatch https://omim.org/entry/616117\nsrc/ontology/subsets/mondo-rare.obo:493959:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493960:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493963:property_value: skos:exactMatch https://omim.org/entry/621367\nsrc/ontology/subsets/mondo-rare.obo:493968:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493969:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493972:property_value: skos:exactMatch https://omim.org/entry/621230\nsrc/ontology/subsets/mondo-rare.obo:493977:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493978:subset: omim_susceptibility {source=\"OMIM:616414\"}\nsrc/ontology/subsets/mondo-rare.obo:493979:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493982:property_value: skos:exactMatch https://omim.org/entry/616414\nsrc/ontology/subsets/mondo-rare.obo:493987:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493988:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493991:property_value: skos:exactMatch https://omim.org/entry/621409\nsrc/ontology/subsets/mondo-rare.obo:493996:subset: inferred_rare\nsrc/ontology/subsets/mondo-rare.obo:493997:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:692296\"}\nsrc/ontology/subsets/mondo-rare.obo:493998:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494006:subset: gard_rare {source=\"GARD:0028040\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494007:subset: ordo_disorder {source=\"Orphanet:208989\"}\nsrc/ontology/subsets/mondo-rare.obo:494008:subset: orphanet_rare {source=\"Orphanet:208989\"}\nsrc/ontology/subsets/mondo-rare.obo:494009:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494023:subset: gard_rare {source=\"GARD:0028041\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494024:subset: ordo_disorder {source=\"Orphanet:208999\"}\nsrc/ontology/subsets/mondo-rare.obo:494025:subset: orphanet_rare {source=\"Orphanet:208999\"}\nsrc/ontology/subsets/mondo-rare.obo:494026:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494040:def: \"A rare renal disease characterized by persistent excess urinary calcium excretion in the absence of an underlying systemic disease and hypercalcemia. The condition leads to an increased risk for the formation of kidney stones and nephrocalcinosis, as well as reduced bone mineral density with increased incidence of fractures in some patients.\" [Orphanet:2197]\nsrc/ontology/subsets/mondo-rare.obo:494041:subset: gard_rare {source=\"GARD:0028042\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494042:subset: ordo_disorder {source=\"Orphanet:2197\"}\nsrc/ontology/subsets/mondo-rare.obo:494043:subset: orphanet_rare {source=\"Orphanet:2197\"}\nsrc/ontology/subsets/mondo-rare.obo:494044:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494060:subset: gard_rare {source=\"GARD:0028043\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494061:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:220386\"}\nsrc/ontology/subsets/mondo-rare.obo:494062:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494076:def: \"A very rare form of hypophosphatasia characterized by prenatal skeletal manifestations (limb shortening and bowing) that slowly resolve spontaneously and later may develop into the moderate childhood or adult forms of the disease.\" [Orphanet:247638]\nsrc/ontology/subsets/mondo-rare.obo:494077:subset: gard_rare {source=\"GARD:0028044\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494078:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:247638\"}\nsrc/ontology/subsets/mondo-rare.obo:494079:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494093:def: \"A rare, genetic, limb malformation syndrome characterized by multiple congenital distal joint contractures (incl. talipes equinovarus and both proximal and distal interphalangeal joint contractures of the hands) and very severe motor paralysis at birth (i.e. lack of swallowing, autonomous respiratory function and deep tendon reflexes), leading to death within first 3 months of life. Fetal hypo- or akinesia, late-onset polyhydramnios and dramatically reduced, or absent, motor nerve conduction velocities (<10 m/s) are frequently associated. Nerve ultrastructural morphology shows severe abnormalities of the nodes of Ranvier and myelinated axons.\" [Orphanet:2680]\nsrc/ontology/subsets/mondo-rare.obo:494094:subset: gard_rare {source=\"GARD:0028045\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494095:subset: ordo_disorder {source=\"Orphanet:2680\"}\nsrc/ontology/subsets/mondo-rare.obo:494096:subset: orphanet_rare {source=\"Orphanet:2680\"}\nsrc/ontology/subsets/mondo-rare.obo:494097:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494111:def: \"A rare, congenital, fetal lower urinary tract obstruction (LUTO) anomaly occurring in males and characterized by a posteriorly directed semilunar fold arising from the floor of the anterior urethra and causing urethral obstruction during micturition. The valves may be located anywhere distal to the membranous urethra. Clinical presentation is highly variable, depending on age and degree of urinary obstruction, and includes urinary incontinence, urinary retention, weak urinary stream, post-micturitional dribbling, bulging on the ventral penis, urinary tract infection, and urosepsis.\" [Orphanet:435372]\nsrc/ontology/subsets/mondo-rare.obo:494112:subset: gard_rare {source=\"GARD:0028046\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494113:subset: ordo_disorder {source=\"Orphanet:435372\"}\nsrc/ontology/subsets/mondo-rare.obo:494114:subset: orphanet_rare {source=\"Orphanet:435372\"}\nsrc/ontology/subsets/mondo-rare.obo:494115:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494129:def: \"A rare ophthalmic disorder with cranial nerve involvement characterized by dysfunction of the superior oblique muscle with typical eye motility patterns including elevation in adduction, V-pattern related to reduced abduction force in downgaze with unopposed adduction by the inferior rectus muscle, and excyclotorsion. Patients may present with contralateral head tilt to compensate for vertical binocular misalignment and diplopia.\" [Orphanet:98686]\nsrc/ontology/subsets/mondo-rare.obo:494130:subset: gard_rare {source=\"GARD:0028047\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494131:subset: ordo_disorder {source=\"Orphanet:98686\"}\nsrc/ontology/subsets/mondo-rare.obo:494132:subset: orphanet_rare {source=\"Orphanet:98686\"}\nsrc/ontology/subsets/mondo-rare.obo:494133:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494147:subset: gard_rare {source=\"GARD:0028048\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494148:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:98914\"}\nsrc/ontology/subsets/mondo-rare.obo:494149:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494163:def: \"A rare genetic hyperthyroidism characterized by elevated levels of circulating free thyroid hormones, normal or elevated thyroid-stimulating hormone, decreased peripheral tissue responses to iodothyronine action, and a highly variable clinical phenotype which most commonly includes goiter, resting tachycardia, osteoporosis, short stature, and attention deficit disorder. Some patients may be entirely asymptomatic.\" [Orphanet:566243]\nsrc/ontology/subsets/mondo-rare.obo:494164:subset: gard_rare {source=\"GARD:0028049\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494165:subset: ordo_disorder {source=\"Orphanet:566243\"}\nsrc/ontology/subsets/mondo-rare.obo:494166:subset: orphanet_rare {source=\"Orphanet:566243\"}\nsrc/ontology/subsets/mondo-rare.obo:494167:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494177:def: \"A rare non-syndromic limb malformation characterized by a hand or foot with more than five digits that has a recognizable anterior/posterior axis of symmetry, either with a hallux- or thumb-like structure or an interdigital space in the middle. The most lateral digits on each side typically resemble fifth fingers or toes. The malformation may be unilateral or bilateral and may occur in isolation or in association with other congenital anomalies.\" [Orphanet:498494]\nsrc/ontology/subsets/mondo-rare.obo:494178:subset: gard_rare {source=\"GARD:0028050\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494179:subset: ordo_disorder {source=\"Orphanet:498494\"}\nsrc/ontology/subsets/mondo-rare.obo:494180:subset: orphanet_rare {source=\"Orphanet:498494\"}\nsrc/ontology/subsets/mondo-rare.obo:494181:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494196:subset: gard_rare {source=\"GARD:0028051\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494197:subset: ordo_disorder {source=\"Orphanet:425\"}\nsrc/ontology/subsets/mondo-rare.obo:494198:subset: orphanet_rare {source=\"Orphanet:425\"}\nsrc/ontology/subsets/mondo-rare.obo:494199:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494213:def: \"A rare genetic disease characterized by hypertelorism with facial features that can closely resemble craniofrontonasal dysplasia, such as prominent forehead, widow's peak, heavy and broad eyebrows, long palpebral fissures, ptosis, high and broad nasal bridge, short nose, low-set ears, natal teeth, thin upper lip and a grooved chin, as well as limb (i.e. fifth-finger clinodactyly, pes adductus, mild interdigital webbing), urogenital (i.e. bilateral cryptorchidism and shawl scrotum in males) and umbilical (i.e. hernia/small omphalocele) anomalies and cardiac (i.e. ventricular or atrial septal defect, patent ductus arteriosus) defects. Additional findings such as polycystic kidneys and iridochorioretinal colobomas have also been reported and psychomotor development is normal. The facial features can also resemble Aarskog and Opitz G/BBB syndromes.\" [https://orcid.org/0000-0001-5208-3432, Orphanet:1519]\nsrc/ontology/subsets/mondo-rare.obo:494214:subset: doid_rare {source=\"DOID:0080698\"}\nsrc/ontology/subsets/mondo-rare.obo:494215:subset: gard_rare {source=\"GARD:0000957\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494216:subset: ordo_disorder {source=\"Orphanet:1519\"}\nsrc/ontology/subsets/mondo-rare.obo:494217:subset: ordo_malformation_syndrome {source=\"Orphanet:1519\"}\nsrc/ontology/subsets/mondo-rare.obo:494218:subset: orphanet_rare {source=\"Orphanet:1519\"}\nsrc/ontology/subsets/mondo-rare.obo:494219:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494233:property_value: skos:exactMatch https://omim.org/entry/145420\nsrc/ontology/subsets/mondo-rare.obo:494239:def: \"A rare disease due to a severely impaired central autonomic control of breathing and dysfunction of the autonomous nervous system. The incidence is estimated to be at 1 of 200 000 livebirths. A heterozygous mutation of PHOX-2B gene is found in 90% of the patients. Association with a Hirschsprung's disease is observed in 16% of the cases. Despite a high mortality rate and a lifelong dependence to mechanical ventilation, the long-term outcome of CCHS should be ultimately improved by multidisciplinary and coordinated follow-up of the patients.\" [Orphanet:661]\nsrc/ontology/subsets/mondo-rare.obo:494240:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:494241:subset: doid_rare {source=\"DOID:0060731\"}\nsrc/ontology/subsets/mondo-rare.obo:494242:subset: gard_rare {source=\"GARD:0008535\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494243:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494244:subset: ordo_disorder {source=\"Orphanet:661\"}\nsrc/ontology/subsets/mondo-rare.obo:494245:subset: orphanet_rare {source=\"Orphanet:661\"}\nsrc/ontology/subsets/mondo-rare.obo:494246:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494285:property_value: seeAlso \"https://rarediseases.info.nih.gov/diseases/8535/congenital-central-hypoventilation-syndrome\" xsd:string {source=\"GARD:0008535\"}\nsrc/ontology/subsets/mondo-rare.obo:494293:property_value: skos:exactMatch https://omim.org/entry/209880\nsrc/ontology/subsets/mondo-rare.obo:494300:def: \"A rare autosomal dominant disease characterized by a complex phenotype including progressive dementia, apraxia, apathy, impaired balance, parkinsonism, spasticity and epilepsy.\" [https://orcid.org/0000-0001-5208-3432, Orphanet:313808]\nsrc/ontology/subsets/mondo-rare.obo:494301:subset: doid_rare {source=\"DOID:0080523\"}\nsrc/ontology/subsets/mondo-rare.obo:494302:subset: gard_rare {source=\"GARD:0010981\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494303:subset: nord_rare {source=\"MONDO:NORD\", source=\"NORD:2033\"}\nsrc/ontology/subsets/mondo-rare.obo:494304:subset: ordo_disorder {source=\"Orphanet:313808\"}\nsrc/ontology/subsets/mondo-rare.obo:494305:subset: orphanet_rare {source=\"Orphanet:313808\"}\nsrc/ontology/subsets/mondo-rare.obo:494306:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494352:property_value: skos:exactMatch https://omim.org/entry/221820\nsrc/ontology/subsets/mondo-rare.obo:494360:def: \"A rare paroxysmal movement disorder, with childhood or adolescent onset, characterized by paroxysmal choreiform, dystonic, and myoclonic movements involving the limbs (mostly distal upper limbs), neck and/or face, which can progressively increase in both frequency and severity until they become nearly constant. Patients may also present with delayed motor milestones, perioral and periorbital dyskinesias, dysarthria, hypotonia, and weakness.\" [https://orcid.org/0000-0001-5208-3432, Orphanet:324588]\nsrc/ontology/subsets/mondo-rare.obo:494361:subset: gard_rare {source=\"GARD:0012722\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494362:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494363:subset: ordo_disorder {source=\"Orphanet:324588\"}\nsrc/ontology/subsets/mondo-rare.obo:494364:subset: orphanet_rare {source=\"Orphanet:324588\"}\nsrc/ontology/subsets/mondo-rare.obo:494365:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494384:property_value: skos:exactMatch https://omim.org/entry/606703\nsrc/ontology/subsets/mondo-rare.obo:494390:def: \"A rare genetic disease characterized by multiple intestinal atresia in association with combined immunodeficiency and inflammatory bowel disease. Clinical features include widespread atresia extending from the stomach to the rectum, homogenous calcifications in the abdominal cavity, hepatic cholestasis, cirrhosis, and chronic liver failure, hypoplastic thymus, and increased susceptibility to mainly bacteria and viruses. The immunological phenotype consists of profound generalized T-cell lymphopenia and milder natural killer cell and B-cell lymphopenia, as well as low serum levels of IgG, IgA, and IgM, with elevated serum IgE. The disease is mostly fatal in infancy or childhood.\" [Orphanet:436252]\nsrc/ontology/subsets/mondo-rare.obo:494391:subset: doid_rare {source=\"DOID:14671\"}\nsrc/ontology/subsets/mondo-rare.obo:494392:subset: gard_rare {source=\"GARD:0017731\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494393:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494394:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494412:property_value: seeAlso \"https://rarediseases.info.nih.gov/diseases/3013/intestinal-atresia-multiple\" xsd:anyURI {source=\"GARD:0003013\"}\nsrc/ontology/subsets/mondo-rare.obo:494416:property_value: skos:exactMatch https://omim.org/entry/243150\nsrc/ontology/subsets/mondo-rare.obo:494428:property_value: skos:exactMatch https://omim.org/phenotypicSeries/PS209880\nsrc/ontology/subsets/mondo-rare.obo:494434:subset: gard_rare {source=\"GARD:0026415\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494435:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494445:subset: gard_rare {source=\"GARD:0026416\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494446:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494456:subset: gard_rare {source=\"GARD:0026417\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494457:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494467:subset: gard_rare {source=\"GARD:0026418\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494468:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494478:subset: gard_rare {source=\"GARD:0026419\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494479:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494489:subset: gard_rare {source=\"GARD:0026420\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494490:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494500:subset: gard_rare {source=\"GARD:0026421\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494501:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494511:subset: gard_rare {source=\"GARD:0026422\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494512:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494522:subset: gard_rare {source=\"GARD:0026423\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494523:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494533:subset: gard_rare {source=\"GARD:0026424\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494534:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494544:subset: gard_rare {source=\"GARD:0026425\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494545:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494572:property_value: skos:exactMatch https://omim.org/entry/275210\nsrc/ontology/subsets/mondo-rare.obo:494577:def: \"A rare autosomal recessive congenital primary skeletal dysplasia, characterized by small stature, bowing of the long bones, camptodactyly, hyperthermic episodes, respiratory distress/apneic episodes and feeding difficulties that usually lead to early mortality.\" [Orphanet:3206]\nsrc/ontology/subsets/mondo-rare.obo:494578:subset: gard_rare {source=\"GARD:0005045\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494579:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494580:subset: ordo_disorder {source=\"Orphanet:3206\"}\nsrc/ontology/subsets/mondo-rare.obo:494581:subset: ordo_malformation_syndrome {source=\"Orphanet:3206\"}\nsrc/ontology/subsets/mondo-rare.obo:494582:subset: orphanet_rare {source=\"Orphanet:3206\"}\nsrc/ontology/subsets/mondo-rare.obo:494583:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494620:property_value: skos:exactMatch https://omim.org/entry/601559\nsrc/ontology/subsets/mondo-rare.obo:494626:def: \"A rare autosomal recessive inherited disorder caused by mutations in the NGLY1 gene. It is characterized by developmental delay, hypotonia, abnormal involuntary movements, poor tear production, microcephaly, intractable seizures, abnormal eye movements, and liver abnormalities.\" [NCIT:C126746]\nsrc/ontology/subsets/mondo-rare.obo:494627:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:494628:subset: doid_rare {source=\"DOID:0060728\"}\nsrc/ontology/subsets/mondo-rare.obo:494629:subset: gard_rare {source=\"GARD:0012315\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494630:subset: ncit_rare {source=\"NCIT:C126746\"}\nsrc/ontology/subsets/mondo-rare.obo:494631:subset: nord_rare {source=\"MONDO:NORD\", source=\"NORD:1919\"}\nsrc/ontology/subsets/mondo-rare.obo:494632:subset: ordo_disorder {source=\"Orphanet:404454\"}\nsrc/ontology/subsets/mondo-rare.obo:494633:subset: orphanet_rare {source=\"Orphanet:404454\"}\nsrc/ontology/subsets/mondo-rare.obo:494634:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494671:property_value: skos:exactMatch https://omim.org/entry/615273\nsrc/ontology/subsets/mondo-rare.obo:494678:subset: gard_rare {source=\"GARD:0017848\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:494679:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:494680:subset: ordo_disorder {source=\"Orphanet:674762\"}\nsrc/ontology/subsets/mondo-rare.obo:494681:subset: orphanet_rare {source=\"Orphanet:674762\"}\nsrc/ontology/subsets/mondo-rare.obo:494682:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:494704:property_value: skos:exactMatch https://omim.org/entry/616744\nsrc/ontology/subsets/mondo-rare.obo:494710:def: \"A rare, genetic congenital hypothyroidism disorder characterized by mild global developmental delay in childhood, short stature, delayed bone age, and abnormal thyroid and selenium levels in serum (high total and free T4 concentrations, low T3, high reverse T3, normal to high TSH, decreased selenium). Intellectual disability, primary infertility, hypotonia, muscle weakness, and impaired hearing have also been reported.\" [https://orcid.org/0000-0001-5208-3432, Orphanet:171706]\nsrc/ontology/subsets/mondo-rare.obo:494711:subset: gard_rare {source=\"GARD:0017068\", source=\"MONDO:GARD\