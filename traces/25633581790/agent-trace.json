set: orphanet_rare {source=\"Orphanet:656071\"}\nsrc/ontology/subsets/mondo-rare.obo:505769:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505779:subset: gard_rare {source=\"GARD:0026935\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505780:subset: ordo_disorder {source=\"Orphanet:656283\"}\nsrc/ontology/subsets/mondo-rare.obo:505781:subset: orphanet_rare {source=\"Orphanet:656283\"}\nsrc/ontology/subsets/mondo-rare.obo:505782:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505797:subset: gard_rare {source=\"GARD:0026936\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505798:subset: ordo_disorder {source=\"Orphanet:656300\"}\nsrc/ontology/subsets/mondo-rare.obo:505799:subset: orphanet_rare {source=\"Orphanet:656300\"}\nsrc/ontology/subsets/mondo-rare.obo:505800:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505814:subset: gard_rare {source=\"GARD:0026937\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505815:subset: ordo_disorder {source=\"Orphanet:656313\"}\nsrc/ontology/subsets/mondo-rare.obo:505816:subset: orphanet_rare {source=\"Orphanet:656313\"}\nsrc/ontology/subsets/mondo-rare.obo:505817:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505831:subset: gard_rare {source=\"GARD:0026938\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505832:subset: ordo_disorder {source=\"Orphanet:656326\"}\nsrc/ontology/subsets/mondo-rare.obo:505833:subset: orphanet_rare {source=\"Orphanet:656326\"}\nsrc/ontology/subsets/mondo-rare.obo:505834:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505848:def: \"A rare central nervous system embryonal tumor characterized by embryonal cells arranged in multilayered rosettes and displaying one of three morphological patterns: embryonal tumor with abundant neuropil and true rosettes, ependymoblastoma, or medulloepithelioma. The tumors typically have a C19MC alteration or (rarely) a DICER1 mutation and correspond to WHO grade IV. They are mostly localized intracranially, rarely in the spinal cord, and commonly cause signs and symptoms of elevated intracranial pressure, sometimes seizures and focal neurological signs. Most cases occur in children during the first two years of life.\" [Orphanet:656417]\nsrc/ontology/subsets/mondo-rare.obo:505849:subset: gard_rare {source=\"GARD:0006352\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505850:subset: ordo_disorder {source=\"Orphanet:656417\"}\nsrc/ontology/subsets/mondo-rare.obo:505851:subset: orphanet_rare {source=\"Orphanet:656417\"}\nsrc/ontology/subsets/mondo-rare.obo:505852:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505868:subset: gard_rare {source=\"GARD:0026939\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505869:subset: ordo_disorder {source=\"Orphanet:656912\"}\nsrc/ontology/subsets/mondo-rare.obo:505870:subset: orphanet_rare {source=\"Orphanet:656912\"}\nsrc/ontology/subsets/mondo-rare.obo:505871:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505886:subset: gard_rare {source=\"GARD:0026940\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505887:subset: ordo_disorder {source=\"Orphanet:658549\"}\nsrc/ontology/subsets/mondo-rare.obo:505888:subset: orphanet_rare {source=\"Orphanet:658549\"}\nsrc/ontology/subsets/mondo-rare.obo:505889:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505903:subset: gard_rare {source=\"GARD:0026941\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505904:subset: ordo_disorder {source=\"Orphanet:658574\"}\nsrc/ontology/subsets/mondo-rare.obo:505905:subset: orphanet_rare {source=\"Orphanet:658574\"}\nsrc/ontology/subsets/mondo-rare.obo:505906:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505916:subset: gard_rare {source=\"GARD:0026942\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505917:subset: ordo_disorder {source=\"Orphanet:658602\"}\nsrc/ontology/subsets/mondo-rare.obo:505918:subset: orphanet_rare {source=\"Orphanet:658602\"}\nsrc/ontology/subsets/mondo-rare