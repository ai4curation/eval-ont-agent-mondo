rty_value: skos:exactMatch https://omim.org/entry/620865\nsrc/ontology/subsets/mondo-rare.obo:508198:subset: gard_rare {source=\"GARD:0027159\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508199:subset: ordo_group_of_disorders {source=\"Orphanet:659387\"}\nsrc/ontology/subsets/mondo-rare.obo:508200:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508215:subset: gard_rare {source=\"GARD:0027160\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508216:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:659626\"}\nsrc/ontology/subsets/mondo-rare.obo:508217:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508231:subset: gard_rare {source=\"GARD:0027161\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508232:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:659634\"}\nsrc/ontology/subsets/mondo-rare.obo:508233:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508247:subset: gard_rare {source=\"GARD:0027162\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508248:subset: ordo_disorder {source=\"Orphanet:659744\"}\nsrc/ontology/subsets/mondo-rare.obo:508249:subset: orphanet_rare {source=\"Orphanet:659744\"}\nsrc/ontology/subsets/mondo-rare.obo:508250:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508264:def: \"A rare bacterial infectious disease characterized by development of endothelial cell-derived, blood-filled tumors on the surface of the skin during the chronic phase of infection with Bartonella bacilliformis. The lesions can persist for months to years and may cause pain and scarring due to ulceration. They are classified as miliary (multiple red papules of <3 mm in diameter), mular (blood-filled nodules), and diffuse (groups of subdermal nodules >5 mm in diameter). Eruptions may be accompanied by fever and malaise, lymphadenopathy, acute bone and joint pains, and headache. Fatality rates during this phase are low.\" [Orphanet:659759]\nsrc/ontology/subsets/mondo-rare.obo:508265:subset: gard_rare {source=\"GARD:0027163\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508266:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:659759\"}\nsrc/ontology/subsets/mondo-rare.obo:508267:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508284:subset: gard_rare {source=\"GARD:0027164\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508285:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:508286:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:660012\"}\nsrc/ontology/subsets/mondo-rare.obo:508287:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508301:def: \"A rare neurometabolic disorder characterized by childhood-onset dystonia that shows a dramatic and sustained response to low doses of levodopa (L-dopa) and that may be associated with parkinsonism at an older age.\" [Orphanet:98808]\nsrc/ontology/subsets/mondo-rare.obo:508302:subset: gard_rare {source=\"GARD:0027165\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508303:subset: ordo_disorder {source=\"Orphanet:98808\"}\nsrc/ontology/subsets/mondo-rare.obo:508304:subset: orphanet_rare {source=\"Orphanet:98808\"}\nsrc/ontology/subsets/mondo-rare.obo:508305:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508320:subset: gard_rare {source=\"GARD:0027166\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508321:subset: ordo_disorder {source=\"Orphanet:660021\"}\nsrc/ontology/subsets/mondo-rare.obo:508322:subset: orphanet_rare {source=\"Orphanet:660021\"}\nsrc/ontology/subsets/mondo-rare.obo:508323:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508338:subset: gard_rare {source=\"GARD:0027167\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:508339:subset: ordo_disorder {source=\"Orphanet:661412\"}\nsrc/ontology/subsets/mondo-rare.obo:508340:subset: orphanet_rare {source=\"Orphanet:661412\"}\nsrc/ontology/subsets/mondo-rare.obo:508341:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:508355:subset: gard_rare {source=\