\nsrc/ontology/subsets/mondo-rare.obo:505338:subset: orphanet_rare {source=\"Orphanet:697417\"}\nsrc/ontology/subsets/mondo-rare.obo:505339:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505350:property_value: skos:exactMatch https://omim.org/entry/620670\nsrc/ontology/subsets/mondo-rare.obo:505356:subset: gard_rare {source=\"GARD:0026911\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505357:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505366:property_value: skos:exactMatch https://omim.org/entry/620674\nsrc/ontology/subsets/mondo-rare.obo:505371:subset: gard_rare {source=\"GARD:0026912\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505372:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505382:property_value: skos:exactMatch https://omim.org/entry/620675\nsrc/ontology/subsets/mondo-rare.obo:505387:subset: gard_rare {source=\"GARD:0026913\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505388:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505397:property_value: skos:exactMatch https://omim.org/entry/620679\nsrc/ontology/subsets/mondo-rare.obo:505402:subset: gard_rare {source=\"GARD:0026914\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505403:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505413:property_value: skos:exactMatch https://omim.org/entry/620680\nsrc/ontology/subsets/mondo-rare.obo:505418:subset: gard_rare {source=\"GARD:0026915\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505419:subset: ordo_disorder {source=\"Orphanet:686999\"}\nsrc/ontology/subsets/mondo-rare.obo:505420:subset: orphanet_rare {source=\"Orphanet:686999\"}\nsrc/ontology/subsets/mondo-rare.obo:505421:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505432:property_value: skos:exactMatch https://omim.org/entry/620683\nsrc/ontology/subsets/mondo-rare.obo:505438:subset: gard_rare {source=\"GARD:0026916\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505439:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505448:property_value: skos:exactMatch https://omim.org/entry/620686\nsrc/ontology/subsets/mondo-rare.obo:505453:subset: gard_rare {source=\"GARD:0026917\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505454:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:643538\"}\nsrc/ontology/subsets/mondo-rare.obo:505455:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505466:property_value: skos:exactMatch https://omim.org/entry/616863\nsrc/ontology/subsets/mondo-rare.obo:505472:def: \"A very rare non-dysraphic spinal cord lipoma characterized by being located within the spinal cord. There is no defect in the overlying dura.\" [Orphanet:645359]\nsrc/ontology/subsets/mondo-rare.obo:505473:subset: gard_rare {source=\"GARD:0026918\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505474:subset: ordo_disorder {source=\"Orphanet:645359\"}\nsrc/ontology/subsets/mondo-rare.obo:505475:subset: orphanet_rare {source=\"Orphanet:645359\"}\nsrc/ontology/subsets/mondo-rare.obo:505476:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505490:def: \"A rare form of spina bifida/open neural tube defect (NTD) chacterized by absence of a cystic component, dysplastic meninges and neural placode exposed through a defect in the posterior vertebral arches (spina bifida) that are contiguous with surrounding skin. The placode is at or below the skin plane and is typically associated with a Chiari II malformation. It is usually isolated or rarely associated with split cord malformation.\" [Orphanet:645398]\nsrc/ontology/subsets/mondo-rare.obo:505491:subset: gard_rare {source=\"GARD:0026919\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505492:subset: ordo_disorder {source=\"Orphanet:645398\"}\nsrc/ontology/subsets/mondo-rare.obo:505493:subset: orphanet_rare {source=\"Orphanet:645398\"}\nsrc/ontology/subsets/mondo-rare.obo:505494:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505510:subset: gard_rare {source=\"GARD:0026920\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505511:subset: ordo_group_of_disorders {source=\"Orphanet:646098\"}\nsrc/ontology/subsets/mondo-rare.obo:505512:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505526:subset: gard_rare {source=\"GARD:0026921\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505527:subset: ordo_disorder {source=\"Orphanet:647916\"}\nsrc/ontology/subsets/mondo-rare.obo:505528:subset: orphanet_rare {source=\"Orphanet:647916\"}\nsrc/ontology/subsets/mondo-rare.obo:505529:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505548:def: \"A rare subtype of hemochromatosis characterized by the combination of pathogenic variants in two genes involved in iron metabolism (usually a combination of HFE and non-HFE mutations), where the classical HFE-related hemochromatosis is not enough to fully explain the clinical picture of the patient.\" [Orphanet:648581]\nsrc/ontology/subsets/mondo-rare.obo:505549:subset: gard_rare {source=\"GARD:0026922\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505550:subset: ordo_disorder {source=\"Orphanet:648581\"}\nsrc/ontology/subsets/mondo-rare.obo:505551:subset: orphanet_rare {source=\"Orphanet:648581\"}\nsrc/ontology/subsets/mondo-rare.obo:505552:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505566:subset: gard_rare {source=\"GARD:0026923\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505567:subset: ordo_disorder {source=\"Orphanet:652519\"}\nsrc/ontology/subsets/mondo-rare.obo:505568:subset: orphanet_rare {source=\"Orphanet:652519\"}\nsrc/ontology/subsets/mondo-rare.obo:505569:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505584:subset: gard_rare {source=\"GARD:0026924\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505585:subset: ordo_disorder {source=\"Orphanet:652528\"}\nsrc/ontology/subsets/mondo-rare.obo:505586:subset: orphanet_rare {source=\"Orphanet:652528\"}\nsrc/ontology/subsets/mondo-rare.obo:505587:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505601:def: \"A rare genetic neurological disorder characterized by congenital or early-onset sensorineural deafness and adult-onset progressive leukoencephalopathy. Progressive cognitive impairment and behavioral abnormalities are observed in the second or third decade of life, sometimes preceded by mild developmental delay and learning difficulties. Visual impairment in adult age has been reported. No central nervous system calcification is reported.\" [Orphanet:652532]\nsrc/ontology/subsets/mondo-rare.obo:505602:subset: gard_rare {source=\"GARD:0026925\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505603:subset: ordo_disorder {source=\"Orphanet:652532\"}\nsrc/ontology/subsets/mondo-rare.obo:505604:subset: orphanet_rare {source=\"Orphanet:652532\"}\nsrc/ontology/subsets/mondo-rare.obo:505605:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505619:subset: gard_rare {source=\"GARD:0026926\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505620:subset: ordo_disorder {source=\"Orphanet:652650\"}\nsrc/ontology/subsets/mondo-rare.obo:505621:subset: orphanet_rare {source=\"Orphanet:652650\"}\nsrc/ontology/subsets/mondo-rare.obo:505622:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505639:subset: gard_rare {source=\"GARD:0026927\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505640:subset: ordo_disorder {source=\"Orphanet:652658\"}\nsrc/ontology/subsets/mondo-rare.obo:505641:subset: orphanet_rare {source=\"Orphanet:652658\"}\nsrc/ontology/subsets/mondo-rare.obo:505642:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505658:subset: gard_rare {source=\"GARD:0026928\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:505659:subset: ordo_disorder {source=\"Orphanet:652668\"}\nsrc/ontology/subsets/mondo-rare.obo:505660:subset: orphanet_rare {source=\"Orphanet:652668\"}\nsrc/ontology/subsets/mondo-rare.obo:505661:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:505675:subset: gard_rare {sour