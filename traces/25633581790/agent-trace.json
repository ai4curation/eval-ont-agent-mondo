ubsets/mondo-rare.obo:489575:subset: gard_rare {source=\"GARD:0027067\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489576:subset: otar {source=\"MONDO:OTAR\"}\nsrc/ontology/subsets/mondo-rare.obo:489577:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489587:subset: gard_rare {source=\"GARD:0026261\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489588:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489600:subset: clingen {source=\"MONDO:CLINGEN\"}\nsrc/ontology/subsets/mondo-rare.obo:489601:subset: gard_rare {source=\"GARD:0027999\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489602:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489628:subset: gard_rare {source=\"GARD:0015078\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489629:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489649:property_value: skos:exactMatch https://omim.org/entry/146550\nsrc/ontology/subsets/mondo-rare.obo:489666:subset: gard_rare {source=\"GARD:0026262\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489667:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489687:property_value: skos:exactMatch https://omim.org/phenotypicSeries/PS604370\nsrc/ontology/subsets/mondo-rare.obo:489693:def: \"An extremely rare primary bone dysplasia with increased bone density characterized by lethal neonatal dwarfism with hydrops, narrow chest and short limbs with extensive cortical thickening of all long bones, ribs, clavicles and scapulae, and coronal clefts in vertebral bodies.\" [Orphanet:2204]\nsrc/ontology/subsets/mondo-rare.obo:489694:subset: gard_rare {source=\"GARD:0002022\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489695:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:2204\"}\nsrc/ontology/subsets/mondo-rare.obo:489696:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489713:subset: gard_rare {source=\"GARD:0017920\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489714:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:500055\"}\nsrc/ontology/subsets/mondo-rare.obo:489715:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489735:def: \"A rare, photosensitive epileptic disorder characterized by highly stereotyped seizures. During these seizures, individuals with Sunflower syndrome turn toward a bright light while simultaneously waving one hand in front of their eyes. This unique behavior is coupled with abrupt lapses in consciousness.\" [https://www.massgeneral.org/children/sunflower-syndrome, PMID:33135153, PMID:34653789]\nsrc/ontology/subsets/mondo-rare.obo:489736:subset: gard_rare {source=\"GARD:0026263\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489737:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489749:subset: gard_rare {source=\"GARD:0026264\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489750:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489764:subset: gard_rare {source=\"GARD:0026265\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489765:subset: ncit_rare {source=\"NCIT:C168730\"}\nsrc/ontology/subsets/mondo-rare.obo:489766:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489786:property_value: skos:exactMatch https://omim.org/entry/310300\nsrc/ontology/subsets/mondo-rare.obo:489794:subset: gard_rare {source=\"GARD:0026266\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489795:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489810:subset: gard_rare {source=\"GARD:0026267\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489811:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489824:subset: gard_rare {source=\"GARD:0026268\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489825:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489838:subset: gard_rare {source=\"GARD:0026269\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489839:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489854:subset: gard_rare {source=\"GARD:0026270\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489855:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489866:subset: gard_rare {source=\"GARD:0026271\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489867:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489886:subset: gard_rare {source=\"GARD:0026272\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489887:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489903:subset: gard_rare {source=\"GARD:0026273\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489904:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489918:subset: gard_rare {source=\"GARD:0026274\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489919:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489944:subset: gard_rare {source=\"GARD:0026275\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489945:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:489973:def: \"A rare form of myositis that affects only the orbital muscles.\" [NCIT:C117296]\nsrc/ontology/subsets/mondo-rare.obo:489974:subset: gard_rare {source=\"GARD:0026276\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:489975:subset: ncit_rare {source=\"NCIT:C117296\"}\nsrc/ontology/subsets/mondo-rare.obo:489976:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490000:subset: gard_rare {source=\"GARD:0027068\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490001:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490014:def: \"A rare hereditary ATTR amyloidosis (hATTR) characterized by a progressive, length-dependent sensorimotor axonal polyneuropathy and/or autonomic neuropathy in adulthood. Renal, ocular and cardiac involvement also frequently occurs. Two different phenotypes are associated with this mutation, namely early-onset V30M and late-onset V30M, that differ in terms of age on onset (<50 years or >50 years, respectively), presenting features, histopathological characteristics, rate of disease progression and response to therapy.\" [Orphanet:85447]\nsrc/ontology/subsets/mondo-rare.obo:490015:subset: gard_rare {source=\"GARD:0016754\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490016:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:85447\"}\nsrc/ontology/subsets/mondo-rare.obo:490017:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490044:subset: gard_rare {source=\"GARD:0026277\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490045:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490060:property_value: skos:exactMatch https://omim.org/entry/137760\nsrc/ontology/subsets/mondo-rare.obo:490067:subset: gard_rare {source=\"GARD:0026278\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490068:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490074:property_value: skos:exactMatch https://omim.org/phenotypicSeries/PS161400\nsrc/ontology/subsets/mondo-rare.obo:490079:def: \"A group of rare movement and seizure disorders caused by changes (disease-causing variants or mutations) in the PRRT2 gene. They include a spectrum of specific disorders including paroxysmal kinesigenic dyskinesia (PKD), benign familial infantile epilepsy (BFIE), paroxysmal kinesigenic dyskinesia with infantile convulsions (PKD/IC) and hemiplegic migraine (HM). In addition, PRRT2 pathogenic variants have been identified in other childhood-onset movement disorders and different types of seizure conditions, such as paroxysmal torticollis, episodic ataxia and familial paroxysmal non-kinesigenic dyskinesia. It’s important to note that these disorders can also have different genetic causes.\" [https://rarediseases.org/rare-diseases/prrt2-associated-paroxysmal-movement-disorders/#references, PMID:32916768, PMID:33746883]\nsrc/ontology/subsets/mondo-rare.obo:490080:subset: gard_rare {source=\"GARD:0028000\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490081:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490092:subset: gard_rare {source=\"GARD:0027275\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490093:subset: nord_rare {source=\"MONDO:NORD\"}\nsrc/ontology/subsets/mondo-rare.obo:490094:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490108:subset: gard_rare {source=\"GARD:0026279\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490109:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490122:def: \"A rare form of chronic conjunctivitis characterized by the development of firm fibrin-rich, woody-like pseudomembraneous lesions mainly on the tarsal conjunctivae. Ligneous conjunctivitis is usually the initial and most common manifestation of type I congenital plasminogen deficiency.\" [OMIM:217090, PMID:12850227]\nsrc/ontology/subsets/mondo-rare.obo:490123:subset: gard_rare {source=\"GARD:0006187\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490124:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490143:subset: gard_rare {source=\"GARD:0026280\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490144:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490155:subset: gard_rare {source=\"GARD:0026281\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490156:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490167:subset: gard_rare {source=\"GARD:0026282\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490168:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490178:subset: gard_rare {source=\"GARD:0026283\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490179:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490190:subset: gard_rare {source=\"GARD:0026284\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490191:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490201:subset: gard_rare {source=\"GARD:0019086\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490202:subset: ordo_disorder {source=\"Orphanet:86909\"}\nsrc/ontology/subsets/mondo-rare.obo:490203:subset: orphanet_rare {source=\"Orphanet:86909\"}\nsrc/ontology/subsets/mondo-rare.obo:490204:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490227:def: \"A rare hereditary angioedema characterized by potentially life-threatening episodes of subcutaneous and/or submucosal edema without urticaria and with normal levels and function of C1 esterase inhibitor. Patients present with prolonged attacks which last for approximately two to five days and may include nonpitting edema of the skin, severe abdominal symptoms such as pain and swelling, and/or respiratory distress due to upper respiratory airways involvement. Affected locations and frequency of attacks differ slightly between subtypes. Estrogen-containing oral contraceptives and pregnancy are precipitating factors, especially in patients with a factor XII mutation.\" [Orphanet:528647]\nsrc/ontology/subsets/mondo-rare.obo:490228:subset: gard_rare {source=\"GARD:0022195\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490229:subset: ordo_disorder {source=\"Orphanet:528647\"}\nsrc/ontology/subsets/mondo-rare.obo:490230:subset: orphanet_rare {source=\"Orphanet:528647\"}\nsrc/ontology/subsets/mondo-rare.obo:490231:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490253:subset: gard_rare {source=\"GARD:0026285\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490254:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490264:subset: gard_rare {source=\"GARD:0026286\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490265:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490283:subset: gard_rare {source=\"GARD:0027069\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490284:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490345:subset: gard_rare {source=\"GARD:0027276\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490346:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490367:subset: gard_rare {source=\"GARD:0027277\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490368:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490382:subset: gard_rare {source=\"GARD:0027278\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490383:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490399:subset: gard_rare {source=\"GARD:0027279\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490400:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490410:subset: gard_rare {source=\"GARD:0027280\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490411:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490423:subset: gard_rare {source=\"GARD:0027281\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490424:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490436:subset: gard_rare {source=\"GARD:0027282\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490437:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490448:subset: gard_rare {source=\"GARD:0027283\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490449:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490474:subset: gard_rare {source=\"GARD:0027284\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490475:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490501:subset: gard_rare {source=\"GARD:0027285\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490502:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490510:subset: gard_rare {source=\"GARD:0027286\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490511:subset: ordo_subtype_of_a_disorder {source=\"Orphanet:137639\"}\nsrc/ontology/subsets/mondo-rare.obo:490512:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490536:subset: gard_rare {source=\"GARD:0027287\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490537:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490556:def: \"A rare hypomyelinating leukodystrophy disorder in which the cause of the disease is a variation in any of the POLR genes, including POLR1C, POLR3A or POLR3B. It is characterized by the association of dental abnormalities (delayed dentition, abnormal order of dentition, hypodontia), hypogonadotropic hypogonadism, and hypomyelinating leukodystrophy manifesting with neurodevelopmental delay or regression and/or progressive cerebellar symptoms.\" [https://orcid.org/0000-0002-4142-7153, Orphanet:289494]\nsrc/ontology/subsets/mondo-rare.obo:490557:subset: gard_rare {source=\"GARD:0027288\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490558:subset: ordo_disorder {source=\"Orphanet:289494\"}\nsrc/ontology/subsets/mondo-rare.obo:490559:subset: orphanet_rare {source=\"Orphanet:289494\"}\nsrc/ontology/subsets/mondo-rare.obo:490560:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490576:subset: gard_rare {source=\"GARD:0027289\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490577:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490586:subset: gard_rare {source=\"GARD:0027290\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490587:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490600:property_value: skos:exactMatch https://omim.org/entry/621125\nsrc/ontology/subsets/mondo-rare.obo:490606:subset: gard_rare {source=\"GARD:0027291\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490607:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490617:subset: gard_rare {source=\"GARD:0027292\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490618:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490628:subset: doid_rare {source=\"DOID:0050432\"}\nsrc/ontology/subsets/mondo-rare.obo:490629:subset: gard_rare {source=\"GARD:0028001\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490630:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:490654:subset: gard_rare {source=\"GARD:0028002\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:490655:subset: rare\nsrc/ontology/subsets/mondo-rare.o