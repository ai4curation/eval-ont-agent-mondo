ogy/subsets/mondo-rare.obo:493483:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493493:def: \"A rare familial cardiomyopathy characterized by the dilation of left ventricle and progressively impairing of systolic ventricular function, in the absence of abnormal loading conditions or coronary artery disease sufficient to cause global systolic impairment. The disease may cause heart failure or arrhythmia. The disease is isolated when no additional atypical cardiac or extracardiac manifestations are present.\" [Orphanet:154]\nsrc/ontology/subsets/mondo-rare.obo:493494:subset: gard_rare {source=\"GARD:0027293\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493495:subset: ordo_disorder {source=\"Orphanet:154\"}\nsrc/ontology/subsets/mondo-rare.obo:493496:subset: orphanet_rare {source=\"Orphanet:154\"}\nsrc/ontology/subsets/mondo-rare.obo:493497:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493542:subset: gard_rare {source=\"GARD:0027294\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493543:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493554:subset: gard_rare {source=\"GARD:0027295\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493555:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493567:subset: ordo_disorder {source=\"Orphanet:696897\"}\nsrc/ontology/subsets/mondo-rare.obo:493568:subset: orphanet_rare {source=\"Orphanet:696897\"}\nsrc/ontology/subsets/mondo-rare.obo:493569:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493583:subset: gard_rare {source=\"GARD:0028015\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493584:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493594:property_value: skos:exactMatch https://omim.org/entry/621169\nsrc/ontology/subsets/mondo-rare.obo:493599:subset: gard_rare {source=\"GARD:0028016\", source=\"MONDO:GARD\"}\nsrc/ontology/subsets/mondo-rare.obo:493600:subset: rare\nsrc/ontology/subsets/mondo-rare.obo:493611:property_value: skos:exactMatch https://omim.or