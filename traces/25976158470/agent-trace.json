identifiers.org/hgnc/4588 {source=\"OMIM:617162\"} ! GRIN2D\nproperty_value: curated_content_resource \"https://www.malacards.org/card/developmental_and_epileptic_encephalopathy_46\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/4521\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9063\" xsd:anyURI\n\n[Term]\nid: MONDO:0700350\nname: GRIN2B-related complex neurodevelopmental disorder\ndef: \"A complex neurodevelopmental disorder caused by a variation in the GRIN2B gene\" [https://orcid.org/0000-0002-4142-7153]\nsubset: gard_rare {source=\"GARD:0028024\", source=\"MONDO:GARD\"}\nsubset: rare\nxref: GARD:0028024 {source=\"MONDO:GARD\"}\nis_a: MONDO:0100038 {source=\"https://orcid.org/0000-0002-4142-7153\"} ! complex neurodevelopmental disorder\nis_a: MONDO:1060138 {source=\"https://orcid.org/0000-0002-4142-7153\"} ! GRIN-related complex neurodevelopmental disorder\nintersection_of: MONDO:0100038 ! complex neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/4586 ! GRIN2B\n\n[Term]\nid: MONDO:1060123\nname: GRIN1-related complex neurodevelopmental disorder\ndef: \"A neurodevelopmental disorder caused by variation in the GRIN1 gene. It is characterized by mild-to-profound developmental delay/intellectual disability (DD/ID) in all affected individuals. Other common manifestations are epilepsy, muscular hypotonia, movement disorders, spasticity, feeding difficulties, and behavior issues. A subset of individuals show a malformation of cortical development consisting of extensive and diffuse bilateral polymicrogyria.\" [PMID:31219694]\nsubset: gard_rare {source=\"GARD:0028154\", source=\"MONDO:GARD\"}\nsubset: rare\nsynonym: \"GRIN1-related developmental and epileptic encephalopathy\" EXACT [PMID:31219694]\nsynonym: \"GRIN1-related neurodevelopmental disorder\" EXACT [PMID:31219694]\nxref: GARD:0028154 {source=\"MONDO:GARD\"}\nis_a: MONDO:0700092 {source=\"PMID:31219694\"} ! neurodevelopmental disorder\nis_a: MONDO:1060138 {source=\"PMID:40374652\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! GRIN-related complex neurodevelopmental disorder\nintersection_of: MONDO:0700092 ! neurodevelopmental disorder\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/4584 ! GRIN1\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/4584 {source=\"PMID:31219694\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! GRIN1\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-7638-4659\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9063\" xsd:string\n\n[Term]\nid: MONDO:1060138\nname: GRIN-related complex neurodevelopmental disorder\ndef: \"A group of neurological and neurodevelopmental disorders caused by pathogenic variants in genes encoding subunits of the N-methyl-D-aspartate (NMDA) receptor, including GRIN1, GRIN2A, GRIN2B, and GRIN2D. These disorders are associated with a spectrum of symptoms such as developmental delay, intellectual disability, epilepsy, movement disorders, speech and language impairment, and neuropsychiatric features. The clinical presentation and severity vary depending on the specific gene and mutation involved.\" [https://orcid.org/0000-0001-9310-0163, PMID:40374652]\nsubset: gard_rare {source=\"GARD:0028156\", source=\"MONDO:GARD\"}\nsubset: rare\nxref: GARD:0028156 {source=\"MONDO:GARD\"}\nis_a: MONDO:0003847 {source=\"PMID:40374652\"} ! hereditary disease\nis_a: MONDO:0100038 {source=\"https://orcid.org/0000-0002-4142-7153\"} ! complex neurodevelopmental disorder\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9063\" xsd:anyURI\n\n[Term]\nid: MONDO:1060139\nname: GRIN2A-related complex neurodevelopmental disorder\ndef: \"A group of neurological and neurodevelopmental disorders caused by variants in the GRIN2A gene, characterized by a broad spectrum of symptoms including developmental delay or intellectual disability, epilepsy, speech and language impairments, movement disorders, and neuropsychiatric features.\" [https://orcid.org/0000-0001-9310-0163, OMIM:245570, PMID:27683935]\nsubset: gard_rare {source=\"GARD:0028157\", source=\"MONDO:GARD\"}\nsubset: rare\nxref: GARD:0028157 {source=\"MONDO:GARD\"}\nis_a: MONDO:1060138 {source=\"PMID:40374652\", source=\"https://orcid.org/0000-0001-9310-0163\"} ! GRIN-related complex neurodevelopmental disorder\nintersection_of: MONDO:0003847 ! hereditary disease\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/4585 ! GRIN2A\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/4585 {source=\"PMID:27683935\"} ! GRIN2A\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9063\" xsd:anyURI\n\n","exit":0,"description":"Finds GRIN-related ontology mentions","truncated":false},"title":"Finds GRIN-related ontology mentions","time":{"start":1778975565434,"end":1778975565439}},"id":"prt_e3334e207001wZj3Mo2CIjs8xK","sessionID":"ses_1cccbf924ffe5V1YAyCWKz7RJg","messageID":"msg_e3334dad4001nL493m0vrk5zEN"}}
