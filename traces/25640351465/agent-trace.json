ef: \"An autosomal recessive tumor predisposition syndrome characterized by the development of multiple colonic adenomas in adulthood, often with progression to colorectal cancer. Proliferative lesions in other tissues may also occur.\" [https://orcid.org/0000-0002-6601-2165, OMIM:617100]\nsubset: doid {source=\"DOID:0080412\"}\nsubset: gard_rare {source=\"GARD:0017868\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:617100\"}\nsubset: ordo_disorder {source=\"Orphanet:480536\"}\nsubset: orphanet {source=\"Orphanet:480536\"}\nsubset: orphanet_rare {source=\"Orphanet:480536\"}\nsubset: rare\nsynonym: \"familial adenomatous polyposis 4\" EXACT [DOID:0080412, OMIM:617100]\nsynonym: \"familial adenomatous polyposis type 4\" EXACT [MONDO:RULE_1]\nsynonym: \"FAP4\" EXACT ABBREVIATION [OMIM:617100]\nsynonym: \"MSH3-related AFAP\" EXACT []\nsynonym: \"MSH3-related attenuated familial adenomatous polyposis\" EXACT [https://clinicalgenome.org/affiliation/40023/, MONDO:0018812] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"MSH3-related attenuated familial polyposis coli\" EXACT []\nsynonym: \"MSH3-related attenuated FAP\" EXACT []\nxref: DOID:0080412 {source=\"MONDO:equivalentTo\"}\nxref: GARD:0017868 {source=\"MONDO:GARD\"}\nxref: MEDGEN:934686 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:617100 {source=\"MONDO:equivalentTo\"}\nxref: Orphanet:480536 {source=\"MONDO:equivalentTo\", source=\"OMIM:617100\"}\nxref: UMLS:C4310719 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:934686\"}\nintersection_of: MONDO:0021057 ! classic or attenuated familial adenomatous polyposis\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/7326 ! MSH3\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/7326 {source=\"OMIM:617100\"} ! MSH3\nproperty_value: curated_content_resource \"https://www.malacards.org/card/familial_adenomatous_polyposis_4\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6909\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7924\" xsd:anyURI\n\n[Term]\nid: MONDO:0044304\nname: hyperphenylalaninemia due to DNAJC12 deficiency\ndef: \"Mild non-BH4-deficient hyperphenylalaninemia (HPANBH4) is an autosomal recessive disorder characterized by increased serum phenylalanine usually detected by newborn screening and associated with highly variable neurologic defects, including movement abnormalities and intellectual disability. Laboratory analysis shows dopamine and serotonin deficiencies in the cerebrospinal fluid, and normal BH4 metabolism. Evidence suggests that treatment with neurotransmitter precursors can lead to clinical improvement or even prevent the neurologic defects if started in infancy (summary by {1:Anikster et al., 2017}).\" [OMIM:617384]\nsubset: clingen {source=\"MONDO:CLINGEN\"}\nsubset: gard_rare {source=\"GARD:0017950\", source=\"MONDO:GARD\"}\nsubset: nord_rare {source=\"MONDO:NORD\"}\nsubset: omim {source=\"OMIM:617384\"}\nsubset: ordo_disorder {source=\"Orphanet:508523\"}\nsubset: orphanet {source=\"Orphanet:508523\"}\nsubset: orphanet_rare {source=\"Orphanet:508523\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"HPANBH4\" RELATED ABBREVIATION []\nsynonym: \"hyperphenylalaninemia due to DNAJC12 deficiency\" EXACT [Orphanet:508523] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"hyperphenylalaninemia, mild, non-BH4-deficient\" RELATED []\nxref: GARD:0017950 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1391882 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:617384 {source=\"MONDO:equivalentTo\", source=\"Orphanet:508523\"}\nxref: Orphanet:508523 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4479270 {source=\"MEDGEN:1391882\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0005066 {source=\"https://orcid.org/0000-0002-1780-5230\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! metabolic disease\nis_a: MONDO:0037871 {source=\"PMID:33340416\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! amino acid metabolism disease\nrelationship: curated_content_resource https://search.clinicalgenome.org/kb/conditions/MONDO:0044304 {source=\"MONDO:CLINGEN\"}\nrelationship: excluded_subClassOf MONDO:0009861 {source=\"https://github.com/Orphanet/ORDO/issues/15\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! phenylketonuria\nrelationship: has_characteristic HP:0000007 {source=\"MONDO:HPOA\", source=\"OMIM:617384\", source=\"Orphanet:508523\"} ! Autosomal recessive inheritance\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/28908 {source=\"OMIM:617384\", source=\"Orphanet:508523\"} ! DNAJC12\nproperty_value: curated_content_resource \"https://www.malacards.org/card/hyperphenylalaninemia_due_to_dnajc12_deficiency\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: curated_content_resource \"https://www.malacards.org/card/hyperphenylalaninemia_mild_non_bh4_deficient\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6750\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6752\" xsd:anyURI\n\n[Term]\nid: MONDO:0044316\nname: thrombocytopenia, anemia, and myelofibrosis\nsubset: clingen {source=\"MONDO:CLINGEN\"}\nsubset: omim {source=\"OMIM:617441\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsynonym: \"THAMY\" RELATED ABBREVIATION []\nsynonym: \"thrombocytopenia, anemia, and myelofibrosis\" EXACT [OMIM:617441] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nxref: MEDGEN:1378448 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:617441 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4479504 {source=\"MONDO:equivalentTo\", sourc