746 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4540299 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1625659\"}\nis_a: MONDO:0002254 {source=\"DOID:0080538\"} ! syndromic disease\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! hereditary disease\nrelationship: curated_content_resource https://search.clinicalgenome.org/kb/conditions/MONDO:0060592 {source=\"MONDO:CLINGEN\"}\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/12428 {source=\"OMIM:617746\"} ! TWIST1\nproperty_value: curated_content_resource \"https://www.malacards.org/card/sweeney_cox_syndrome\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0060622\nname: neurodevelopmental disorder with severe motor impairment and absent language\ndef: \"A complex neurodevelopmental disorder caused by variation in DHX30. Individuals with variants in DHX30 have been found to have variable presentations including intellectual disability, delayed or absent speech development, delayed motor development, hypotonia, feeding difficulties, and ataxic gait or the inability to walk. Other phenotypic features commonly reported include sleep disorders, autistic features, seizures, and joint hypermobility\" [https://orcid.org/0000-0002-0587-4693, https://orcid.org/0000-0002-6647-5493, PMID:29100085]\nsubset: gard_rare {source=\"GARD:0013608\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:617804\"}\nsubset: ordo_disorder {source=\"Orphanet:647788\"}\nsubset: orphanet {source=\"Orphanet:647788\"}\nsubset: orphanet_rare {source=\"Orphanet:647788\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"DHX30-related complex neurodevelopmental disorder\" EXACT [] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"NEDMIAL\" RELATED ABBREVIATION []\nsynonym: \"neurodevelopmental delay-intellectual disability-ataxia-feeding difficulty syndrome\" EXACT [Orphanet:647788]\nsynonym: \"neurod