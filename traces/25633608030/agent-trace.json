r container.\n#\n# The assumption is that you are working in the src/ontology folder;\n# we therefore map the whole repo (../..) to a docker volume.\n#\n# See README-editors.md for more details.\n\nMEMORY_GB=${MEMORY_GB:-8}\nIMAGE=${IMAGE:-odkfull:v1.6}\nMEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\nODK_DEBUG=${ODK_DEBUG:-no}\n\ndocker pull obolibrary/$IMAGE\n\necho \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"","truncated":false,"loaded":[]},"title":"src/ontology/run.sh","time":{"start":1778433702357,"end":1778433702363}},"metadata":{"openai":{"itemId":"fc_0d98f5ca17e4423b016a00bea61a0481a19212b8800b9db49b"}},"id":"prt_e12e8b8f0001fV2EuONxYV4nSe","sessionID":"ses_1ed182a2cffeLVQq8QCigvUO9p","messageID":"msg_e12e8afff001CyapuZcucpKHKz"}}
