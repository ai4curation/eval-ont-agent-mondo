dy syndrome\nis_a: MONDO:0859393 {source=\"OMIM:620184\"} ! Atelis syndrome\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/17814 {source=\"OMIM:620184\"} ! SLF2\nproperty_value: curated_content_resource \"https://www.malacards.org/card/atelis_syndrome_1\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0859576\nname: Atelis syndrome 2\nsubset: gard_rare {source=\"GARD:0026749\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:620185\"}\nsubset: rare\nxref: GARD:0026749 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1824055 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620185 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5774282 {source=\"MEDGEN:1824055\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0000141 {source=\"OMIM:620185\"} ! mosaic variegated aneuploidy syndrome\nis_a: MONDO:0859393 {source=\"OMIM:620185\"} ! Atelis syndrome\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/20465 {source=\"OMIM:620185\"} ! SMC5\nproperty_value: curated_content_resource \"https://www.malacards.org/card/atelis_syndrome_2\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0859763\nname: mosaic neurofibromatosis type 1\nsubset: gard_rare {source=\"GARD:0026764\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:634461\"}\nsubset: orphanet {source=\"Orphanet:634461\"}\nsubset: orphanet_rare {source=\"Orphanet:634461\"}\nsubset: rare\nxref: GARD:0026764 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1843428 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:634461 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5782097 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1843428\"}\nis_a: MONDO:0859008 {source=\"Orphanet:634461\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! mosaic neurofibromatosis/schwannomatosis\nproperty_value: curated_content_resource \"https://www.malacards.org/card/mosaic_neurofibromatosis_type_1\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0859764\nname: mosaic NF2-related schwannomatosis\nsubset: gard_rare {source=\"GARD:0026765\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:634475\"}\nsubset: orphanet {source=\"Orphanet:634475\"}\nsubset: orphanet_rare {source=\"Orphanet:634475\"}\nsubset: rare\nxref: GARD:0026765 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1843426 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:634475 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5816778 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1843426\"}\nis_a: MONDO:0859008 {source=\"Orphanet:634475\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! mosaic neurofibromatosis/schwannomatosis\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/7773 {source=\"Orphanet:634475\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! NF2\nproperty_value: curated_content_resource \"https://www.malacards.org/card/mosaic_nf2_related_schwannomatosis\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0859765\nname: mosaic schwannomatosis\nsubset: gard_rare {source=\"GARD:0026766\", source=\"MONDO:GARD\"}\nsubset: ordo_disorder {source=\"Orphanet:634492\"}\nsubset: orphanet {source=\"Orphanet:634492\"}\nsubset: orphanet_rare {source=\"Orphanet:634492\"}\nsubset: rare\nxref: GARD:0026766 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1843393 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: Orphanet:634492 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5816779 {source=\"MEDGEN:1843393\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0859008 {source=\"Orphanet:634492\", source=\"https://orcid.org/0000-0001-5208-3432\"} ! mosaic neurofibromatosis/schwannomatosis\nproperty_value: curated_content_resource \"https://www.malacards.org/card/mosaic_schwannomatosis\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:1012852\nname: 60,XX/90,XXY disorder of sexual development, cattle\ndef: \"A congenital disorder characterized by abnormalities in the development of the sexual characteristics that occurs in cattle due to diploid/triploid (60,XX/90,XXY) mosaicism.\" [PMID:33498673]\nsynonym: \"60,XX/90,XXY sex chromosome difference of sexual development in Bos taurus\" EXACT [OMIA:002310-9913]\nxref: OMIA:002310-9913 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0700105 {source=\"OMIA:002310-9913\", source=\"https://orcid.org/0000-0002-5002-8648\"} ! difference of sexual differentiation, non-human animal\nis_a: MONDO:1011321 {source=\"OMIA:002310-9913\", source=\"https://orcid.org/0000-0002-5002-8648\"} ! hereditary disease, non-human animal\nrelationship: in_taxon NCBITaxon:9913 {source=\"OMIA:002310-9913\"} ! Bos taurus\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7271\" xsd:anyURI\n\n[Term]\nid: MONDO:1030005\nname: mosaic SMO syndrome\ndef: \"A somatic mosaic condition caused by a postzygotic mutation (c.1234 C>T p.Leu412Phe) in the SMO gene. Two overlapping clinical syndromes associated with this variant in SMO have been reported; Curry-Jones Syndrome (MIM:601707) and Happle-Tinschert Syndrome. The syndrome is characterized by cutaneous and skeletal manifestations such as linear hypo‐ or hyperpigmented lesions, basaloid follicular hamartomas, palmoplantar pitting, atrophoderma, hypertrichosis, polydactyly or syndactyly, rib anomalies (rudimentary ribs), and limb‐length anomalies. Craniofacial and dental abnormalities such as dysmorphic facies, macrocephaly, craniosynostosis, jaw tumors (ameloblastoma) have also been reported. Additional abnormalities impacting the gastrointestinal, cerebral, ophthalmic, and gonadal organs should also be considered. Some of these features include anal anomaly, colonic adenocarcinoma, severe constipation, myelofibrosis and smooth muscle hamartomas, malrotation, medulloblastoma, cerebral malformations, developmental delay, cataract, microphthalmia, coloboma, glaucoma, and cryptorchidism.\" [https://clinicalgenome.org/affiliation/40059/, PMID:27236920, PMID:30497210, PMID:31120550, PMID:32413283, PMID:7606318]\nsubset: gard_rare {source=\"GARD:0027231\", source=\"MONDO:GARD\"}\nsubset: rare\nxref: GARD:0027231 {source=\"MONDO:GARD\"}\nis_a: MONDO:0015160 {source=\"PMID:31120550\"} ! multiple congenital anomalies/dysmorphic syndrome-variable intellectual disability syndrome\nrelationship: RO:0004004 http://identifiers.org/hgnc/11119 {source=\"PMID:31120550\", source=\"https://clinicalgenome.org/affiliation/40059/\"} ! has material basis in somatic mutation in SMO\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7768\" xsd:anyURI\n\n[Term]\nid: MONDO:1030006\nname: Happle-Tinschert syndrome\ndef: \"Happle-Tinschert syndrome (HTS) is a rare, sporadic, multisystem disorder characterized by hypo- and hyperpigmented skin patches following Blaschko's lines, plus acral skeletal and other abnormalities and is characterized by basaloid follicular hamartomas. HTS is caused by a postzygotic mutation in the SMO gene (c.1234C>T, p.Leu412Phe).\" [PMID:31120550]\nsubset: gard_rare {source=\"GARD:0027232\", source=\"MONDO:GARD\"}\nsubset: rare\nsynonym: \"HTS\" EXACT ABBREVIATION [PMID:31120550]\nxref: GARD:0027232 {source=\"MONDO:GARD\"}\nis_a: MONDO:1030005 {source=\"PMID:31120550\"} ! mosaic SMO syndrome\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7768\" xsd:anyURI\n\n","exit_code":0,"status":"completed"}}
