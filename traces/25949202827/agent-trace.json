o/issues/4948\" xsd:anyURI\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/6751\" xsd:anyURI\n\n[Term]\nid: MONDO:0060583\nname: platelet abnormalities with eosinophilia and immune-mediated inflammatory disease\nsubset: clingen {source=\"MONDO:CLINGEN\"}\nsubset: doid {source=\"DOID:0112004\"}\nsubset: omim {source=\"OMIM:617718\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsynonym: \"immunodeficiency 71 with inflammatory disease and congenital thrombocytopenia\" EXACT [DOID:0112004, OMIM:617718]\nsynonym: \"platelet abnormalities with eosinophilia and immune-mediated inflammatory disease\" EXACT [DOID:0112004, OMIM:617718] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nsynonym: \"PLTEID\" RELATED ABBREVIATION []\nxref: DOID:0112004 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:1618052 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:617718 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C4540232 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1618052\"}\nis_a: MONDO:0003847 {source=\"https://orcid.org/0000-0001-5208-3432\"} ! hereditary disease\nrelationship: curated_content_resource https://search.clinicalgenome.org/kb/conditions/MONDO:0060583 {source=\"MONDO:CLINGEN\"}\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/704 {source=\"OMIM:617718\"} ! ARPC1B\nproperty_value: curated_content_resource \"https://www.malacards.org/card/immunodeficiency_71_with_inflammatory_disease_and_congenital_thrombocytopenia\" xsd:anyURI {source=\"MONDO:MalaCards\"}\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/4521\" xsd:anyURI\n\n[Term]\nid: MONDO:0060592\nname: Sweeney-Cox syndrome\nsubset: clingen {source=\"MONDO:CLINGEN\"}\nsubset: doid {source=\"DOID:0080538\"}\nsubset: omim {source=\"OMIM:617746\"}\nsynonym: \"SWCOS\" RELATED ABBREVIATION []\nsynonym: \"Sweeney-Cox syndrome\" EXACT [DOID:0080538, OMIM:617746]