\"https://github.com/monarch-initiative/mondo/issues/9703\" xsd:anyURI\n\n[Term]\nid: MONDO:0010427\nname: syndromic X-linked intellectual disability Raymond type\ndef: \"A syndromic X-linked intellectual disability characterized by intellectual disability and marfanoid habitus that has material basis in mutation in the ZDHHC9 gene on chromosome Xq26.1.\" [DOID:0060824, PMID:17436253, PMID:19377476]\nsubset: clingen {source=\"MONDO:CLINGEN\"}\nsubset: doid {source=\"DOID:0060824\"}\nsubset: doid_rare {source=\"DOID:0060824\"}\nsubset: gard_rare {source=\"GARD:0015264\", source=\"MONDO:GARD\"}\nsubset: nord_rare {source=\"MONDO:NORD\"}\nsubset: omim {source=\"OMIM:300799\"}\nsubset: otar {source=\"MONDO:OTAR\"}\nsubset: rare\nsynonym: \"intellectual disability, X-linked syndromic, Raymond type\" EXACT []\nsynonym: \"intellectual disability, X-linked, syndromic, Raymond type\" RELATED []\nsynonym: \"mental retardation, X-linked, syndromic, Raymond type\" RELATED DEPRECATED []\nsynonym: \"MRXSR\" EXACT ABBREVIATION [DOID:0060824, OMIM:300799]\nsynonym: \"syndromic X-linked intellectual disability Raymond type\" EXACT [DOID:0060824] {OMO:0002001=\"https://w3id.org/information-resource-registry/clingen\"}\nxref: DOID:0060824 {source=\"MONDO:equivalentTo\"}\nxref: GARD:0015264 {source=\"MONDO:GARD\"}\nxref: ICD10CM:Q87.8 {source=\"DOID:0060824\"}\nxref: MEDGEN:477037 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:300799 {source=\"MONDO:equivalentTo\", source=\"DOID:0060824\"}\nxref: UMLS:C3275406 {source=\"MEDGEN:477037\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0020119 {source=\"DC-OMIM:300799\", source=\"DOID:0060824\", source=\"OMIM:300799\", source=\"https://clinicalgenome.org/affiliation/40060/\"} ! X-linked syndromic intellectual disability\nrelationship: curated_content_resource https://search.clinicalgenome.org/kb/conditions/MONDO:0010427 {source=\"MONDO:CLINGEN\"}\nrelationship: has_material_basis_in_germline_mut