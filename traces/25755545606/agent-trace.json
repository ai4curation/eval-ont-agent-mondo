{"type":"tool_use","timestamp":1778614888114,"sessionID":"ses_1e24f3994ffew1W30VYmQnV9lA","part":{"type":"tool","tool":"read","callID":"functions.read:9","state":{"status":"completed","input":{"filePath":"/home/runner/work/eval-ont-agent-mondo/eval-ont-agent-mondo/src/patterns/dosdp-patterns/disease_series_by_gene.yaml"},"output":"<path>/home/runner/work/eval-ont-agent-mondo/eval-ont-agent-mondo/src/patterns/dosdp-patterns/disease_series_by_gene.yaml</path>\n<type>file</type>\n<content>\n1: pattern_name: disease_series_by_gene\n2: \n3: pattern_iri: http://purl.obolibrary.org/obo/mondo/patterns/disease_series_by_gene.yaml\n4: \n5: description: 'This pattern is for diseases that are caused by a single variation or mutation in\n6:   a single gene, that have gene-based names, such as new disease terms that are requested\n7:   by ClinGen, like MED12-related intellectual disability syndrome. See more details about [disease naming in Mondo here](https://mondo.monarchinitiative.org/pages/disease-naming/).  Examples: [MED12-related\n8:   intellectual disability syndrome](http://purl.obolibrary.org/obo/MONDO_0100000),\n9:   [TTN-related myopathy](http://purl.obolibrary.org/obo/MONDO_0100175), [MYPN-related\n10:   myopathy](http://purl.obolibrary.org/obo/MONDO_0015023)'\n11: \n12: contributors:\n13: - https://orcid.org/0000-0002-6601-2165\n14: - https://orcid.org/0000-0001-5208-3432\n15: \n16: classes:\n17:   disease: MONDO:0700096\n18:   gene: SO:0000704\n19: \n20: relations:\n21:   has material basis in germline mutation in: RO:0004003\n22: \n23: annotationProperties:\n24:   exact_synonym: oio:hasExactSynonym\n25:   related_synonym: oio:hasRelatedSynonym\n26: \n27: vars:\n28:   disease: '''disease'''\n29:   gene: '''gene'''\n30: \n31: name:\n32:   text: '%s caused by variation in %s'\n33:   vars:\n34:   - disease\n35:   - gene\n36: \n37: annotations:\n38: - annotationProperty: exact_synonym\n39:   text: '%s %s'\n40:   vars:\n41:   - gene\n42:   - disease\n43: - annotationProperty: exact_synonym\n44:   text: '%s related %s'\n45:   vars:\n46:   - gene\n47:   - disease\n48: - annotationProperty: exact_synonym\n49:   text: '%s caused by mutation in %s'\n50:   vars:\n51:   - disease\n52:   - gene\n53: \n54: def:\n55:   text: Any %s in which the cause of the disease is a variation in the %s gene.\n56:   vars:\n57:   - disease\n58:   - gene\n59: \n60: equivalentTo:\n61:   text: '%s and ''has material basis in germline mutation in'' some %s'\n62:   vars:\n63:   - disease\n64:   - gene\n\n(End of file - total 64 lines)\n</content>","metadata":{"preview":"pattern_name: disease_series_by_gene\n\npattern_iri: http://purl.obolibrary.org/obo/mondo/patterns/disease_series_by_gene.yaml\n\ndescription: 'This pattern is for diseases that are caused by a single variation or mutation in\n  a single gene, that have gene-based names, such as new disease terms that are requested\n  by ClinGen, like MED12-related intellectual disability syndrome. See more details about [disease naming in Mondo here](https://mondo.monarchinitiative.org/pages/disease-naming/).  Examples: [MED12-related\n  intellectual disability syndrome](http://purl.obolibrary.org/obo/MONDO_0100000),\n  [TTN-related myopathy](http://purl.obolibrary.org/obo/MONDO_0100175), [MYPN-related\n  myopathy](http://purl.obolibrary.org/obo/MONDO_0015023)'\n\ncontributors:\n- https://orcid.org/0000-0002-6601-2165\n- https://orcid.org/0000-0001-5208-3432\n\nclasses:\n  disease: MONDO:0700096\n  gene: SO:0000704\n\nrelations:","truncated":false,"loaded":[]},"title":"src/patterns/dosdp-patterns/disease_series_by_gene.yaml","time":{"start":1778614888107,"end":1778614888113}},"id":"prt_e1db55f7b001pQ5ct9YAPmGJkn","sessionID":"ses_1e24f3994ffew1W30VYmQnV9lA","messageID":"msg_e1db53387001DK5X0ixJbZ1CD9"}}
