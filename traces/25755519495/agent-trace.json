cker container.\n#\n# The assumption is that you are working in the src/ontology folder;\n# we therefore map the whole repo (../..) to a docker volume.\n#\n# See README-editors.md for more details.\n\nMEMORY_GB=${MEMORY_GB:-8}\nIMAGE=${IMAGE:-odkfull:v1.6}\nMEMORY_JAVA=\"-Xmx${MEMORY_GB}G\"\nODK_DEBUG=${ODK_DEBUG:-no}\n\ndocker pull obolibrary/$IMAGE\n\necho \"Running ODK with ${MEMORY_GB} GB of memory, using ${IMAGE}.\"","truncated":false,"loaded":[]},"title":"src/ontology/run.sh","time":{"start":1778614489016,"end":1778614489023}},"id":"prt_e1daf4905001Wm3DQcxxZfsGjg","sessionID":"ses_1e25759a7ffenVC9nmfitzkS1E","messageID":"msg_e1daf1086001vgsPu0lNb3H8qj"}}
