9 {source=\"MONDO:equivalentTo\"}\nxref: OMIM:621512 {source=\"MONDO:equivalentTo\"}\nis_a: MONDO:0016817 {source=\"OMIM:621512\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! Meier-Gorlin syndrome\nintersection_of: MONDO:0016817 ! Meier-Gorlin syndrome\nintersection_of: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/25851 ! GINS3\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/25851 {source=\"OMIM:621512\", source=\"PMID:38773883\"} ! GINS3\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/9933\" xsd:anyURI\n\n","exit":0,"description":"Reads updated term from ontology","truncated":false},"title":"Reads updated term from ontology","time":{"start":1778979484852,"end":1778979484857}},"id":"prt_e3370b476001odyrI0A51Mjudj","sessionID":"ses_1cc90dad7ffedWLI04NkShwCIr","messageID":"msg_e33709f2e001MgJzapXAuiOFKy"}}
