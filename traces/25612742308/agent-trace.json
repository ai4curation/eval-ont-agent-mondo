07 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: SCTID:440059007 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C2585653 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:749907\"}\nis_a: MONDO:0004981 {source=\"PMID:38033089\"} ! atrial fibrillation\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7887\" xsd:anyURI\n\n[Term]\nid: MONDO:1030010\nname: precerebral artery stenosis\ndef: \"A cerebrovascular disorder characterized by an abnormal narrowing of a precerebral artery.\" [https://orcid.org/0009-0009-6791-365X, SCTID:1055001]\nsynonym: \"narrowing of precerebral artery\" EXACT [SCTID:1055001]\nxref: ICD10CM:I65 {source=\"MONDO:relatedTo\"}\nxref: MEDGEN:539068 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: SCTID:1055001 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C0265089 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:539068\"}\nis_a: MONDO:0011057 {source=\"SCTID:1055001\"} ! cerebrovascular disorder\nproperty_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-3458-4839\nproperty_value: IAO:0000233 \"https://github.com/monarch-initiative/mondo/issues/7885\" xsd:anyURI\n\n[Term]\nid: MONDO:1030011\nname: paroxysmal atrial fibrillation\ndef: \"An atrial fibrillation disorder characterized by intermittent atrial fibrillation that lasts less than seven days from onset.\" [https://orcid.org/0009-0009-6791-365X, PMID:38033089]\nsubset: ncit {source=\"NCIT:C80391\"}\nsynonym: \"paroxymsal AFib\" EXACT [NCIT:C80391]\nsynonym: \"paroxysmal AF\" EXACT [NCIT:C80391]\nxref: ICD10CM:I48.0 {source=\"MONDO:equivalentTo\"}\nxref: icd11.foundation:542703670 {source=\"MONDO:equivalentTo\"}\nxref: MEDGEN:115990 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: NCIT:C80391 {source=\"MONDO:equivalentTo\"}\nxref: SCTID:282825002 {source=\"MONDO:equival