tal_disorder_autosomal_recessive_82\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0968945\nname: neurodevelopmental disorder with language impairment, autism, and attention deficit-hyperactivity disorder\nsubset: gard_rare {source=\"GARD:0028082\", source=\"MONDO:GARD\"}\nsubset: nord_rare {source=\"MONDO:NORD\"}\nsubset: omim {source=\"OMIM:620782\"}\nsubset: rare\nxref: GARD:0028082 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1854977 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620782 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935603 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\", source=\"MEDGEN:1854977\"}\nis_a: MONDO:0100500 {source=\"OMIM:620782\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! Mendelian neurodevelopmental disorder\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/6743 {source=\"OMIM:620782\"} ! CAPRIN1\nproperty_value: curated_content_resource \"https://www.malacards.org/card/neurodevelopmental_disorder_with_language_impairment_autism_and_attention_deficit_hyperactivity_disorder\" xsd:anyURI {source=\"MONDO:MalaCards\"}\n\n[Term]\nid: MONDO:0968946\nname: developmental and epileptic encephalopathy 115\nsubset: gard_rare {source=\"GARD:0027033\", source=\"MONDO:GARD\"}\nsubset: omim {source=\"OMIM:620783\"}\nsubset: rare\nxref: GARD:0027033 {source=\"MONDO:GARD\"}\nxref: MEDGEN:1858870 {source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nxref: OMIM:620783 {source=\"MONDO:equivalentTo\"}\nxref: UMLS:C5935604 {source=\"MEDGEN:1858870\", source=\"MONDO:equivalentTo\", source=\"MONDO:MEDGEN\"}\nis_a: MONDO:0100062 {source=\"OMIM:620783\", source=\"https://orcid.org/0000-0002-4142-7153\"} ! genetic developmental and epileptic encephalopathy\nrelationship: has_material_basis_in_germline_mutation_in http://identifiers.org/hgnc/17028 {source=\"OMIM:620783\"} ! SNF8\nproperty_value: curated_content_resource \"https://www.malacards.org/card/developmental_and_epi